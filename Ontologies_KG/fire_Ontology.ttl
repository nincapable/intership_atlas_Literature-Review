@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .


#################################################################
# EUROCLASSES (NOUVEAU - classes contrôlées)
#################################################################



#################################################################
# Composants REI

fe:euroclass_fire_resistance a crm:E55_Type, owl:Class .

fe:R a fe:euroclass_fire_resistance ; crm:P2_has_type "R" .
fe:E a fe:euroclass_fire_resistance ; crm:P2_has_type "E" .
fe:I a fe:euroclass_fire_resistance ; crm:P2_has_type "I" .
fe:W a fe:euroclass_fire_resistance ; crm:P2_has_type "W" .

# Bâtiment → ensemble R/E/I + durée
fe:hasFireResistanceRating a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:Building ;
    rdfs:range fe:FireResistanceRating ;

fe:resistanceComponents a owl:ObjectProperty ;
    rdfs:domain fe:FireResistanceRating ;
    rdfs:range fe:euroclass_fire_resistance ;

fe:resistanceDuration a owl:DatatypeProperty ;
    rdfs:domain fe:FireResistanceRating ;
    rdfs:range xsd:integer ;

#################################################################
# Classes principales
#################################################################

fe:Building a owl:Class ; 
    rdfs:subClassOf crm:E25_Man_Made_Feature .

fe:Axis a owl:Class ; 
    rdfs:subClassOf crm:E25_Man_Made_Feature .

fe:Artefact a owl:Class ; 
    rdfs:subClassOf crm:E22_Man_Made_Object .

fe:MaterialInstance a owl:Class ; 
    rdfs:subClassOf crm:E57_Material .

#################################################################
# Propriétés d’objet
#################################################################

#***************************************************************    
# Building

# 1. Date de Construction -> E12 Production
fe:hasConstructionEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E12_Production ;
    rdfs:subPropertyOf crm:P108i_was_produced_by .

# 2. Date de Destruction -> E6 Destruction
fe:hasDestructionEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E6_Destruction ;
    rdfs:subPropertyOf crm:P13i_was_destroyed_by .

# 3. Date de Renovation -> E11 Modification
fe:hasRenovationEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E11_Modification ;
    rdfs:subPropertyOf crm:P31i_was_modified_by .

# 4. Style d'architecture → E55 Type
fe:hasArchitectureStyle a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E55_Type ; 
    rdfs:subPropertyOf crm:P2_has_type .

# 5. Matériaux principaux → E57 Material (+ proportions E54 Dimension)
fe:hasIndividualMaterial a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range fe:MaterialInstance ;
    rdfs:subPropertyOf crm:P45_consists_of ;

# 6. Sous-bassements → E26 Physical Feature OU E55 Type
fe:hasSubstructure a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E25_Man_Made_Feature ; 
    rdfs:subPropertyOf crm:P46i_forms_part_of .

# 7. Capacité personnes → E54 Dimension
fe:hasPersonCapacity a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E54_Dimension ; 
    rdfs:subPropertyOf crm:P43_has_dimension .

# 8. Usage courant → E55 Type
fe:hasCurrentUse a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E7_Activity ;
    rdfs:subPropertyOf crm:P9_consists_of ;

# 9. Axes circulation → E25 Man-Made Feature (axes)
fe:hasCirculationAxis a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range fe:Axis ; 
    rdfs:subPropertyOf crm:P89_falls_within .

# 10. Zone → E53 Place
fe:isInZone a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E53_Place ; 
    rdfs:subPropertyOf crm:P89_falls_within .

# 11. Exposition risques → E3 Condition State
fe:hasRiskExposure a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E3_Condition_State ;
    rdfs:subPropertyOf crm:P44_has_condition .

# 12. Artefacts associés → E22 Man-Made Object
fe:containsArtefact a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range fe:Artefact ; 
    rdfs:subPropertyOf crm:P53i_is_former_or_current_location_of .

# 13. Dimensions géographiques → E94 Spatial Coordinates
fe:hasGeoDimensions a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E94_Spatial_Coordinates ; 
    rdfs:subPropertyOf crm:P168_place_is_defined_by .

# 14. Localisation → E53 Place
fe:hasLocation a owl:ObjectProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E53_Place ; 
    rdfs:subPropertyOf crm:P53_has_former_or_current_location .

#***************************************************************        
# Axis

fe:AxisType a owl:Class .

# Instances énumérées (objets simples)
fe:couloir a fe:AxisType ; rdfs:label "couloir"@fr .
fe:escalier a fe:AxisType ; rdfs:label "escalier"@fr .
fe:porte a fe:AxisType ; rdfs:label "porte"@fr .
fe:rampe a fe:AxisType ; rdfs:label "rampe"@fr .
fe:ascenseur a fe:AxisType ; rdfs:label "ascenseur"@fr .
fe:fenetre a fe:AxisType ; rdfs:label "fenêtre"@fr .
fe:voie_ouverte a fe:AxisType ; rdfs:label "voie ouverte"@fr .

#----------------------------------------------------------------
# 1. FACTEUR BLOQUANT (obstacles, encombrements)
fe:hasBlockingFactor a owl:ObjectProperty ;
    rdfs:domain fe:Axis ; rdfs:range crm:E3_Condition_State ;
    rdfs:subPropertyOf crm:P44_has_condition .

fe:blockingLevel a owl:DatatypeProperty ;
    rdfs:domain crm:E3_Condition_State ; rdfs:range xsd:decimal ;
    rdfs:comment "0.0=libre, 1.0=bloqué total"@fr .

#----------------------------------------------------------------
# 2. CAPACITÉS
# Capacité transport (véhicules, brancards...)
fe:transportCapacity a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:decimal ;
    rdfs:comment "pers/min (pompiers, brancards)"@fr .

# Capacité piétons (évacuation principale)
fe:pedestrianCapacity a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:decimal ;
    rdfs:comment "pers/min (évacuation)"@fr .

#----------------------------------------------------------------
# 3. DIMENSIONS
fe:width a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:decimal ;
    rdfs:comment "Largeur utile (m)"@fr .

fe:length a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:decimal ;
    rdfs:comment "Longueur (m)"@fr .

fe:slope a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:decimal ;
    rdfs:comment "Pente % (escaliers, rampes)"@fr .

#----------------------------------------------------------------
# 4. PRATICABILITÉ (état opérationnel)
fe:practicability a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:string ;
    rdfs:comment "ouvert|partiel|ferme|obstacle"@fr .

#----------------------------------------------------------------
# 5. ACCESSIBILITÉ (PMR)
fe:accessibility a owl:DatatypeProperty ;
    rdfs:domain fe:Axis ; rdfs:range xsd:string ;
    rdfs:comment "PMR|non_PMR|partiel"@fr .

#----------------------------------------------------------------
# 6. LOCALISATION (dans bâtiment/zone)
fe:isLocatedInBuilding a owl:ObjectProperty ;
    rdfs:domain fe:Axis ; rdfs:range fe:Building ;
    rdfs:subPropertyOf crm:P53i_is_former_or_current_location_of .

fe:isConnectedTo a owl:ObjectProperty ;
    rdfs:domain fe:Axis ; rdfs:range fe:Axis ;
    rdfs:comment "Connexion graphe évacuation"@fr .

#***************************************************************    
# Artefact

#***************************************************************    
# MaterialInstance

# UNIQUEMENT les propriétés ADDITIONNELLES (feu/simulateur)
fe:proportion a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain fe:MaterialInstance ; rdfs:range xsd:decimal ;
    rdfs:comment "Proportion en % (0.0-100.0)"@fr .

#----------------------------------------------------------------
# Reaction to Fire
e:EuroclassReactionValues a owl:Class ;
    owl:oneOf (fe:A1 fe:A2 fe:B fe:C fe:D fe:E fe:F) .

fe:reactionToFireClass a owl:ObjectProperty ;
    rdfs:domain fe:MaterialInstance ;
    rdfs:range fe:EuroclassReactionValues .

#----------------------------------------------------------------
# Smoke Production
fe:EuroclassSmokeValues a owl:Class ;
    owl:oneOf (fe:s1 fe:s2 fe:s3) .

fe:smokeProductionClass a owl:ObjectProperty ;
    rdfs:domain fe:MaterialInstance ;
    rdfs:range fe:EuroclassSmokeValues .

#----------------------------------------------------------------
# Flame Spread
fe:EuroclassFlameValues a owl:Class ;
    owl:oneOf (fe:d0 fe:d1 fe:d2) .

fe:flameSpreadClass a owl:ObjectProperty ;
    rdfs:domain fe:MaterialInstance ;
    rdfs:range fe:EuroclassFlameValues .

#################################################################
# Propriétés des attributs
#################################################################
#####
# Building


#################################################################
# Requetes SPARQL Standards
#################################################################

# Template : "Récupérer dates bâtiment"
fe:GetBuildingDates a spl:QueryTemplate ;
    rdfs:label "Dates d'un bâtiment"@fr ;
    rdfs:comment "Récupère toutes les dates d'un bâtiment donné"@fr ;
    sp:text """
    PREFIX fe: <http://example.org/feu#>
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    
    SELECT ?constrStart ?constrEnd ?destruction ?renovationStart ?renovationEnd WHERE {
      fe:{BUILDING} a fe:Building ;
           fe:hasConstructionEvent/crm:P4_has_time-span/ 
           [crm:P82a_begin_of_the_begin ?constrStart ;
            crm:P82b_end_of_the_end ?constrEnd] ;
           fe:hasDestructionEvent/crm:P4_has_time-span/
           [crm:P82a_begin_of_the_begin ?destruction] ;
           fe:hasRenovationEvent/crm:P4_has_time-span/
           [crm:P82a_begin_of_the_begin ?renovationStart ;
            crm:P82b_end_of_the_end ?renovationEnd] .
    }
    """ .