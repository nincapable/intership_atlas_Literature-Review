@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix fe:  <http://example.org/fire_and_evacuation#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SHACL SHAPES pour ton ontologie
#################################################################

## 1. SHAPE Building (classe principale)
fe:BuildingShape a sh:NodeShape ;
    sh:targetClass fe:Building ;
    sh:property [
        sh:path fe:hasConstructionEvent ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node fe:ConstructionEventShape
    ] ;
    sh:property [
        sh:path fe:hasIndividualMaterial ;
        sh:minCount 1 ;
        sh:maxCount 10 ;
        sh:node fe:MaterialInstanceShape
    ] ;
    # CONTRAINTES SPARQL : Somme proportions ≤ 100%
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes """
            PREFIX fe: <http://example.org/fire_and_evacuation#>
        """ ;
        sh:sparql """
        SELECT $this ?total WHERE {
            $this fe:hasIndividualMaterial [fe:proportion ?p] .
            BIND(SUM(xsd:decimal(?p)) AS ?total)
        } GROUP BY $this
        HAVING(?total > 100.0)
        """ ;
        sh:message "ERREUR: Somme proportions matériaux > 100% pour $this"
    ] .

## 2. SHAPE Événement Construction
fe:ConstructionEventShape a sh:NodeShape ;
    sh:targetClass crm:E12_Production ;
    sh:property [
        sh:path crm:P4_has_time-span ;
        sh:minCount 1 ;
        sh:node fe:TimeSpanShape
    ] .

## 3. SHAPE TimeSpan (dates)
fe:TimeSpanShape a sh:NodeShape ;
    sh:targetClass crm:E52_Time-Span ;
    sh:property [
        sh:path crm:P82a_begin_of_the_begin ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path crm:P82b_end_of_the_end ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0  # Fin optionnelle
    ] .

## 4. SHAPE MaterialInstance (CRITIQUE)
fe:MaterialInstanceShape a sh:NodeShape ;
    sh:targetClass fe:MaterialInstance ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Type de matériau obligatoire (pierre_calcaire, brique_pleine...)"
    ] ;
    sh:property [
        sh:path fe:proportion ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 100.0 ;
        sh:minCount 1 ;
        sh:message "Proportion entre 0.0 et 100.0 obligatoire"
    ] ;
    sh:property [
        sh:path fe:fireResistanceClass ;
        sh:datatype xsd:string ;
        sh:message "Classement feu obligatoire (EI30, A1...)"
    ] ;
    sh:property [
        sh:path fe:firePropagationRate ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0
    ] ;
    sh:property [
        sh:path fe:smokeProduction ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0
    ] .

## 5. SHAPE Axis
fe:AxisShape a sh:NodeShape ;
    sh:targetClass fe:Axis ;
    sh:property [
        sh:path fe:hasWidth ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.5 ;
        sh:message "Largeur axe ≥ 0.5m"
    ] ;
    sh:property [
        sh:path fe:hasPedestrianCapacity ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Capacité piétons ≥ 0"
    ] .

## 6. SHAPE Artefact
fe:ArtefactShape a sh:NodeShape ;
    sh:targetClass fe:Artefact ;
    sh:property [
        sh:path fe:isLocatedInBuilding ;
        sh:nodeKind sh:IRI ;
        sh:class fe:Building ;
        sh:minCount 1 ;
        sh:message "Artefact doit être localisé dans un bâtiment"
    ] .

## 7. SHAPE Capacité personnes
fe:PersonCapacityShape a sh:NodeShape ;
    sh:targetClass crm:E54_Dimension ;
    sh:property [
        sh:path crm:P90_has_value ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Capacité ≥ 1 personne"
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:datatype xsd:string ;
        sh:equals "personnes"
    ] .

#################################################################
# VALIDATION GLOBALE
#################################################################

fe:GlobalValidation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type rdfs:label rdfs:comment owl:sameAs
    ) ;
    sh:property [
        sh:path fe:hasIndividualMaterial ;
        sh:qualifiedValueShape [
            sh:qualifiedMinCount 1 ;
            sh:qualifiedMaxCount 10 ;
            sh:message "Bâtiment doit avoir 1-10 matériaux"
        ]
    ] .
