###### Non accessible nativement sans perte d'information ######
fe:hasEmergencyEvacuationDocument a owl:ObjectProperty ;
    rdfs:label "a une procédure d'évacuation (document)"@fr ;
    rdfs:domain fe:Building ; 
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:comment "Lien vers le plan d'intervention ou la procédure globale du bâtiment."@fr .

###### Non accessible nativement sans perte d'information ######
fe:hasEmergencyInterventionDocument a owl:ObjectProperty ;
    rdfs:label "a une procédure d'intervention (document)"@fr ;
    rdfs:domain fe:Building ; 
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:comment "Lien vers le plan d'intervention ou la procédure globale du bâtiment."@fr .

#---------------------------------------------------------------------------------------------
# Propriétés d’objet MaterialInstance
fe:hasReactionToFire a owl:ObjectProperty ;
    rdfs:label "a pour réaction au feu"@fr ;
    rdfs:domain fe:MaterialInstance ;
    rdfs:range fe:ReactionToFire .