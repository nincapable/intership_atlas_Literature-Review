@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

fe:Building a owl:Class ; 
    rdfs:subClassOf crm:E25_Man_Made_Feature .

fe:MaterialInstance a owl:Class ; 
    rdfs:subClassOf crm:E57_Material .

fe:ArchitectureStyle a owl:Class ; rdfs:subClassOf crm:E55_Type .

fe:StyleAntique a owl:Class ; rdfs:subClassOf fe:ArchitectureStyle .
fe:StyleMedieval a owl:Class ; rdfs:subClassOf fe:ArchitectureStyle .
fe:StyleClassique a owl:Class ; rdfs:subClassOf fe:ArchitectureStyle .
fe:StyleModerne a owl:Class ; rdfs:subClassOf fe:ArchitectureStyle .
fe:StyleVernaculaire a owl:Class ; rdfs:subClassOf fe:ArchitectureStyle .

# Propriétés d’objet Building
###### Non accessible nativement sans perte d'information ######
fe:hasConstructionEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:Building ; rdfs:range crm:E12_Production ;
    rdfs:subPropertyOf crm:P108i_was_produced_by .

