# =================================================================
# 2. LES ESPÈCES PROTÉGÉES (Biodiversité)
# =================================================================

fe:Taxon a owl:Class ;
    rdfs:label "Taxon"@fr ;
    rdfs:comment "Classification taxonomique des espèces vivantes."@fr ;
    rdfs:subClassOf fe:E55_Type .

fe:Insect a owl:Class ; rdfs:subClassOf fe:Taxon .
fe:Fungus a owl:Class ; rdfs:subClassOf fe:Taxon .
fe:Fish a owl:Class ; rdfs:subClassOf fe:Taxon .
fe:Bird a owl:Class ; rdfs:subClassOf fe:Taxon .
fe:Mammal a owl:Class ; rdfs:subClassOf fe:Taxon.
fe:Plant a owl:Class ; rdfs:subClassOf fe:Taxon .

fe:hostsTaxon a owl:ObjectProperty ;
    rdfs:label "héberge le taxon"@fr ;
    rdfs:comment "Lien entre un espace naturel et une espèce présente."@fr ;
    rdfs:subPropertyOf crm:P2_has_type ; 
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:Taxon .

fe:ProtectedSpecies a owl:Class ;
    rdfs:label "Espèce Protégée"@fr ;
    rdfs:subClassOf crm:fe: . # On utilise E55 car c'est un concept taxonomique

fe:hostsSpecies a owl:ObjectProperty ;
    rdfs:label "héberge l'espèce"@fr ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:ProtectedSpecies .

# =================================================================
# 3. EXPOSITION AU RISQUE (Analyse Incendie/Naturel)
# =================================================================

fe:RiskExposure a owl:Class ;
    rdfs:label "Exposition au Risque"@fr ;
    rdfs:subClassOf crm:E55_Type .

fe:hasRiskLevel a owl:ObjectProperty ;
    rdfs:label "est exposé au risque"@fr ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:RiskExposure .

# Note : On pourra lier cela à une note textuelle CRM P3 pour les détails