@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/thesaurus_especes> a owl:Ontology ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ; # Optionnel : importe les définitions SKOS
    rdfs:label "Vocabulaire des Espèces"@fr .

# Schémas
fe:IUCScheme a skos:ConceptScheme ; rdfs:label "Référentiel des Statuts de Conservation UICN"@fr ; skos:hasTopConcept fe:IUCN_EX, fe:IUCN_EW, fe:IUCN_CR, fe:IUCN_EN, fe:IUCN_VU, fe:IUCN_NT, fe:IUCN_LC, fe:IUCN_DD, fe:IUCN_NE .
fe:FireTraitScheme a skos:ConceptScheme ; rdfs:label "Thésaurus des Traits face au Feu"@fr ; skos:hasTopConcept fe:FlammabilityScale, fe:FireAidingTrait, fe:FireResistingTrait, fe:EmberTypeRoot .
fe:PlantFireStrategyScheme a skos:ConceptScheme ; rdfs:label "Référentiel des Stratégies de Réponse"@fr ; skos:hasTopConcept fe:FireResponseStrategyRoot, fe:FireFunctionalRoleRoot .


fe:TaxonomyScheme a skos:ConceptScheme ; rdfs:label "Thésaurus de la Taxonomie Biologique"@fr ; skos:hasTopConcept fe:Animal, fe:Plant, fe:Fungus .

# --- NIVEAU RÈGNE (Reign) ---
fe:Animal a skos:Concept, fe:BioReign ; 
    skos:prefLabel "Animal"@fr ;
    fe:organicHRPBasis 25 ; #MJ/Kg - Valeur indicative pour les animaux en général, à affiner par classe ou ordre.
    skos:inScheme fe:TaxonomyScheme ; 
    skos:narrower fe:Invertebrate, fe:Vertebrate .

# --- NIVEAU DIVISION (Division / Phylum) ---
fe:Invertebrate a skos:Concept, fe:BioDivision ; 
    skos:prefLabel "Invertébré (Arthropodes, Mollusques, etc.)"@fr ; 
    skos:broader fe:Animal ; 
    skos:narrower fe:Hexapoda . 

# --- NIVEAU SOUS-DIVISION (SubDivision / SubPhylum) ---
fe:Vertebrate a skos:Concept, fe:BioSubDivision ; 
    skos:prefLabel "Vertébré (Vertebrata)"@fr ; 
    skos:broader fe:Animal ; 
    skos:narrower fe:Mammal, fe:Bird, fe:Fish, fe:Amphibian, fe:Reptile .

fe:Hexapoda a skos:Concept, fe:BioSubDivision ;
    skos:prefLabel "Hexapodes"@fr ;
    skos:broader fe:Invertebrate ;
    skos:narrower fe:Insect .

# --- NIVEAU CLASSE (Class) ---
fe:Mammal a skos:Concept, fe:BioClass ; 
    skos:prefLabel "Mammifère"@fr ; 
    skos:broader fe:Vertebrate .

fe:Bird a skos:Concept, fe:BioClass ; 
    skos:prefLabel "Oiseau"@fr ; 
    skos:broader fe:Vertebrate .

fe:Fish a skos:Concept, fe:BioClass ; 
    skos:prefLabel "Poisson (Osteichthyes/Chondrichthyes)"@fr ; 
    skos:broader fe:Vertebrate .

fe:Amphibian a skos:Concept, fe:BioClass ; 
    skos:prefLabel "Amphibien"@fr ; 
    skos:broader fe:Vertebrate .

fe:Reptile a skos:Concept, fe:BioClass ; 
    skos:prefLabel "Reptile (Sauropsida)"@fr ; 
    skos:broader fe:Vertebrate .

fe:Insect a skos:Concept, fe:BioClass ; 
    skos:prefLabel "Insecte"@fr ; 
    skos:broader fe:Hexapoda .

# --- NIVEAU RÈGNE (Reign) ---
fe:Plant a skos:Concept, fe:BioReign ; 
    skos:prefLabel "Plante / Flore"@fr ;
    fe:organicHRPBasis 20 ; #MJ/Kg - Valeur indicative pour les plantes en général, à affiner par classe ou ordre.
    skos:inScheme fe:TaxonomyScheme ; 
    skos:narrower fe:Bryophyte, fe:VascularPlant .

# --- NIVEAU DIVISION (Division) ---
fe:VascularPlant a skos:Concept, fe:BioDivision ; 
    skos:prefLabel "Plante Vasculaire (Trachéophyte)"@fr ; 
    skos:broader fe:Plant ; 
    skos:narrower fe:Spermatophyta .

fe:Bryophyte a skos:Concept, fe:BioDivision ; 
    skos:prefLabel "Bryophyte (Mousses)"@fr ; 
    skos:broader fe:Plant .

# --- NIVEAU SOUS-DIVISION (SubDivision) ---
fe:Spermatophyta a skos:Concept, fe:BioSubDivision ;
    skos:prefLabel "Spermatophytes (Plantes à graines)"@fr ;
    skos:broader fe:VascularPlant ;
    skos:narrower fe:Gymnospermae, fe:Angiospermae .

fe:Pteridophyte a skos:Concept, fe:BioSubDivision ; 
    skos:prefLabel "Ptéridophyte (Fougères)"@fr ; 
    skos:broader fe:VascularPlant .

# --- NIVEAU CLASSE (Class) ---
fe:Gymnospermae a skos:Concept, fe:BioClass ;
    skos:prefLabel "Gymnospermes"@fr ;
    skos:broader fe:Spermatophyta.

fe:Angiospermae a skos:Concept, fe:BioClass ;
    skos:prefLabel "Angiospermes"@fr ;
    skos:broader fe:Spermatophyta .

# --- NIVEAU RÈGNE (Reign) ---
fe:Fungus a skos:Concept, fe:BioReign ; 
    skos:prefLabel "Champignon (Fungi)"@fr ;
    fe:organicHRPBasis 15 ; #MJ/Kg - Valeur indicative pour les champignons en général, à affiner par classe ou ordre.
    skos:inScheme fe:TaxonomyScheme ; 
    skos:narrower fe:Dikarya, fe:LichenizedFungi .

# --- NIVEAU DIVISION (Division) ---
fe:Dikarya a skos:Concept, fe:BioDivision ;
    skos:prefLabel "Champignons Supérieurs (Dikarya)"@fr ;
    skos:broader fe:Fungus ;
    skos:narrower fe:Ascomycota, fe:Basidiomycota .

fe:LichenizedFungi a skos:Concept, fe:BioDivision ;
    skos:prefLabel "Champignons Lichénisés"@fr ;
    skos:broader fe:Fungus_Reign ;
    skos:narrower fe:Lecanoromycetes .

# --- NIVEAU SOUS-DIVISION (SubDivision) ---
fe:Basidiomycota a skos:Concept, fe:BioSubDivision ;
    skos:prefLabel "Basidiomycètes"@fr ;
    skos:broader fe:Dikarya ;
    skos:narrower fe:Agaricomycetes .

fe:Ascomycota a skos:Concept, fe:BioSubDivision ;
    skos:prefLabel "Ascomycètes"@fr ;
    skos:broader fe:Dikarya .

# --- NIVEAU CLASSE (Class) ---
fe:Agaricomycetes a skos:Concept, fe:BioClass ;
    skos:prefLabel "Agaricomycètes"@fr ;
    skos:broader fe:Basidiomycota.

fe:Lecanoromycetes a skos:Concept, fe:BioClass ;
    skos:prefLabel "Lécanoromycètes (Lichens principaux)"@fr ;
    skos:broader fe:LichenizedFungi .

# --- NIVEAU ORDRE (Order) ---
fe:Polyporales a skos:Concept, fe:BioOrder ;
    skos:prefLabel "Polyporales"@fr ;
    skos:broader fe:Agaricomycetes ;
    skos:narrower fe:Fomitopsidaceae .

# --- NIVEAU FAMILLE (Family) ---
fe:Fomitopsidaceae a skos:Concept, fe:BioFamily ;
    skos:prefLabel "Fomitopsidacées"@fr ;
    skos:broader fe:Polyporales ;
    skos:narrower fe:Fomitopsis .

# --- NIVEAU GENRE (Genre) ---
fe:Fomitopsis a skos:Concept, fe:BioGenre ;
    skos:prefLabel "Fomitopsis (Genre)"@fr ;
    skos:broader fe:Fomitopsidaceae ;
    skos:narrower fe:FomitopsisPinicola .

# --- NIVEAU TAXON (Espèce) ---
fe:FomitopsisPinicola a skos:Concept, fe:Taxon ;
    skos:prefLabel "Polypore du Pin"@fr ;
    skos:broader fe:Fomitopsis.


# --- UICN (fe:IUCNCategory) ---
fe:IUCN_EX a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Éteint (EX)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_EW a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Éteint à l'état sauvage (EW)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_CR a skos:Concept, fe:IUCNCategory ; skos:prefLabel "En danger critique (CR)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_EN a skos:Concept, fe:IUCNCategory ; skos:prefLabel "En danger (EN)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_VU a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Vulnérable (VU)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_NT a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Quasi menacé (NT)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_LC a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Préoccupation mineure (LC)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_DD a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Données insuffisantes (DD)"@fr ; skos:inScheme fe:IUCScheme .
fe:IUCN_NE a skos:Concept, fe:IUCNCategory ; skos:prefLabel "Non évalué (NE)"@fr ; skos:inScheme fe:IUCScheme .

# --- Traits Feu (fe:FlammabilityLevel, fe:FireAidingTrait, etc.) ---
fe:FlammabilityScale a skos:Concept ; skos:prefLabel "Échelle d'Inflammabilité"@fr ; skos:inScheme fe:FireTraitScheme ; skos:narrower fe:Flam_Extreme, fe:Flam_Very_High, fe:Flam_High, fe:Flam_Moderate, fe:Flam_Low, fe:Flam_NonFlammable .
fe:Flam_Extreme a skos:Concept, fe:FlammabilityLevel ; skos:prefLabel "Extrêmement Inflammable"@fr ; skos:broader fe:FlammabilityScale; fe:ValetteScore 5.
fe:Flam_Very_High a skos:Concept, fe:FlammabilityLevel ; skos:prefLabel "Très Inflammable"@fr ; skos:broader fe:FlammabilityScale; fe:ValetteScore 4 .
fe:Flam_High a skos:Concept, fe:FlammabilityLevel ; skos:prefLabel "Hautement Inflammable"@fr ; skos:broader fe:FlammabilityScale; fe:ValetteScore 3 .
fe:Flam_Moderate a skos:Concept, fe:FlammabilityLevel ; skos:prefLabel "Moyennement Inflammable"@fr ; skos:broader fe:FlammabilityScale ; fe:ValetteScore 2 .
fe:Flam_Low a skos:Concept, fe:FlammabilityLevel ; skos:prefLabel "Difficilement Inflammable"@fr ; skos:broader fe:FlammabilityScale ; fe:ValetteScore 1 .
fe:Flam_NonFlammable a skos:Concept, fe:FlammabilityLevel ; skos:prefLabel "Non Inflammable"@fr ; skos:broader fe:FlammabilityScale ; fe:ValetteScore 0 .

fe:FireAidingTrait a skos:Concept ; skos:prefLabel "Traits favorisant le feu"@fr ; skos:inScheme fe:FireTraitScheme ; skos:narrower fe:EssentialOils, fe:ResinExudate, fe:Marcescence, fe:FineFuelStructure, fe:LadderFuelArchitecture .
fe:EssentialOils a skos:Concept, fe:FireAidingTrait ;
    skos:prefLabel "Huiles Essentielles"@fr ;
    fe:heatReleasePotential "25.0"^^xsd:decimal ;    # Augmente la puissance calorifique
    fe:spontaneousIgnitionThreshold "150.0"^^xsd:decimal . # Baisse le seuil d'allumage

fe:ResinExudate a skos:Concept, fe:FireAidingTrait ;
    skos:prefLabel "Exsudats Résineux"@fr ;
    fe:heatReleasePotential "30.0"^^xsd:decimal .

fe:Marcescence a skos:Concept, fe:FireAidingTrait ;
    skos:prefLabel "Marcescence"@fr ;
    fe:spontaneousIgnitionThreshold "180.0"^^xsd:decimal ;
    fe:heatReleasePotential "15.0"^^xsd:decimal .

fe:LadderFuelArchitecture a skos:Concept, fe:FireAidingTrait ;
    skos:prefLabel "Architecture en Échelle"@fr ;
    fe:verticalTransferPotential "50.0"^^xsd:decimal .

fe:FineFuelStructure a skos:Concept, fe:FireAidingTrait ;
    skos:prefLabel "Structure de Brindilles Fines"@fr ;
    fe:spontaneousIgnitionThreshold "160.0"^^xsd:decimal ;
    fe:heatReleasePotential "10.0"^^xsd:decimal ;
    fe:horizontalTransferPotential "40.0"^^xsd:decimal .


fe:FireResistingTrait a skos:Concept ; skos:prefLabel "Traits résistant au feu"@fr ; skos:inScheme fe:FireTraitScheme ; skos:narrower fe:SuberousBark, fe:ThermalInertiaTrunk, fe:HighSucculence, fe:MineralContent, fe:SelfPruning, fe:CrownDiscontinuity .
fe:SuberousBark a skos:Concept, fe:FireResistingTrait ;
    skos:prefLabel "Écorce Subéreuse (Liège)"@fr ;
    fe:fireResistanceDuration "40.0"^^xsd:decimal .

fe:ThermalInertiaTrunk a skos:Concept, fe:FireResistingTrait ;
    skos:prefLabel "Inertie Thermique du Tronc"@fr ;
    fe:fireResistanceDuration "60.0"^^xsd:decimal .

fe:HighSucculence a skos:Concept, fe:FireResistingTrait ;
    skos:prefLabel "Succulence / Teneur en eau"@fr ;
    fe:spontaneousIgnitionThreshold "150.0"^^xsd:decimal .

fe:MineralContent a skos:Concept, fe:FireResistingTrait ;
    skos:prefLabel "Teneur en Sels Minéraux"@fr ;
    fe:spontaneousIgnitionThreshold "50.0"^^xsd:decimal .

fe:SelfPruning a skos:Concept, fe:FireResistingTrait ;
    skos:prefLabel "Auto-élagage"@fr ;
    fe:verticalTransferPotential "-50.0"^^xsd:decimal .

fe:CrownDiscontinuity a skos:Concept, fe:FireResistingTrait ;
    skos:prefLabel "Discontinuité du Houppier"@fr ;
    fe:horizontalTransferPotential "-40.0"^^xsd:decimal .

# --- Stratégies (fe:FireResponseStrategy) ---
fe:FireFunctionalRoleRoot a skos:Concept ; skos:prefLabel "Rôles fonctionnels face au feu"@fr ; skos:inScheme fe:PlantFireStrategyScheme ; skos:narrower fe:Role_Screen, fe:Role_Ladder, fe:Role_Spotter, fe:Role_Retardant .
fe:Role_Screen a skos:Concept, fe:FireFunctionalRole; skos:prefLabel "Écran / Bouclier"@fr ; skos:broader fe:FireFunctionalRoleRoot .
fe:Role_Ladder a skos:Concept, fe:FireFunctionalRole ; skos:prefLabel "Vecteur Vertical (Échelle)"@fr ; skos:broader fe:FireFunctionalRoleRoot .
fe:Role_Spotter a skos:Concept, fe:FireFunctionalRole ; skos:prefLabel "Diffuseur (Projection)"@fr ; skos:broader fe:FireFunctionalRoleRoot .
fe:Role_Retardant a skos:Concept, fe:FireFunctionalRole ; skos:prefLabel "Retardateur (pare-feu Vert)"@fr ; skos:broader fe:FireFunctionalRoleRoot .

fe:FireResponseStrategyRoot a skos:Concept ; skos:prefLabel "Stratégies de réponse au feu"@fr ; skos:inScheme fe:PlantFireStrategyScheme ; skos:narrower fe:Strategy_Resister, fe:Strategy_Endurer, fe:Strategy_Recruiter .
fe:Strategy_Resister a skos:Concept, fe:FireResponseStrategy ; skos:prefLabel "Résistant"@fr ; skos:broader fe:FireResponseStrategyRoot .
fe:Strategy_Endurer a skos:Concept, fe:FireResponseStrategy ; skos:prefLabel "Endurant (Rejette)"@fr ; skos:broader fe:FireResponseStrategyRoot .
fe:Strategy_Recruiter a skos:Concept, fe:FireResponseStrategy ; skos:prefLabel "Recruteur (Graines)"@fr ; skos:broader fe:FireResponseStrategyRoot .

# --- Escarbilles (fe:EmberType) ---
fe:EmberTypeRoot a skos:Concept ; skos:prefLabel "Types de débris et escarbilles"@fr ; skos:inScheme fe:FireTraitScheme ; skos:narrower fe:Ember_Ash, fe:Ember_BarkFlake, fe:Ember_Cone, fe:noEmber .
fe:Ember_Ash a skos:Concept, fe:EmberType ; skos:prefLabel "Cendres légères"@fr ; skos:broader fe:EmberTypeRoot .
fe:Ember_BarkFlake a skos:Concept, fe:EmberType ; skos:prefLabel "Lambeaux d'écorce"@fr ; skos:broader fe:EmberTypeRoot .
fe:Ember_Cone a skos:Concept, fe:EmberType ; skos:prefLabel "Cônes / Pommes de pin"@fr ; skos:broader fe:EmberTypeRoot .
fe:noEmber a skos:Concept, fe:EmberType ; skos:prefLabel "Ne produit pas d'escarbilles"@fr ; skos:broader fe:EmberTypeRoot .

#Status de Protection de l'Espèce (fe:SpeciesProtectionStatus) - à relier aux catégories UICN
fe:UICNStatusScheme a skos:ConceptScheme ;
    rdfs:label "Référentiel des Statuts de Conservation (UICN)"@fr .

# --- Éteint (Priorité 0 ou basse car protection physique inutile) ---
fe:StatusEX a skos:Concept, fe:SpeciesProtectionStatus ;
    skos:prefLabel "EX - Éteint"@fr ;
    fe:protectionPriorityWeight 0.0 ;
    skos:inScheme fe:UICNStatusScheme .

# --- En Danger Critique (Priorité Maximale) ---
fe:StatusCR a skos:Concept, fe:SpeciesProtectionStatus ;
    skos:prefLabel "CR - En danger critique"@fr ;
    fe:protectionPriorityWeight 5.0 ; 
    skos:inScheme fe:UICNStatusScheme .

# --- En Danger ---
fe:StatusEN a skos:Concept, fe:SpeciesProtectionStatus ;
    skos:prefLabel "EN - En danger"@fr ;
    fe:protectionPriorityWeight 4.0 ;
    skos:inScheme fe:UICNStatusScheme .

# --- Vulnérable ---
fe:StatusVU a skos:Concept, fe:SpeciesProtectionStatus ;
    skos:prefLabel "VU - Vulnérable"@fr ;
    fe:protectionPriorityWeight 3.0 ;
    skos:inScheme fe:UICNStatusScheme .

# --- Quasi Menacé ---
fe:StatusNT a skos:Concept, fe:SpeciesProtectionStatus ;
    skos:prefLabel "NT - Quasi menacé"@fr ;
    fe:protectionPriorityWeight 2.0 ;
    skos:inScheme fe:UICNStatusScheme .

# --- Préoccupation Mineure ---
fe:StatusLC a skos:Concept, fe:SpeciesProtectionStatus ;
    skos:prefLabel "LC - Préoccupation mineure"@fr ;
    fe:protectionPriorityWeight 1.0 ;
    skos:inScheme fe:UICNStatusScheme .


# =================================================================
# THESAURUS ALIGNMENT - Fuse natural-space classes
# =================================================================

fe:UICNStatusScheme skos:hasTopConcept fe:StatusEX, fe:StatusCR, fe:StatusEN, fe:StatusVU, fe:StatusNT, fe:StatusLC .
fe:StatusEX skos:topConceptOf fe:UICNStatusScheme ; skos:closeMatch fe:IUCN_EX .
fe:StatusCR skos:topConceptOf fe:UICNStatusScheme ; skos:closeMatch fe:IUCN_CR .
fe:StatusEN skos:topConceptOf fe:UICNStatusScheme ; skos:closeMatch fe:IUCN_EN .
fe:StatusVU skos:topConceptOf fe:UICNStatusScheme ; skos:closeMatch fe:IUCN_VU .
fe:StatusNT skos:topConceptOf fe:UICNStatusScheme ; skos:closeMatch fe:IUCN_NT .
fe:StatusLC skos:topConceptOf fe:UICNStatusScheme ; skos:closeMatch fe:IUCN_LC .


fe:Fungus_Reign a skos:Concept, fe:BioReign ;
    skos:prefLabel "Champignon (alias historique)"@fr ;
    skos:exactMatch fe:Fungus ;
    skos:inScheme fe:TaxonomyScheme .

fe:FireAidingTrait a owl:Class ;
    rdfs:subClassOf fe:BioTrait .

fe:FireResistingTrait a owl:Class ;
    rdfs:subClassOf fe:BioTrait .

fe:Animal skos:topConceptOf fe:TaxonomyScheme .
fe:Plant skos:topConceptOf fe:TaxonomyScheme .
fe:Fungus skos:topConceptOf fe:TaxonomyScheme .
fe:FlammabilityScale skos:topConceptOf fe:FireTraitScheme .
fe:FireAidingTrait skos:topConceptOf fe:FireTraitScheme .
fe:FireResistingTrait skos:topConceptOf fe:FireTraitScheme .
fe:EmberTypeRoot skos:topConceptOf fe:FireTraitScheme .
fe:FireResponseStrategyRoot skos:topConceptOf fe:PlantFireStrategyScheme .
fe:FireFunctionalRoleRoot skos:topConceptOf fe:PlantFireStrategyScheme .
fe:IUCN_EX skos:topConceptOf fe:IUCScheme .
fe:IUCN_EW skos:topConceptOf fe:IUCScheme .
fe:IUCN_CR skos:topConceptOf fe:IUCScheme .
fe:IUCN_EN skos:topConceptOf fe:IUCScheme .
fe:IUCN_VU skos:topConceptOf fe:IUCScheme .
fe:IUCN_NT skos:topConceptOf fe:IUCScheme .
fe:IUCN_LC skos:topConceptOf fe:IUCScheme .
fe:IUCN_DD skos:topConceptOf fe:IUCScheme .
fe:IUCN_NE skos:topConceptOf fe:IUCScheme .
