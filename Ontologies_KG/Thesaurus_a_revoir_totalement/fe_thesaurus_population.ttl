@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<http://example.org/fire_and_evacuation/thesaurus_population> a owl:Ontology ;
    rdfs:label "Référentiel Complet : Populations, Facteurs Humains et Mobilités"@fr ;
    dct:description "Ce module définit les taxonomies SKOS pour la classification des populations et les paramètres comportementaux associés (vitesse, perception, entraînement)."@fr .

# =================================================================
# 1. TAXONOMIES (SKOS Concept Schemes)
# =================================================================

fe:PopulationTaxonomy a skos:ConceptScheme ;
    skos:prefLabel "Taxonomie des Populations"@fr ;
    dct:description "Critères démographiques, de mobilité et de rôles fonctionnels."@fr .

fe:HumanFactorsTaxonomy a skos:ConceptScheme ;
    skos:prefLabel "Taxonomie des Facteurs Humains"@fr ;
    dct:description "Paramètres comportementaux influençant la prise de décision en évacuation."@fr .

# =================================================================
# 2. MOBILITÉ (Couplage Sémantique + Donnée numérique)
# =================================================================

# La classe racine pour le simulateur
fe:populationPartitionMobilityClass a owl:Class ;
    rdfs:subClassOf fe:HumanFactorType ;
    rdfs:label "Classe de Mobilité"@fr ;
    rdfs:comment "Catégorisation des capacités de déplacement incluant la valeur moyenne de vélocité (m/s)."@fr .

fe:Mobility_Valid a skos:Concept, fe:populationPartitionMobilityClass ;
    skos:prefLabel "Valide"@fr ;
    skos:scopeNote "Vitesse de marche standard, autonome."@fr ;
    skos:inScheme fe:PopulationTaxonomy ;
    fe:hasAverageVelocity "1.4"^^xsd:decimal . # Vitesse moyenne (m/s)

fe:Mobility_Invalid a skos:Concept, fe:populationPartitionMobilityClass ;
    skos:prefLabel "Invalide / PMR"@fr ;
    skos:definition "Nécessite assistance ou équipement."@fr ;
    skos:inScheme fe:PopulationTaxonomy ;
    fe:hasAverageVelocity "0.5"^^xsd:decimal .

fe:Mobility_Elderly a skos:Concept, fe:populationPartitionMobilityClass ;
    skos:prefLabel "Sénior"@fr ;
    skos:scopeNote "Mobilité réduite sans être invalide."@fr ;
    skos:inScheme fe:PopulationTaxonomy ;
    fe:hasAverageVelocity "0.9"^^xsd:decimal .

fe:Mobility_Child a skos:Concept, fe:populationPartitionMobilityClass ;
    skos:prefLabel "Enfant"@fr ;
    skos:scopeNote "Pas irrégulier et réduit."@fr ;
    skos:inScheme fe:PopulationTaxonomy ;
    fe:hasAverageVelocity "0.8"^^xsd:decimal .

# =================================================================
# 3. GROUPES FONCTIONNELS ET STATUTS
# =================================================================

fe:Group_Civilian a skos:Concept, fe:populationPartitionFunctionalGroup ;
    skos:prefLabel "Civil / Visiteur"@fr ;
    skos:definition "Public sans mission de sécurité spécifique."@fr ;
    skos:inScheme fe:PopulationTaxonomy .

fe:Group_Rescue a skos:Concept, fe:populationPartitionFunctionalGroup ;
    skos:prefLabel "Secours / Intervention"@fr ;
    skos:inScheme fe:PopulationTaxonomy .

fe:Status_Resident a skos:Concept, fe:populationPartitionStatus ;
    skos:prefLabel "Résident / Habitant"@fr ;
    skos:scopeNote "Connaissance experte des lieux."@fr ;
    skos:inScheme fe:PopulationTaxonomy .

fe:Status_Tourist a skos:Concept, fe:populationPartitionStatus ;
    skos:prefLabel "Touriste"@fr ;
    skos:definition "Besoin total de signalétique d'évacuation."@fr ;
    skos:inScheme fe:PopulationTaxonomy .

# =================================================================
# 4. PARAMÈTRES COGNITIFS ET ÉDUCATIFS
# =================================================================

# Perception du Risque
fe:Perception_None a skos:Concept, fe:populationPartitionRiskPerceptionLevel ; skos:prefLabel "Nulle / Déni"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .
fe:Perception_High a skos:Concept, fe:populationPartitionRiskPerceptionLevel ; skos:prefLabel "Alerte maximale"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .

# Vigilance
fe:Awareness_None a skos:Concept, fe:populationPartitionAwarenessLevel ; skos:prefLabel "Distrait"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .
fe:Awareness_Trained a skos:Concept, fe:populationPartitionAwarenessLevel ; skos:prefLabel "Actif / Briefé"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .

# Entraînement
fe:Training_None a skos:Concept, fe:populationPartitionTrainingLevel ; skos:prefLabel "Aucun"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .
fe:Training_Professional a skos:Concept, fe:populationPartitionTrainingLevel ; skos:prefLabel "Professionnel (Secours)"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .

# Éducation
fe:Edu_Primary a skos:Concept, fe:populationPartitionEducationLevel ; skos:prefLabel "Primaire"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .
fe:Edu_Higher a skos:Concept, fe:populationPartitionEducationLevel ; skos:prefLabel "Supérieur"@fr ; skos:inScheme fe:HumanFactorsTaxonomy .

# =================================================================
# DÉCLARATION DE LA PROPRIÉTÉ DE VITESSE (Attachement au simulateur)
# =================================================================

fe:hasAverageVelocity a owl:DatatypeProperty ;
    rdfs:label "vitesse de déplacement moyenne (m/s)"@fr ;
    rdfs:comment "Valeur décimale utilisée par le moteur de pathfinding de SocSIM-K."@fr ;
    rdfs:domain fe:populationPartitionMobilityClass ;
    rdfs:range xsd:decimal .


# =================================================================
# THESAURUS ALIGNMENT - Fuse population schemes
# =================================================================

fe:PopulationTaxonomy skos:hasTopConcept fe:Mobility_Valid, fe:Mobility_Invalid, fe:Mobility_Elderly, fe:Mobility_Child, fe:Group_Civilian, fe:Group_Rescue, fe:Status_Resident, fe:Status_Tourist .
fe:HumanFactorsTaxonomy skos:hasTopConcept fe:Perception_None, fe:Perception_High, fe:Awareness_None, fe:Awareness_Trained, fe:Training_None, fe:Training_Professional, fe:Edu_Primary, fe:Edu_Higher .
