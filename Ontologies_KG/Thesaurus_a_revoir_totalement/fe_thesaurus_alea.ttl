@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/fire_and_evacuation/thesaurus_alea> a owl:Ontology ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ; # Optionnel : importe les définitions SKOS
    rdfs:label "Vocabulaire des Types d'Aléas"@fr .

# =================================================================
# 1. RÉFÉRENTIEL DES TYPES D'ALÉAS (HazardType)
# =================================================================

fe:HazardTypeScheme a skos:ConceptScheme ;
    rdfs:label "Thésaurus complet des Types d'Aléas"@fr ;
    skos:hasTopConcept fe:Fire_Hazard, fe:Flood_Hazard, fe:Seismic_Hazard, fe:Geological_Hazard, fe:Meteorological_Hazard .

# --- Branche INCENDIES ---
fe:Fire_Hazard a skos:Concept, fe:HazardType ;
    skos:prefLabel "Incendie"@fr ;
    skos:definition "Combustion non maîtrisée se propageant dans le temps et l'espace."@fr ;
    skos:inScheme fe:HazardTypeScheme ;
    skos:topConceptOf fe:HazardTypeScheme ;
    skos:narrower fe:Fire_Class_A, fe:Fire_Class_B, fe:Fire_Class_C, fe:Fire_Class_D, fe:Fire_Class_E, fe:Fire_Class_F .

    fe:Fire_Class_A a skos:Concept, fe:HazardType ;
        skos:prefLabel "Feu de Classe A (Solides)"@fr ;
        skos:broader fe:Fire_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Fire_Class_B a skos:Concept, fe:HazardType ;
        skos:prefLabel "Feu de Classe B (Liquides)"@fr ;
        skos:broader fe:Fire_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Fire_Class_C a skos:Concept, fe:HazardType ;
        skos:prefLabel "Feu de Classe C (Gaz)"@fr ;
        skos:broader fe:Fire_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Fire_Class_D a skos:Concept, fe:HazardType ;
        skos:prefLabel "Feu de Classe D (Métaux)"@fr ;
        skos:broader fe:Fire_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Fire_Class_E a skos:Concept, fe:HazardType ;
        skos:prefLabel "Feu de Classe E (Électrique)"@fr ;
        skos:broader fe:Fire_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Fire_Class_F a skos:Concept, fe:HazardType ;
        skos:prefLabel "Feu de Classe F (Huiles)"@fr ;
        skos:broader fe:Fire_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

# --- Branche INONDATIONS ---
fe:Flood_Hazard a skos:Concept, fe:HazardType ;
    skos:prefLabel "Inondation"@fr ;
    skos:inScheme fe:HazardTypeScheme ;
    skos:topConceptOf fe:HazardTypeScheme ;
    skos:narrower fe:River_Flood, fe:Flash_Flood, fe:Coastal_Flood .

    fe:River_Flood a skos:Concept, fe:HazardType ;
        skos:prefLabel "Crue / Débordement"@fr ;
        skos:broader fe:Flood_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Flash_Flood a skos:Concept, fe:HazardType ;
        skos:prefLabel "Crue Éclair / Ruissellement"@fr ;
        skos:broader fe:Flood_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Coastal_Flood a skos:Concept, fe:HazardType ;
        skos:prefLabel "Submersion Marine"@fr ;
        skos:broader fe:Flood_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

# --- Branche SÉISMES ---
fe:Seismic_Hazard a skos:Concept, fe:HazardType ;
    skos:prefLabel "Séisme"@fr ;
    skos:inScheme fe:HazardTypeScheme ;
    skos:topConceptOf fe:HazardTypeScheme ;
    skos:narrower fe:Tectonic_Earthquake, fe:Induced_Seismicity .

    fe:Tectonic_Earthquake a skos:Concept, fe:HazardType ;
        skos:prefLabel "Séisme Tectonique"@fr ;
        skos:broader fe:Seismic_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Induced_Seismicity a skos:Concept, fe:HazardType ;
        skos:prefLabel "Séisme Induit"@fr ;
        skos:broader fe:Seismic_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

# --- Branche RISQUES GÉOLOGIQUES ---
fe:Geological_Hazard a skos:Concept, fe:HazardType ;
    skos:prefLabel "Risque Géologique"@fr ;
    skos:inScheme fe:HazardTypeScheme ;
    skos:topConceptOf fe:HazardTypeScheme ;
    skos:narrower fe:Landslide, fe:Rockfall .

    fe:Landslide a skos:Concept, fe:HazardType ;
        skos:prefLabel "Glissement de terrain"@fr ;
        skos:broader fe:Geological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Rockfall a skos:Concept, fe:HazardType ;
        skos:prefLabel "Éboulement / Chute"@fr ;
        skos:broader fe:Geological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

# --- Branche MÉTÉOROLOGIQUES ---
fe:Meteorological_Hazard a skos:Concept, fe:HazardType ;
    skos:prefLabel "Aléa Météorologique"@fr ;
    skos:inScheme fe:HazardTypeScheme ;
    skos:topConceptOf fe:HazardTypeScheme ;
    skos:narrower fe:Wind_Storm, fe:Thunderstorm, fe:Heat_Wave, fe:Drought, fe:Snow_Ice_Hazard .

    fe:Wind_Storm a skos:Concept, fe:HazardType ;
        skos:prefLabel "Tempête / Vent Violent"@fr ;
        skos:broader fe:Meteorological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Thunderstorm a skos:Concept, fe:HazardType ;
        skos:prefLabel "Orage / Foudre"@fr ;
        skos:broader fe:Meteorological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Heat_Wave a skos:Concept, fe:HazardType ;
        skos:prefLabel "Canicule / Forte Chaleur"@fr ;
        skos:broader fe:Meteorological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Drought a skos:Concept, fe:HazardType ;
        skos:prefLabel "Sécheresse"@fr ;
        skos:broader fe:Meteorological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

    fe:Snow_Ice_Hazard a skos:Concept, fe:HazardType ;
        skos:prefLabel "Neige / Verglas"@fr ;
        skos:broader fe:Meteorological_Hazard ;
        skos:inScheme fe:HazardTypeScheme .

# =================================================================
# 2. RÉFÉRENTIEL D'INTENSITÉ DE L'ALÉA (IntensityLevel)
# =================================================================

fe:HazardIntensityScheme a skos:ConceptScheme ;
    rdfs:label "Référentiel des Niveaux d'Intensité"@fr ;
    skos:hasTopConcept fe:Intensity_Low, fe:Intensity_Moderate, fe:Intensity_High, fe:Intensity_Extreme .

fe:Intensity_Low a skos:Concept, fe:hazardIntensityLevel ;
    skos:prefLabel "Faible"@fr ;
    skos:definition "Incident mineur sans cinétique majeure."@fr ;
    skos:inScheme fe:HazardIntensityScheme ;
    skos:topConceptOf fe:HazardIntensityScheme .

fe:Intensity_Moderate a skos:Concept, fe:hazardIntensityLevel ;
    skos:prefLabel "Modérée"@fr ;
    skos:definition "Risque notable, surveillance active."@fr ;
    skos:inScheme fe:HazardIntensityScheme ;
    skos:topConceptOf fe:HazardIntensityScheme .

fe:Intensity_High a skos:Concept, fe:hazardIntensityLevel ;
    skos:prefLabel "Forte"@fr ;
    skos:definition "Danger immédiat, moyens spécifiques requis."@fr ;
    skos:inScheme fe:HazardIntensityScheme ;
    skos:topConceptOf fe:HazardIntensityScheme .

fe:Intensity_Extreme a skos:Concept, fe:hazardIntensityLevel ;
    skos:prefLabel "Hors-Norme"@fr ;
    skos:definition "Scénario catastrophe, dépassement des seuils."@fr ;
    skos:inScheme fe:HazardIntensityScheme ;
    skos:topConceptOf fe:HazardIntensityScheme .

# =================================================================
# 3. RÉFÉRENTIEL DE SÉVÉRITÉ DES IMPACTS (ImpactSeverityLevel)
# =================================================================

fe:ImpactSeverityScheme a skos:ConceptScheme, fe:hazardSeverityLevel ;
    rdfs:label "Référentiel de Sévérité des Impacts"@fr ;
    skos:hasTopConcept fe:Severity_Low, fe:Severity_Moderate, fe:Severity_Heavy, fe:Severity_Extreme .

fe:Severity_Low a skos:Concept, fe:hazardSeverityLevel ;
    skos:prefLabel "Sévérité Faible"@fr ;
    skos:definition "Dommages superficiels ou mineurs, sans remise en cause de l'intégrité."@fr ;
    skos:inScheme fe:ImpactSeverityScheme ;
    skos:topConceptOf fe:ImpactSeverityScheme .

fe:Severity_Moderate a skos:Concept, fe:hazardSeverityLevel ;
    skos:prefLabel "Sévérité Modérée"@fr ;
    skos:definition "Dommages partiels nécessitant des réparations, fonction altérée."@fr ;
    skos:inScheme fe:ImpactSeverityScheme ;
    skos:topConceptOf fe:ImpactSeverityScheme .

fe:Severity_Heavy a skos:Concept, fe:hazardSeverityLevel ;
    skos:prefLabel "Sévérité Lourde"@fr ;
    skos:definition "Dommages structurels majeurs, risque d'effondrement ou perte de fonction."@fr ;
    skos:inScheme fe:ImpactSeverityScheme ;
    skos:topConceptOf fe:ImpactSeverityScheme .

fe:Severity_Extreme a skos:Concept, fe:hazardSeverityLevel ;
    skos:prefLabel "Sévérité Extrême"@fr ;
    skos:definition "Destruction totale, perte irréversible de l'artefact ou du bâtiment."@fr ;
    skos:inScheme fe:ImpactSeverityScheme ;
    skos:topConceptOf fe:ImpactSeverityScheme .