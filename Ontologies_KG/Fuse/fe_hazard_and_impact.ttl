@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/hazard_and_impact> a owl:Ontology ;
    rdfs:label "Module Événements de Risque et Bilans d'Impact"@fr ;
    rdfs:comment "Module unifié gérant les phénomènes physiques et les évaluations d'impacts avec alignement CRM."@fr .

# =================================================================
# 1. CLASSES PRINCIPALES
# =================================================================

fe:HazardEvent a owl:Class ;
    rdfs:label "Aléa / Événement de Risque"@fr ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:comment "Instance concrète d'aléa se déroulant dans le simulateur."@fr .

fe:ImpactAssessment a owl:Class ;
    rdfs:label "Bilan d'Impact"@fr ;
    rdfs:subClassOf crm:E13_Attribute_Assignment ;
    rdfs:comment "Évaluation et assignation des dommages provoqués par un événement."@fr .

# Liaison Pivot : CRM utilise P140i pour dire qu'un événement génère une attribution/évaluation
fe:hasImpactAssessment a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140i_was_attributed_by ;
    rdfs:label "génère le bilan d'impact"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:ImpactAssessment .

# =================================================================
# 2. QUALIFICATION DE L'ALÉA
# =================================================================

fe:IntensityLevel a owl:Class ;
    rdfs:subClassOf fe:HazardAndSafetyType ;
    rdfs:label "Niveau d'intensité"@fr .

fe:SeverityLevel a owl:Class ;
    rdfs:subClassOf fe:HazardAndSafetyType ;
    rdfs:label "Niveau de gravité"@fr .

fe:hasHazardType a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "type d'aléa"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:HazardType .

fe:hasIntensityLevel a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "niveau d'intensité"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:IntensityLevel .

fe:hasSeverityLevel a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "niveau de gravité théorique"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:SeverityLevel .

fe:hasIntensityDocumentation a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P70_documents ;
    rdfs:label "est documenté par"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range crm:E31_Document .

fe:hasMeteorologicalObservation a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:label "comprend l'observation météo"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:WeatherMeasurement .

# =================================================================
# 3. ÉVALUATION DES DÉGATS MATÉRIELS
# =================================================================

fe:ImpactSeverityLevel a owl:Class ;
    rdfs:subClassOf fe:HazardAndSafetyType ;
    rdfs:label "Niveau de sévérité des dommages"@fr .

fe:AssessmentItem a owl:Class ;
    rdfs:label "Élément de bilan"@fr ;
    rdfs:subClassOf crm:E13_Attribute_Assignment ;
    rdfs:comment "Classe abstraite pour tout type de constat (Bâti, Naturel, Humain, Artefact...)."@fr .

fe:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:label "contient un élément de bilan"@fr ;
    rdfs:domain fe:ImpactAssessment ;
    rdfs:range fe:AssessmentItem .

fe:BuildingDamage a owl:Class ; rdfs:subClassOf fe:AssessmentItem .
fe:NaturalDamage a owl:Class ; rdfs:subClassOf fe:AssessmentItem .
fe:HumanToll     a owl:Class ; rdfs:subClassOf fe:AssessmentItem .

fe:hasDamageLevel a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:AssessmentItem ;
    rdfs:range fe:ImpactSeverityLevel ;
    rdfs:comment "Indique le niveau de sévérité, applicable à tout type de dégât."@fr .

fe:isDamageTo a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:domain fe:AssessmentItem ;
    rdfs:range crm:E70_Thing ;
    rdfs:comment "Désigne l'entité physique impactée, quel que soit son type."@fr .

# =================================================================
# 4. BILAN HUMAIN
# =================================================================

fe:TriageCount a owl:Class ;
    rdfs:label "Comptage par catégorie de triage"@fr ;
    rdfs:subClassOf fe:AssessmentItem ;
    rdfs:comment "Nombre d'individus par catégorie de gravité (A, B, C, D) pour le bilan humain."@fr .

fe:hasHumanToll a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:label "a pour bilan humain"@fr ;
    rdfs:domain fe:ImpactAssessment ;
    rdfs:range fe:HumanToll .

fe:hasTriageCount a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:label "n individus de la catégorie C"@fr ;
    rdfs:domain fe:HumanToll ;
    rdfs:range fe:TriageCount .

fe:quantity a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P90_has_value ;
    rdfs:label "nombre d'individus"@fr ;
    rdfs:domain fe:TriageCount ;
    rdfs:range xsd:integer .

fe:hasVictim a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:label "inclut la victime identifiée"@fr ;
    rdfs:domain fe:HumanToll ;
    rdfs:range fe:Victim .

# =================================================================
# 5. CLASSES DE RÉFÉRENTIELS (Ranges)
# =================================================================
# Conservées intactes selon tes instructions...