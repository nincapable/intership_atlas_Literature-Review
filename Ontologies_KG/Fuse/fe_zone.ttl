@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/zone> a owl:Ontology ;
    rdfs:label "Module de Gestion des Zones et Topographie"@fr ;
    rdfs:comment "Définit les zones d'intérêt, leur contenu patrimonial/naturel, et le contexte topographique (LiDAR)."@fr .

# =================================================================
# 1. LA CLASSE ZONE
# =================================================================

fe:Zone a owl:Class ;
    rdfs:subClassOf crm:E53_Place ;
    rdfs:label "Zone d'intérêt / Secteur d'intervention"@fr .

fe:hasTopographicContext a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:label "contexte topographique"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:TopographicDataset .

fe:ZoneUsageType a owl:Class ; rdfs:subClassOf fe:OperationnalType .

fe:hasZoneUsage a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "usage de la zone"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:ZoneUsageType .

fe:CommunicationType a owl:Class ; rdfs:subClassOf fe:OperationnalType .

fe:hasCommunicationNode a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "Type de nœud de communication"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:CommunicationType .

# =================================================================
# 2. TOPOGRAPHIE ET DATASETS
# =================================================================

fe:TopographicDataset a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object ;
    rdfs:label "Jeu de données topographiques"@fr .

fe:AcquisitionMethod a owl:Class ; rdfs:subClassOf fe:TechnicalType ;
    rdfs:label "Méthode d'acquisition"@fr ;
    rdfs:comment "Classification des méthodes de collecte de données topographiques (ex: LiDAR, photogrammétrie)."@fr .

fe:hasAcquisitionDate a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "date d'acquisition"@fr ;
    rdfs:domain fe:TopographicDataset ; rdfs:range xsd:dateTime .

fe:hasResolution a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "résolution"@fr ;
    rdfs:domain fe:TopographicDataset ; rdfs:range xsd:string .

fe:hasAcquisitionMethod a owl:ObjectProperty  ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "méthode d'acquisition"@fr ;
    rdfs:domain fe:TopographicDataset ; rdfs:range fe:AcquisitionMethod .

# =================================================================
# 3. TUILES LIDAR
# =================================================================

fe:LidarTile a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object ;
    rdfs:label "Tuile LiDAR"@fr .

fe:hasTileIndex a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "index de tuile"@fr ;
    rdfs:domain fe:LidarTile ; rdfs:range xsd:string .

fe:hasSourceFile a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P1_is_identified_by ;
    rdfs:label "fichier source"@fr ;
    rdfs:domain fe:LidarTile ; rdfs:range xsd:anyURI .

fe:hasBoundingBox a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "emprise spatiale (BBOX)"@fr ;
    rdfs:comment "Format WKT: POLYGON((...))"@fr ; rdfs:domain fe:LidarTile ; rdfs:range xsd:string .

fe:hasAverageSlope a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "pente moyenne"@fr ;
    rdfs:domain fe:LidarTile ; rdfs:range xsd:decimal .

fe:hasMaxElevation a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "élévation maximale"@fr ;
    rdfs:domain fe:LidarTile ; rdfs:range xsd:decimal .

fe:hasMinElevation a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "élévation minimale"@fr ;
    rdfs:domain fe:LidarTile ; rdfs:range xsd:decimal .

fe:adjacentTo a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P132_spatially_overlaps ;
    rdfs:label "est géométriquement connecté à"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

fe:connectsTo a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P132_spatially_overlaps ;
    rdfs:label "est fonctionnellement connecté à"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

fe:isVerticallyStackedWith a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P132_spatially_overlaps ;
    rdfs:label "superposé verticalement"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

fe:hasOverlapWith a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P132_spatially_overlaps ;
    rdfs:label "recouvrement avec"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

# =================================================================
# 4. ÉVALUATION DES RISQUES
# =================================================================

fe:UrgencyAssessment a owl:Class ;
    rdfs:label "Bilan d'urgence (Calculé)"@fr ;
    rdfs:comment "Regroupe les indicateurs de risque calculés dynamiquement pour une zone donnée."@fr ;
    rdfs:subClassOf crm:E13_Attribute_Assignment .

fe:hasUrgencyProfile a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:UrgencyAssessment .

fe:patrimonialUrgencyIndex a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Indice d'urgence patrimoniale"@fr ;
    rdfs:domain fe:UrgencyAssessment ; rdfs:range xsd:decimal .

fe:ecologicalUrgencyIndex a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Indice d'urgence écologique"@fr ;
    rdfs:domain fe:UrgencyAssessment ; rdfs:range xsd:decimal .

fe:structuralDangerIndex a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Indice de péril structurel"@fr ;
    rdfs:domain fe:UrgencyAssessment ; rdfs:range xsd:decimal .

fe:globalEvacuationUrgency a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Urgence globale d'évacuation"@fr ;
    rdfs:domain fe:UrgencyAssessment ; rdfs:range xsd:decimal .

# =================================================================
# 5. CONTENU DE LA ZONE
# =================================================================

fe:containsBuilding a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P46_is_composed_of ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:Building .

fe:containsNaturalSpace a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P46_is_composed_of ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:NaturalSpace .

fe:containsArtefact a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P46_is_composed_of ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:Artefact .


fe:hasZonePriority a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:PriorityLevel .

# Remontée des risques des Bâtiments
fe:hasHazardExposure owl:propertyChainAxiom (fe:containsBuilding fe:hasBuildingFireExposure) .
fe:hasHazardExposure owl:propertyChainAxiom (fe:containsBuilding fe:hasBuildingFloodExposure) .

# Remontée des risques des Espaces Naturels
fe:hasHazardExposure owl:propertyChainAxiom (fe:containsNaturalSpace fe:hasNaturalSpaceFireExposure) .
fe:hasHazardExposure owl:propertyChainAxiom (fe:containsNaturalSpace fe:hasNaturalSpaceFloodExposure) .

# Remontée des risques des Artefacts (si ils sont isolés dans la zone)
fe:hasHazardExposure owl:propertyChainAxiom (fe:containsArtefact fe:hasArtifactFireExposure) .
fe:hasHazardExposure owl:propertyChainAxiom (fe:containsArtefact fe:hasArtifactFloodExposure) .
# La priorité de la Zone est héritée de ses Bâtiments ET de ses Artefacts isolés
fe:hasZonePriority owl:propertyChainAxiom (fe:containsBuilding fe:hasProtectionPriority) .
fe:hasZonePriority owl:propertyChainAxiom (fe:containsArtefact fe:hasProtectionPriority) .

# =================================================================
# 6. POPULATION ET DYNAMIQUE HUMAINE
# =================================================================

fe:hasPopulationAtRisk a owl:ObjectProperty ;
    rdfs:label "population à risque"@fr ;
    rdfs:domain fe:Population ;
    rdfs:range fe:hazardExposure ;
    rdfs:comment "Lien vers le groupe d'agents ou les statistiques de population exposée à un danger."@fr .

fe:hasPopulation a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:label "population présente"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:Population ;
    rdfs:comment "Lien vers le groupe d'agents ou les statistiques de population."@fr .

fe:hasEstimatedCount a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:Population ;
    rdfs:range xsd:integer ;
    rdfs:comment "Effectif théorique ou simulé de la population."@fr .

fe:hasMaximumOccupancy a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "capacité maximale d'occupation"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range xsd:integer ;
    rdfs:comment "Nombre maximum de personnes que la zone peut accueillir en toute sécurité."@fr .

    fe:hasPopulationAtRisk owl:propertyChainAxiom (fe:hasPopulation fe:hasHazardExposure) .