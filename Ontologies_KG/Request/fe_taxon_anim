PREFIX fe: <http://example.org/fire_and_evacuation#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT {
    ?sensi fe:ReactivityFactor ?panic_threshold ;
           fe:calculatedHorizontalTransferPotential ?finalHT ;
           fe:calculatedVerticalTransferPotential 0.0 ;
           fe:calculatedHorizontalBarrierPotential 0.0 ;
           fe:calculatedVerticalBarrierPotential 0.0 ;
           fe:calculatedGeneralFireRisk ?generalRisk .
}
WHERE {
    # 1. On cible les animaux (exclut Plantae/Fungi via l'arbre OWL)
    ?taxon a fe:Taxon . 
    FILTER NOT EXISTS {
        ?taxon rdfs:subClassOf* ?reign .
        FILTER (?reign IN (fe:Plantae, fe:Fungi, fe:Végétal, fe:Champignon))
    }
    ?taxon fe:hasFireSensitivity ?sensi .
    
    # 2. Récupération des caractéristiques comportementales (Héritées automatiquement)
    ?sensi fe:mobilityScore ?m_score .
    ?sensi fe:panicThreshold ?panic_threshold .
    ?sensi fe:evacuationPriority ?e_priority .
    
    # Propriété vectorielle sur le Taxon
    ?taxon fe:fireVectorScore ?v_score .
    
    # 3. Calculs mathématiques
    # Transfert horizontal = v_score * m_score * 10.0
    BIND(xsd:decimal(?v_score) * xsd:decimal(?m_score) * 10.0 AS ?finalHT)
    
    # Risque général = (f_reac * evacuationPriority) + (v_score * 5.0)
    BIND((xsd:decimal(?panic_threshold) * xsd:integer(?e_priority)) + (xsd:decimal(?v_score) * 5.0) AS ?generalRisk)
}