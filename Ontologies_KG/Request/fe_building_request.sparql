PREFIX fe: <http://example.org/fire_and_evacuation#>

DELETE { 
    ?exposure fe:buildingInflammability ?old 
}
INSERT { 
    ?exposure fe:buildingInflammability ?score 
}
WHERE {
    {
        SELECT ?exposure (SUM((?pct / 100.0) * (?s / 10.0)) AS ?score) 
        WHERE {
            ?b fe:hasMaterialComposition ?comp .
            ?comp fe:constituentMaterial ?mat ;
                fe:materialPercentage ?pct .
            ?mat fe:hasReactionToFire ?r . 
            ?r fe:hasReactionClass ?class .
            ?class fe:materialFlammabilityScore ?s . 
            ?b fe:hasGlobalHazardExposure ?g . 
            ?g fe:hasHazardExposure ?exposure .
        } 
        GROUP BY ?exposure
    }
    OPTIONAL { ?exposure fe:buildingInflammability ?old }
}

PREFIX fe: <http://example.org/fire_and_evacuation#>

DELETE { 
    ?exposure fe:buildingCombustibility ?old 
}
INSERT { 
    ?exposure fe:buildingCombustibility ?score 
}
WHERE {
    {
        SELECT ?exposure (SUM(IF(?s > 2, ?pct / 100.0, 0)) AS ?score) 
        WHERE {
            ?b fe:hasMaterialComposition ?comp .
            ?comp fe:constituentMaterial ?mat ;
                fe:materialPercentage ?pct .
            ?mat fe:hasReactionToFire ?r . 
            ?r fe:hasReactionClass ?class .
            ?class fe:materialFlammabilityScore ?s . 
            ?b fe:hasGlobalHazardExposure ?g . 
            ?g fe:hasHazardExposure ?exposure .
        } 
        GROUP BY ?exposure
    }
    OPTIONAL { ?exposure fe:buildingCombustibility ?old }
}

PREFIX fe: <http://example.org/fire_and_evacuation#>

DELETE { 
    ?exposure fe:thermalInertiaScore ?old 
}
INSERT { 
    ?exposure fe:thermalInertiaScore ?score 
}
WHERE {
    {
        SELECT ?exposure (SUM((?pct / 100.0) * ?inertieMateriau) AS ?score) 
        WHERE {
            ?b fe:hasMaterialComposition ?comp .
            ?comp fe:constituentMaterial ?mat ;
                fe:materialPercentage ?pct .
            ?mat fe:hasMaterialInertiaValue ?inertieMateriau .
            ?b fe:hasGlobalHazardExposure ?g . 
            ?g fe:hasHazardExposure ?exposure .
        } 
        GROUP BY ?exposure
    }
    OPTIONAL { ?exposure fe:thermalInertiaScore ?old }
}


INSERT {
    ?building ?property ?value .
}
WHERE {
    # Quantification sur la classe Building
    ?building a fe:Building .
    
    # Paramètres à injecter (via le driver ou l'interface)
    BIND(<PREDICAT_PROPERTY> AS ?property)
    BIND(<VALEUR_NUMERIQUE> AS ?value)

    FILTER NOT EXISTS {
        ?building ?property ?value .
    }
}

INSERT {
    ?building fe:hasFireExposure ?exposureInstance .
    ?exposureInstance a fe:BuildingFireExposure ;
        fe:structuralFragility ?fragility .
}
WHERE {
    ?building a fe:Building .
    
    # Génération d'un URI unique pour l'instance d'exposition
    # En supposant une fonction BNODE() ou URI concaténée
    BIND(IRI(CONCAT(STR(?building), "_fire_exp")) AS ?exposureInstance)
    
    # Paramètres injectés
    BIND(<VALEUR_FRAGILITE> AS ?fragility)

    FILTER NOT EXISTS {
        ?building fe:hasFireExposure ?exposureInstance .
    }
}

INSERT {
    ?building fe:hasMaterialComposition ?comp .
    ?comp a fe:MaterialComposition ;
        fe:hasConstituent ?constituent .
    ?constituent a fe:MaterialConstituent ;
        fe:hasMaterial ?material ;
        fe:materialPercentage ?percentage .
}
WHERE {
    ?building a fe:Building .
    
    # Paramètres injectés
    BIND(<URI_MATERIAU> AS ?material) # ex: fe:Stone
    BIND(<POURCENTAGE> AS ?percentage)
    
    # Génération d'identifiants uniques pour les nœuds d'association
    BIND(BNODE() AS ?comp)
    BIND(BNODE() AS ?constituent)

    FILTER NOT EXISTS {
        ?building fe:hasMaterialComposition ?comp .
        ?comp fe:hasConstituent ?constituent .
        ?constituent fe:hasMaterial ?material .
    }
}