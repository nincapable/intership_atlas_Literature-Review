# =================================================================
# FICHIER CENTRALISÉ : REQUÊTES SPARQL - MODULE ARTEFACTS
# =================================================================
PREFIX fe: <http://example.org/fire_and_evacuation#>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# 1. Récupération des seuils de risque pour un artefact (Input Simulateur)
SELECT ?artefact ?thermalLimit ?smokeIndex ?humidityIndex
WHERE {
    ?artefact a fe:Artefact ;
            fe:hasArtifactFireExposure ?fireExp ;
            fe:hasArtifactFloodExposure ?floodExp .
    ?fireExp fe:thermalToleranceLimit ?thermalLimit ;
            fe:smokeSensitivityIndex ?smokeIndex .
    ?floodExp fe:humiditySensitivityIndex ?humidityIndex .
}

# 2. Identification des artefacts prioritaires au sein d'un conteneur spécifique
# Remplacez <http://example.org/zone/1> par l'URI de votre zone, bâtiment ou espace
SELECT ?artefact ?priorityLabel
WHERE {
  ?monConteneur fe:containsArtefact ?artefact .
    ?artefact fe:hasPriorityLevel ?priority .
    ?priority rdfs:label ?priorityLabel .
  FILTER(CONTAINS(LCASE(?priorityLabel), "critique") || CONTAINS(LCASE(?priorityLabel), "haute"))
  
  # Filtre sur le conteneur spécifique
  FILTER(?monConteneur = <http://example.org/zone/1>)
}

# 3. Liste universelle : Artefacts et leurs conteneurs par urgence
SELECT ?conteneur ?artefact ?priorityLabel
WHERE {
    ?conteneur fe:containsArtefact ?artefact .
    ?artefact fe:hasPriorityLevel ?priority .
    ?priority rdfs:label ?priorityLabel .
    FILTER(CONTAINS(LCASE(?priorityLabel), "critique") || CONTAINS(LCASE(?priorityLabel), "haute"))
}
ORDER BY ?conteneur

# 4. Analyse statistique : Distribution des types de fragilité
SELECT ?fragilityType (COUNT(?artefact) AS ?nbArtefacts)
WHERE {
    ?artefact fe:hasArtifactsFragilityType ?fragilityType .
}
GROUP BY ?fragilityType

# 5. Localisation des artefacts sensibles aux fumées (Action de confinement)
SELECT ?artefact ?smokeIndex
WHERE {
    ?artefact fe:hasArtifactFireExposure ?fireExp .
    ?fireExp fe:smokeSensitivityIndex ?smokeIndex .
    FILTER(?smokeIndex > 0.8)
}