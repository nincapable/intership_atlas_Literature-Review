PREFIX fe: <http://example.org/fire_and_evacuation#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT {
    ?risk fe:buildingCombustibility ?totalCombustibility ;
          fe:smokePropensity ?totalSmoke ;
          fe:structuralFragility ?finalFragility ;
          fe:thermalInertiaScore ?finalInertia .
}
WHERE {
    # 1. On cible le bâtiment et son nœud de risque
    ?building fe:hasBuildingFireRisk ?risk .
    
    # 2. Agrégation mathématique des Euroclasses des matériaux
    {
        SELECT ?building 
               (SUM(?combustibility_score * ?share) AS ?totalCombustibility)
               (SUM(?smoke_score * ?share) AS ?totalSmoke)
        WHERE {
            ?building fe:hasMaterialComposition ?comp .
            ?comp fe:refersToMaterial ?material ;
                  fe:materialPercentage ?percent .
            BIND(xsd:decimal(?percent) / 100.0 AS ?share)
            
            ?material fe:hasReaction ?reaction .
            ?reaction fe:hasReactionClass/skos:prefLabel ?r_label .
            ?reaction fe:hasSmokeClass/skos:prefLabel ?s_label .
            
            # Équivalent de ton reaction_map {} en Python
            BIND(IF(STRSTARTS(?r_label, "A1"), 0.0,
                 IF(STRSTARTS(?r_label, "A2"), 0.1,
                 IF(STRSTARTS(?r_label, "B"), 0.3,
                 IF(STRSTARTS(?r_label, "C"), 0.5,
                 IF(STRSTARTS(?r_label, "D"), 0.7,
                 IF(STRSTARTS(?r_label, "E"), 0.9, 1.0)))))) AS ?combustibility_score)
                 
            # Équivalent de ton smoke_map {}
            BIND(IF(STRSTARTS(?s_label, "s1"), 0.2,
                 IF(STRSTARTS(?s_label, "s2"), 0.6, 1.0)) AS ?smoke_score)
        }
        GROUP BY ?building
    }
    
    # 3. Récupération des coefficients du Style Architectural (Hérités par Inférence)
    ?building fe:hasArchitectureStyle ?style .
    ?style fe:structuralFragility ?frag_coeff .
    ?style fe:thermalInertiaScore ?inertia_base .
    
    # 4. Calculs des indicateurs finaux complexes
    BIND(?totalCombustibility * xsd:decimal(?frag_coeff) AS ?finalFragility)
    BIND(?inertia_base - (?totalCombustibility * 0.4) AS ?calc_inertia)
    BIND(IF(?calc_inertia < 0, 0.0, ?calc_inertia) AS ?finalInertia)
}