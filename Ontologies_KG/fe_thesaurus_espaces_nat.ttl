@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# =================================================================
# 1. RACINE : TYPES NATURELS
# =================================================================
fe:NaturalType a owl:Class ;
    rdfs:label "Type d'Espace Naturel"@fr ;
    rdfs:subClassOf crm:E55_Type .

# =================================================================
# 2. MILIEUX FORESTIERS (Biomasse haute)
# =================================================================
fe:Forest a owl:Class ;
    rdfs:subClassOf fe:NaturalType ;
    rdfs:label "Milieu Forestier"@fr ;
    crm:P3_has_note "Risque : Forte charge calorifique, feu de cime possible, accès difficile pour les engins."@fr .

    fe:ConiferousForest a owl:Class ;
        rdfs:subClassOf fe:Forest ;
        rdfs:label "Forêt de Résineux"@fr ;
        crm:P3_has_note "Risque : Inflammation très rapide (résine), projection d'escarbilles à longue distance."@fr .

    fe:DeciduousForest a owl:Class ;
        rdfs:subClassOf fe:Forest ;
        rdfs:label "Forêt de Feuillus"@fr ;
        crm:P3_has_note "Risque : Accumulation de litière sèche au sol au printemps/automne."@fr .

# =================================================================
# 3. MILIEUX OUVERTS & ARBUSTIFS (Propagation rapide)
# =================================================================
fe:Shrubland a owl:Class ;
    rdfs:subClassOf fe:NaturalType ;
    rdfs:label "Milieu Arbustif (Lande/Maquis)"@fr ;
    crm:P3_has_note "Risque : Végétation dense et basse favorisant une propagation horizontale rapide."@fr .

fe:Grassland a owl:Class ;
    rdfs:subClassOf fe:NaturalType ;
    rdfs:label "Prairie / Pelouse"@fr ;
    crm:P3_has_note "Risque : Feu d'herbe rapide mais de faible puissance, sensible au vent."@fr .

# =================================================================
# 4. MILIEUX AGRICOLES (Risque saisonnier)
# =================================================================
fe:Crop a owl:Class ;
    rdfs:subClassOf fe:NaturalType ;
    rdfs:label "Espace Agricole / Culture"@fr ;
    crm:P3_has_note "Risque : Pic de dangerosité lors des moissons (poussières, pailles sèches)."@fr .

fe:Orchard a owl:Class ;
    rdfs:subClassOf fe:Crop ;
    rdfs:label "Verger"@fr ;
    crm:P3_has_note "Risque : Végétation ligneuse avec des espaces ouverts, feu modéré mais difficile à éteindre."@fr .

fe:Vineyard a owl:Class ;
    rdfs:subClassOf fe:Crop ;
    rdfs:label "Vignoble"@fr ;
    crm:P3_has_note "Risque : Végétation basse et dense, feu rapide mais de faible intensité."@fr .

# =================================================================
# 5. MILIEUX HUMIDES (Barrière naturelle / Accès)
# =================================================================
fe:Wetland a owl:Class ;
    rdfs:subClassOf fe:NaturalType ;
    rdfs:label "Zone Humide / Marais"@fr ;
    crm:P3_has_note "Risque : Portance du sol faible (enlisement des véhicules de secours). Atout : Barrière coupe-feu naturelle."@fr .

# =================================================================
# 6. ESPACES AMÉNAGÉS (Interface Urbaine)
# =================================================================
fe:Parc a owl:Class ;
    rdfs:subClassOf fe:NaturalType ;
    rdfs:label "Parc et Jardin Historique"@fr ;
    crm:P3_has_note "Risque : Proximité immédiate du bâti, présence fréquente de public, arbres remarquables à protéger."@fr .