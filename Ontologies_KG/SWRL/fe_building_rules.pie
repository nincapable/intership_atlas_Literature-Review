# Règle : Inférence de la fragilité structurelle par héritage du style
# Priorité : Valeur manuelle sur l'exposition > Héritage du style architectural
Id: infer_structural_fragility_from_style
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasArchitectureStyle> ?style .
    ?style <http://example.org/fire_and_evacuation#hasDefaultVulnerabilityProfile> ?vulc .
    ?vulc <http://example.org/fire_and_evacuation#defaultFireStructuralFragility> ?val .
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?exposure a <http://example.org/fire_and_evacuation#BuildingFireExposure> .
    # Condition : Le NOT garantit qu'on ne fait rien si la propriété est déjà présente
    NOT ?exposure <http://example.org/fire_and_evacuation#structuralFragility> ?val_override .
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#structuralFragility> ?val .

    # Règle : Gradient de fragilité structurelle (Inverse de la résistance R)
# d < 30 min (très fragile) -> 1.0
# 30 <= d < 60 min -> 0.6
# 60 <= d < 120 min -> 0.3
# d >= 120 min -> 0.1

Id: infer_structural_fragility_gradient_high
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?b <http://example.org/fire_and_evacuation#hasFireResistance> ?rating .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#R> .
    ?rating <http://example.org/fire_and_evacuation#resistanceDuration> ?d .
    Filter: ?d < 30
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#structuralFragility> "1.0"^^<http://www.w3.org/2001/XMLSchema#decimal> .

Id: infer_structural_fragility_gradient_medium
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?b <http://example.org/fire_and_evacuation#hasFireResistance> ?rating .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#R> .
    ?rating <http://example.org/fire_and_evacuation#resistanceDuration> ?d .
    Filter: ?d >= 30 && ?d < 60
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#structuralFragility> "0.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .

Id: infer_structural_fragility_gradient_low
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?b <http://example.org/fire_and_evacuation#hasFireResistance> ?rating .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#R> .
    ?rating <http://example.org/fire_and_evacuation#resistanceDuration> ?d .
    Filter: ?d >= 60
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#structuralFragility> "0.3"^^<http://www.w3.org/2001/XMLSchema#decimal> .

# Règle : Gradient de confinement (Basé sur EI)
# Plus la durée est longue, plus le score de confinement est proche de 1.0

Id: infer_confinement_score_high
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?b <http://example.org/fire_and_evacuation#hasFireResistance> ?rating .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#E> .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#I> .
    ?rating <http://example.org/fire_and_evacuation#resistanceDuration> ?d .
    Filter: ?d >= 60
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#confinementScore> "1.0"^^<http://www.w3.org/2001/XMLSchema#decimal> .

Id: infer_confinement_score_medium
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?b <http://example.org/fire_and_evacuation#hasFireResistance> ?rating .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#E> .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#I> .
    ?rating <http://example.org/fire_and_evacuation#resistanceDuration> ?d .
    Filter: 30 < ?d < 60
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#confinementScore> "0.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .

Id: infer_confinement_score_low
Antecedents:
    ?b <http://example.org/fire_and_evacuation#hasHazardExposure> ?exposure .
    ?b <http://example.org/fire_and_evacuation#hasFireResistance> ?rating .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#E> .
    ?rating <http://example.org/fire_and_evacuation#resistanceComponents> <http://example.org/fire_and_evacuation#I> .
    ?rating <http://example.org/fire_and_evacuation#resistanceDuration> ?d .
    Filter: ?d < 30
Consequents:
    ?exposure <http://example.org/fire_and_evacuation#confinementScore> "0.3"^^<http://www.w3.org/2001/XMLSchema#decimal> .

