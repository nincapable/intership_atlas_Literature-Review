@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/building> a owl:Ontology ;
    rdfs:label "Module Bâtiment et Structures Patrimoniales"@fr ;
    rdfs:comment "Module épuré exploitant les super-classes et thésaurus gérés globalement par le Core."@fr .

# =================================================================
# 1. CLASSES GÉNÉRIQUES DU BÂTIMENT
# =================================================================

fe:Building a owl:Class ; 
    rdfs:label "Bâtiment"@fr ;
    rdfs:subClassOf crm:E25_Man_Made_Feature ;
    rdfs:comment "Structure bâtie d'intérêt patrimonial."@fr .

fe:MaterialInstance a owl:Class ; 
    rdfs:label "Classe des Matériaux"@fr ;
    rdfs:subClassOf crm:E57_Material .

fe:BuildingUsage a owl:Class ; 
    rdfs:label "Classe des Usages du Bâtiment"@fr ;
    rdfs:subClassOf crm:E7_Activity . #verifier si E7_Activity est le bon choix pour les usages du bâtiment

fe:ArchitectureStyle a owl:Class ; 
    rdfs:label "Classe des Styles Architecturaux"@fr ;
    rdfs:subClassOf fe:TechnicalDimension .

fe:DefaultArchitecturalVulnerability a owl:Class ;
    rdfs:label "Vulnérabilité Architecturale par Défaut"@fr ;
    rdfs:comment "Conteneur pour les profils de vulnérabilité standards liés aux styles."@fr .

fe:hasDefaultVulnerabilityProfile a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:label "a pour profil de vulnérabilité par défaut"@fr ;
    rdfs:domain fe:ArchitectureStyle ; 
    rdfs:range fe:DefaultArchitecturalVulnerability .

# Sous-classe spécifique pour l'incendie
fe:DefaultFireArchitecturalVulnerability a owl:Class ;
    rdfs:subClassOf fe:DefaultArchitecturalVulnerability ;
    rdfs:label "Vulnérabilité Incendie par Défaut"@fr .

fe:defaultFireStructuralFragility a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:DefaultFireArchitecturalVulnerability ; 
    rdfs:range xsd:decimal .

fe:defaultStructuralFragility a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "fragilité structurelle par défaut"@fr ;
    rdfs:comment "Valeur de fragilité structurelle portée directement par un style architectural dans le thésaurus bâtiment."@fr ;
    rdfs:domain fe:ArchitectureStyle ;
    rdfs:range xsd:decimal .

fe:defaultFireExpansionFactor a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:DefaultFireArchitecturalVulnerability ; 
    rdfs:range xsd:decimal .

fe:defaultThermalInertiaScore a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:DefaultFireArchitecturalVulnerability ; 
    rdfs:range xsd:decimal .

# Idem pour l'inondation
fe:DefaultFloodArchitecturalVulnerability a owl:Class ;
    rdfs:subClassOf fe:DefaultArchitecturalVulnerability ;
    rdfs:label "Vulnérabilité Inondation par Défaut"@fr .

fe:defaultWaterSubmersionResistance a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:DefaultFloodArchitecturalVulnerability ; 
    rdfs:range xsd:decimal .

fe:defaulHydrostaticPressureLoad a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:DefaultFloodArchitecturalVulnerability ; 
    rdfs:range xsd:decimal .

# =================================================================
# 2. COMPOSITION ET CARACTÉRISTIQUES STRUCTURELLES
# =================================================================
# 1. Classe d'association
fe:MaterialComposition a owl:Class ;
    rdfs:label "Composition de Matériau"@fr ;
    rdfs:subClassOf crm:E89_Propositional_Object . # Mieux adapté pour une agrégation

# 2. Lien Bâtiment -> Composition
fe:hasMaterialComposition a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P46_is_composed_of ;
    rdfs:domain fe:Building ;
    rdfs:range fe:MaterialComposition .

# 3. La classe qui porte le détail (Matériau + Pourcentage)
fe:MaterialConstituent a owl:Class ;
    rdfs:label "Constituant de Matériau"@fr ;
    rdfs:comment "Détail d'un matériau avec son taux de présence."@fr .

# 4. Agrégation : La composition contient des constituants
fe:hasConstituent a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P46_is_composed_of ;
    rdfs:domain fe:MaterialComposition ;
    rdfs:range fe:MaterialConstituent .

# 5. Propriétés du constituant
fe:hasMaterial a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P45_consists_of ;
    rdfs:domain fe:MaterialConstituent ;
    rdfs:range fe:MaterialInstance ;
    rdfs:label "matériau constitutif"@fr .

fe:materialPercentage a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:MaterialConstituent ;
    rdfs:range xsd:decimal ;
    rdfs:label "pourcentage de présence"@fr .

fe:hasArchitectureStyle a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "style architectural"@fr ;
    rdfs:domain fe:Building ;
    rdfs:range fe:ArchitectureStyle .

fe:hasFloorArea a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "surface de plancher (m²)"@fr ;
    rdfs:domain fe:Building ;
    rdfs:range xsd:decimal .

fe:hasNumberOfFloors a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "nombre d'étages"@fr ;
    rdfs:domain fe:Building ;
    rdfs:range xsd:integer .

# Priorité propre au bâtiment (définie manuellement)
fe:hasBuildingIntrinsicPriority a owl:ObjectProperty ;
    rdfs:label "Priorité intrinsèque du bâtiment"@fr ;
    rdfs:domain fe:Building ;
    rdfs:range fe:PriorityLevel .

# Priorité agrégée héritée des artefacts (remontée automatique)
fe:hasInheritedArtefactPriority a owl:ObjectProperty ;
    rdfs:label "Priorité héritée des artefacts"@fr ;
    rdfs:domain fe:Building ;
    rdfs:range fe:PriorityLevel .

# La chaîne de propriété pour l'agrégation
fe:hasInheritedArtefactPriority owl:propertyChainAxiom (fe:containsArtefact fe:hasProtectionPriority) .

# =================================================================
# 3. EXPOSITION SPÉCIFIQUE : INONDATION / SUBMERSION
# =================================================================

fe:BuildingFloodExposure a owl:Class ;
    rdfs:subClassOf fe:hazardExposure ;
    rdfs:label "Fiche d'Exposition Inondation du Bâtiment"@fr .

fe:hasFloodExposure a owl:ObjectProperty ;
    rdfs:subPropertyOf fe:hasHazardExposure ;
    rdfs:domain fe:Building ;
    rdfs:range fe:BuildingFloodExposure .

fe:waterSubmersionResistance a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Résistance à la submersion (m)"@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:decimal .

fe:hydrostaticPressureLoad a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Charge de pression hydrostatique maximale"@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:decimal .

fe:criticalEquipmentFloor a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Étage des équipements critiques"@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:integer .

fe:dryingTimeHours a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Temps de séchage structurel (heures)"@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:integer .

# =================================================================
# 4. EXPOSITION SPÉCIFIQUE : INCENDIE
# =================================================================

fe:BuildingFireExposure a owl:Class ;
    rdfs:subClassOf fe:hazardExposure ;
    rdfs:label "Fiche d'Exposition Incendie pour Bâtiment"@fr ;
    rdfs:comment "Regroupe les paramètres physiques de comportement et de propagation du feu propres à la structure."@fr .

fe:hasFireExposure a owl:ObjectProperty ;
    rdfs:subPropertyOf fe:hasHazardExposure ;
    rdfs:domain fe:Building ;
    rdfs:range fe:BuildingFireExposure .

fe:buildingCombustibility a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "combustibilité du bâtiment"@fr ;
    rdfs:domain fe:BuildingFireExposure ; 
    rdfs:range xsd:decimal .

fe:buildingInflammability a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "inflammabilité du bâtiment"@fr ;
    rdfs:domain fe:BuildingFireExposure ; 
    rdfs:range xsd:decimal .

fe:thermalInertiaScore a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "score d'inertie thermique"@fr ;
    rdfs:domain fe:BuildingFireExposure ; 
    rdfs:range xsd:decimal .

fe:structuralFragility a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "fragilité structurelle face au feu"@fr ;
    rdfs:domain fe:BuildingFireExposure ; 
    rdfs:range xsd:decimal .

fe:confinementScore a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "Score de confinement"@fr ;
    rdfs:domain fe:BuildingFireExposure ;
    rdfs:range xsd:decimal .

fe:smokePropensity a owl:DatatypeProperty ; 
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:label "propension à générer des fumées"@fr ;
    rdfs:domain fe:BuildingFireExposure ; 
    rdfs:range xsd:decimal .

fe:fireExpansionFactor a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
    rdfs:label "facteur d'expansion du feu (3D)"@fr ;
    rdfs:domain fe:BuildingFireExposure ; 
    rdfs:range fe:vector3 .