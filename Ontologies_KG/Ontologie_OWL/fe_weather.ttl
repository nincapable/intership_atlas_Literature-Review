@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/weather> a owl:Ontology ;
    rdfs:label "Module Météo : Climat et Observations"@fr ;
    rdfs:comment "Module gérant le profil climatique de zone et les relevés dynamiques avec alignement CRM."@fr .

# =================================================================
# 1. PARTIE CLIMAT (Statistiques de zone)
# =================================================================

fe:Climate a owl:Class ;
    rdfs:label "Climat Statistique"@fr ;
    rdfs:comment "Données structurelles de la zone (moyennes, extrêmes, type de climat)."@fr ;
    rdfs:subClassOf fe:EnvironmentalDimension .

fe:hasClimateType a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:label "a pour type de climat"@fr ;
    rdfs:domain fe:Climate ;
    rdfs:range fe:ClimateClassification .

fe:ClimateClassification a owl:Class ; rdfs:subClassOf fe:OperationnalType .

# Données Statistiques : Alignement sur P43_has_dimension pour les mesures de climat
fe:hasAvgTemp             a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasMinAvgTemp          a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasMaxAvgTemp          a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgWindSpeed        a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgWindDirection    a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgPrecipitation    a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgHumidity         a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgSunshineDuration a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .

# =================================================================
# 2. PARTIE OBSERVATIONS (Snapshot à l'instant T)
# =================================================================

fe:WeatherCondition a owl:Class ;
    rdfs:label "État Météo à l'instant T"@fr ;
    rdfs:comment "Conteneur regroupant toutes les dimensions mesurées à un instant précis."@fr ;
    rdfs:subClassOf crm:E16_Measurement .

fe:hasTimestamp a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P82_at_some_time_within ;
    rdfs:label "horodatage"@fr ;
    rdfs:domain fe:WeatherCondition ;
    rdfs:range xsd:dateTime .

fe:hasMeasurement a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:label "inclut la mesure"@fr ;
    rdfs:domain fe:WeatherCondition ;
    rdfs:range fe:WeatherDimension .

# =================================================================
# 3. DIMENSIONS MÉTÉOROLOGIQUES
# =================================================================

# Propriétés directes (DatatypeProperties pour la performance du simulateur)
fe:hasTemperature    a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:WeatherCondition ; rdfs:range xsd:decimal .
fe:hasWindSpeed      a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:WeatherCondition ; rdfs:range xsd:decimal .
fe:hasWindDirection  a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:WeatherCondition ; rdfs:range xsd:decimal .
fe:hasPrecipitation  a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:WeatherCondition ; rdfs:range xsd:decimal .
fe:hasHumidity       a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:WeatherCondition ; rdfs:range xsd:decimal .
fe:hasSunshine       a owl:DatatypeProperty ; rdfs:subPropertyOf crm:P43_has_dimension ; rdfs:domain fe:WeatherCondition ; rdfs:range xsd:decimal .

# Extensibilité pour les dimensions complexes
fe:hasOtherDimension a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:domain fe:WeatherCondition ;
    rdfs:range fe:WeatherDimension .

fe:hasValue a owl:DatatypeProperty ;
    rdfs:subPropertyOf crm:P90_has_value ;
    rdfs:label "valeur numérique"@fr ;
    rdfs:domain fe:WeatherDimension ;
    rdfs:range xsd:decimal .


# =================================================================
# THESAURUS ALIGNMENT - weather vocabularies
# =================================================================

fe:weatherQualifier a owl:Class ;
    rdfs:subClassOf fe:OperationnalType ;
    rdfs:label "Qualificatif météorologique"@fr .
