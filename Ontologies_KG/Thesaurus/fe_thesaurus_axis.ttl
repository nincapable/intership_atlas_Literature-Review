@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fe: <http://example.org/fire_and_evacuation#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/thesaurus_axis> a owl:Ontology ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ; # Optionnel : importe les définitions SKOS
    rdfs:label "Vocabulaire des Axes"@fr .

# =================================================================
# DÉFINITION DU SCHÉMA
# =================================================================

fe:AxisTaxonomy a skos:ConceptScheme ;
    rdfs:label "Taxonomie des circulations et accessibilités"@fr .

# =================================================================
# 1. TYPOLOGIE DES AXES (fe:AxisType)
# =================================================================

fe:AxisTypeConcept a skos:Concept ;
    skos:prefLabel "Référentiel des types d'axes"@fr ;
    skos:inScheme fe:AxisTaxonomy ;
    skos:topConceptOf fe:AxisTaxonomy .

fe:couloir a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Couloir"@fr ; 
    skos:broader fe:AxisTypeConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:escalier a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Escalier"@fr ; 
    skos:broader fe:AxisTypeConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:porte a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Porte"@fr ; 
    skos:broader fe:AxisTypeConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:rampe a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Rampe"@fr ; 
    skos:broader fe:AxisTypeConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:ascenseur a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Ascenseur"@fr ; 
    skos:inScheme fe:AxisTaxonomy ;
    skos:broader fe:AxisType .

fe:fenetre a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Fenêtre"@fr ; 
    skos:inScheme fe:AxisTaxonomy ;
    skos:broader fe:AxisType .

fe:voie_ouverte a skos:Concept, fe:AxisType ; 
    skos:prefLabel "Voie ouverte"@fr ; 
    skos:inScheme fe:AxisTaxonomy ;
    skos:broader fe:AxisType .

# =================================================================
# 2. ACCESSIBILITÉ PMR (fe:AccessibilityLevel)
# =================================================================

fe:PMR_AccessibilityConcept a skos:Concept ;
    skos:prefLabel "Référentiel Accessibilité PMR"@fr ;
    skos:inScheme fe:AxisTaxonomy ;
    skos:topConceptOf fe:AxisTaxonomy .

fe:WheelchairAccessible a skos:Concept, fe:AccessibilityLevel ; 
    skos:prefLabel "Accessible Fauteuil Roulant"@fr ; 
    skos:broader fe:PMR_AccessibilityConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:PartiallyArrangedPedestrian a skos:Concept, fe:AccessibilityLevel ; 
    skos:prefLabel "Aménagement partiel"@fr ;
    skos:broader fe:PMR_AccessibilityConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:InaccessibleDisabledPerson a skos:Concept, fe:AccessibilityLevel ; 
    skos:prefLabel "Inaccessible"@fr ;
    skos:broader fe:PMR_AccessibilityConcept ;
    skos:inScheme fe:AxisTaxonomy .

# =================================================================
# 3. ACCESSIBILITÉ SECOURS (fe:RescueAccessibilityLevel)
# =================================================================

fe:Rescue_AccessibilityConcept a skos:Concept ;
    skos:prefLabel "Référentiel Accessibilité Secours"@fr ;
    skos:inScheme fe:AxisTaxonomy ;
    skos:topConceptOf fe:AxisTaxonomy .

fe:Granted a skos:Concept, fe:RescueAccessibilityLevel ; 
    skos:prefLabel "Autorisé / Garanti"@fr ;
    skos:broader fe:Rescue_AccessibilityConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:Uncertain a skos:Concept, fe:RescueAccessibilityLevel ; 
    skos:prefLabel "Incertain"@fr ;
    skos:broader fe:Rescue_AccessibilityConcept ;
    skos:inScheme fe:AxisTaxonomy .

fe:Denied a skos:Concept, fe:RescueAccessibilityLevel ; 
    skos:prefLabel "Refusé / Impossible"@fr ;
    skos:broader fe:Rescue_AccessibilityConcept ;
    skos:inScheme fe:AxisTaxonomy .


# =================================================================
# 4. FACTEURS BLOQUANTS (fe:BlockingFactor)
# =================================================================

fe:BlockingNatureScheme a skos:ConceptScheme ;
    rdfs:label "Référentiel des Natures d'Obstruction des Axes"@fr ;
    skos:definition "Qualifie le type de blocage physique résultant d'une vulnérabilité."@fr .

# --- CATEGORIE : OBSTRUCTION MATÉRIELLE (Débris) ---
fe:DebrisObstruction a skos:Concept, fe:blockingType ;
    skos:prefLabel "Obstruction par débris"@fr ;
    skos:inScheme fe:BlockingNatureScheme ;
    skos:narrower fe:StructuralCollapse, fe:VegetationFall, fe:GlassRain .

    fe:StructuralCollapse a skos:Concept, fe:blockingType ;
        skos:prefLabel "Effondrement de structure"@fr ;
        skos:definition "Chute d'éléments porteurs ou de maçonnerie sur la voie."@fr ;
        skos:broader fe:DebrisObstruction ;
        skos:inScheme fe:BlockingNatureScheme .

    fe:VegetationFall a skos:Concept, fe:blockingType ;
        skos:prefLabel "Chute de végétation"@fr ;
        skos:definition "Obstruction par des troncs, branches ou litière végétale."@fr ;
        skos:broader fe:DebrisObstruction ;
        skos:inScheme fe:BlockingNatureScheme .

    fe:GlassRain a skos:Concept, fe:blockingType ;
        skos:prefLabel "Pluie de verre / Éclats"@fr ;
        skos:broader fe:DebrisObstruction ;
        skos:inScheme fe:BlockingNatureScheme .

# --- CATEGORIE : OBSTRUCTION ATMOSPHÉRIQUE (Environnement) ---
fe:AtmosphericObstruction a skos:Concept, fe:blockingType ;
    skos:prefLabel "Obstruction atmosphérique"@fr ;
    skos:inScheme fe:BlockingNatureScheme ;
    skos:narrower fe:SmokeOpacity, fe:ThermalStress .

    fe:SmokeOpacity a skos:Concept, fe:blockingType ;
        skos:prefLabel "Opacité critique"@fr ;
        skos:definition "Visibilité inférieure à la distance de sécurité (ex: 2m)."@fr ;
        skos:broader fe:AtmosphericObstruction ;
        skos:inScheme fe:BlockingNatureScheme .

    fe:ThermalStress a skos:Concept, fe:blockingType ;
        skos:prefLabel "Flux thermique insupportable"@fr ;
        skos:definition "Rayonnement empêchant le passage sans équipement lourd."@fr ;
        skos:broader fe:AtmosphericObstruction ;
        skos:inScheme fe:BlockingNatureScheme .

# --- CATEGORIE : OBSTRUCTION FLUIDE ---
fe:FluidObstruction a skos:Concept, fe:blockingType ;
    skos:prefLabel "Obstruction par fluides"@fr ;
    skos:inScheme fe:BlockingNatureScheme ;
    skos:narrower fe:FlashFlood, fe:GasLeak .

# --- CATEGORIE : OBSTRUCTION SOCIALE ---
fe:SocialObstruction a skos:Concept, fe:blockingType ;
    skos:prefLabel "Obstruction humaine"@fr ;
    skos:inScheme fe:BlockingNatureScheme ;
    skos:narrower fe:CrowdCrush .


# =================================================================
# THESAURUS ALIGNMENT - Fuse axis classes
# =================================================================

fe:blockingType a owl:Class ;
    owl:equivalentClass fe:BlockingType ;
    rdfs:label "Type de blocage (alias historique du thésaurus)"@fr .

fe:AxisTaxonomy skos:hasTopConcept fe:AxisTypeConcept, fe:PMR_AccessibilityConcept, fe:Rescue_AccessibilityConcept .
fe:BlockingNatureScheme skos:hasTopConcept fe:DebrisObstruction, fe:AtmosphericObstruction, fe:FluidObstruction, fe:SocialObstruction .

fe:AxisTypeConcept skos:closeMatch fe:AxisType .
fe:PMR_AccessibilityConcept skos:closeMatch fe:AccessibilityLevel .
fe:Rescue_AccessibilityConcept skos:closeMatch fe:RescueAccessibilityLevel .

fe:DebrisObstruction skos:topConceptOf fe:BlockingNatureScheme .
fe:AtmosphericObstruction skos:topConceptOf fe:BlockingNatureScheme .
fe:FluidObstruction skos:topConceptOf fe:BlockingNatureScheme .
fe:SocialObstruction skos:topConceptOf fe:BlockingNatureScheme .
