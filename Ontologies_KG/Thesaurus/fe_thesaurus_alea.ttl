@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =================================================================
# 1. INTENSITÉ DE L'ALÉA
# =================================================================

fe:IntensityLevel a owl:Class ;
    owl:oneOf ( fe:Intensity_Low fe:Intensity_Moderate fe:Intensity_High fe:Intensity_Extreme ) .

# --- Niveau 1 : Faible ---
fe:Intensity_Low a fe:IntensityLevel ;
    rdfs:label "Faible"@fr ;
    rdfs:comment "Phénomène courant ou incident mineur. Maîtrisable avec des moyens locaux standards. Pas d'impact significatif hors site ou hors zone immédiate."@fr .

# --- Niveau 2 : Modéré ---
fe:Intensity_Moderate a fe:IntensityLevel ;
    rdfs:label "Modéré"@fr ;
    rdfs:comment "Perturbations notables (ex: vigilance jaune). Nécessite une surveillance accrue et des moyens d'intervention spécifiques. Dommages matériels localisés possibles."@fr .

# --- Niveau 3 : Fort / Grave ---
fe:Intensity_High a fe:IntensityLevel ;
    rdfs:label "Fort / Grave"@fr ;
    rdfs:comment "Cinétique rapide ou seuils de danger atteints (ex: SEI/SDL). Risque pour la sécurité des personnes. Nécessite une coordination inter-services et des mesures de protection (confinement, déviation)."@fr .

# --- Niveau 4 : Extrême ---
fe:Intensity_Extreme a fe:IntensityLevel ;
    rdfs:label "Extrême / Hors-Norme"@fr ;
    rdfs:comment "Comportement erratique, propagation incontrôlable, dépassement des capacités de réponse locales. Nécessite des moyens nationaux ou internationaux. Ruptures durables des infrastructures."@fr .

# =================================================================
# 2. TYPE DE L'ALÉA
# =================================================================

fe:HazardType a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

# --- Branche INCENDIS (Fires) ---

fe:Fire_Hazard a fe:HazardType ;
    rdfs:label "Incendie"@fr .

fe:Fire_Class_A a owl:Class ;
    rdfs:subClassOf fe:Fire_Hazard ;
    rdfs:label "Feu de Classe A (Solides)"@fr ;
    rdfs:comment "Feux de matériaux solides, généralement d'origine organique (bois, papier, tissus)."@fr .

fe:Fire_Class_B a owl:Class ;
    rdfs:subClassOf fe:Fire_Hazard ;
    rdfs:label "Feu de Classe B (Liquides)"@fr ;
    rdfs:comment "Feux de liquides ou de solides liquéfiables (essence, huile, plastiques)."@fr .

fe:Fire_Class_C a owl:Class ;
    rdfs:subClassOf fe:Fire_Hazard ;
    rdfs:label "Feu de Classe C (Gaz)"@fr ;
    rdfs:comment "Feux de gaz (propane, butane, méthane)."@fr .

fe:Fire_Class_D a owl:Class ;
    rdfs:subClassOf fe:Fire_Hazard ;
    rdfs:label "Feu de Classe D (Métaux)"@fr ;
    rdfs:comment "Feux de métaux combustibles (magnésium, aluminium)."@fr .

fe:Fire_Class_E a owl:Class ;
    rdfs:subClassOf fe:Fire_Hazard ; 
    rdfs:label "Feu de Classe E (Électriques)"@fr ;
    rdfs:comment "Feux impliquant des équipements électriques sous tension."@fr .

fe:Fire_Class_F a owl:Class ;
    rdfs:subClassOf fe:Fire_Hazard ;
    rdfs:label "Feu de Classe F (Huiles de Cuisine)"@fr ;
    rdfs:comment "Feux d'huiles et de graisses de cuisson."@fr .

# --- Branche INONDATIONS (Floods) ---

fe:Flood_Hazard a owl:Class ;
    rdfs:subClassOf fe:HazardType ;
    rdfs:label "Inondation"@fr ;
    rdfs:comment "Submersion rapide ou lente d'une zone habituellement hors d'eau."@fr .

fe:River_Flood a owl:Class ;
    rdfs:subClassOf fe:Flood_Hazard ;
    rdfs:label "Crue / Débordement de cours d'eau"@fr ;
    rdfs:comment "Élévation du niveau d'un fleuve ou d'une rivière suite à des précipitations."@fr .

fe:Flash_Flood a owl:Class ;
    rdfs:subClassOf fe:Flood_Hazard ;
    rdfs:label "Crue Éclair"@fr ;
    rdfs:comment "Inondation soudaine causée par des pluies intenses sur un bassin versant court."@fr .

fe:Coastal_Flood a owl:Class ;
    rdfs:subClassOf fe:Flood_Hazard ;
    rdfs:label "Submersion Marine"@fr ;
    rdfs:comment "Inondation des zones côtières par la mer (tempête, forte marée)."@fr .

# --- Branche SÉISMES (Earthquakes) ---

fe:Seismic_Hazard a owl:Class ;
    rdfs:subClassOf fe:HazardType ;
    rdfs:label "Séisme / Tremblement de terre"@fr .

fe:Tectonic_Earthquake a owl:Class ;
    rdfs:subClassOf fe:Seismic_Hazard ;
    rdfs:label "Séisme Tectonique"@fr ;
    rdfs:comment "Libération d'énergie le long d'une faille géologique."@fr .

fe:Induced_Seismicity a owl:Class ;
    rdfs:subClassOf fe:Seismic_Hazard ;
    rdfs:label "Séisme Induit"@fr ;
    rdfs:comment "Secousse causée par l'activité humaine (mines, géothermie, barrages)."@fr .

# --- Branche MOUVEMENTS DE TERRAIN (Landslides) ---

fe:Geological_Hazard a owl:Class ;
    rdfs:subClassOf fe:HazardType ;
    rdfs:label "Risque Géologique"@fr .

fe:Landslide a owl:Class ;
    rdfs:subClassOf fe:Geological_Hazard ;
    rdfs:label "Glissement de terrain"@fr .

fe:Rockfall a owl:Class ;
    rdfs:subClassOf fe:Geological_Hazard ;
    rdfs:label "Éboulement / Chute de pierres"@fr .

# --- Branche MÉTÉOROLOGIQUES (Meteorological) ---

fe:Meteorological_Hazard a owl:Class ;
    rdfs:subClassOf fe:HazardType ;
    rdfs:label "Aléa Météorologique"@fr ;
    rdfs:comment "Phénomène atmosphérique extrême pouvant causer des dommages ou amplifier d'autres risques."@fr .

fe:Wind_Storm a owl:Class ;
    rdfs:subClassOf fe:Meteorological_Hazard ;
    rdfs:label "Tempête / Vent Violent"@fr ;
    rdfs:comment "Rafales de vent dépassant les seuils de sécurité (ex: > 100 km/h)."@fr .

fe:Thunderstorm a owl:Class ;
    rdfs:subClassOf fe:Meteorological_Hazard ;
    rdfs:label "Orage / Foudre"@fr ;
    rdfs:comment "Phénomène électrique et convectif (risque d'incendie par foudre ou de crue éclair)."@fr .

fe:Heat_Wave a owl:Class ;
    rdfs:subClassOf fe:Meteorological_Hazard ;
    rdfs:label "Canicule / Forte Chaleur"@fr ;
    rdfs:comment "Période prolongée de températures anormalement élevées (augmente la combustibilité)."@fr .

fe:Drought a owl:Class ;
    rdfs:subClassOf fe:Meteorological_Hazard ;
    rdfs:label "Sécheresse"@fr ;
    rdfs:comment "Déficit hydrique prolongé impactant la végétation et les sols."@fr .

fe:Snow_Ice_Hazard a owl:Class ;
    rdfs:subClassOf fe:Meteorological_Hazard ;
    rdfs:label "Neige / Verglas"@fr ;
    rdfs:comment "Précipitations solides impactant la mobilité et les structures."@fr .

# =================================================================
# 3. IMPACT DE L'ALÉA
# =================================================================

fe:ImpactSeverityLevel a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( fe:Severity_Low fe:Severity_Moderate fe:Severity_Heavy fe:Severity_Extreme ) .

fe:Severity_Low a fe:ImpactSeverityLevel ;
    rdfs:label "Faible"@fr ;
    rdfs:comment "Dommages superficiels, esthétiques, n'affectant pas l'usage."@fr .

fe:Severity_Moderate a fe:ImpactSeverityLevel ;
    rdfs:label "Modéré"@fr ;
    rdfs:comment "Dommages modérés, impactant l'usage."@fr .

fe:Severity_Heavy a fe:ImpactSeverityLevel ;
    rdfs:label "Lourd"@fr ;
    rdfs:comment "Dommages structurels importants, mise en péril, arrêt de l'activité."@fr .

fe:Severity_Extreme a fe:ImpactSeverityLevel ;
    rdfs:label "Extrême"@fr ;
    rdfs:comment "Dommages irréversibles, perte totale, menace pour la sécurité des personnes."@fr .