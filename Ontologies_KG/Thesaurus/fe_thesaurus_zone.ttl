@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fe: <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =================================================================
# 1. DÉFINITION DU SCHÉMA (CONCEPT SCHEME)
# =================================================================

fe:ZoneTaxonomy a skos:ConceptScheme ;
    rdfs:label "Taxonomie des caractéristiques de Zone"@fr ;
    skos:prefLabel "Taxonomie des caractéristiques de Zone"@fr ;
    skos:hasTopConcept fe:TransitType, fe:ZoneUsageType, fe:CommunicationType .

# =================================================================
# 2. RÉGIME DE TRANSIT (TransitType)
# =================================================================

fe:TransitType a skos:Concept ;
    skos:prefLabel "Régime de Transit"@fr ;
    skos:inScheme fe:ZoneTaxonomy ;
    skos:topConceptOf fe:ZoneTaxonomy ;
    skos:narrower fe:Transit_Static, fe:Transit_Flow, fe:Transit_Hybrid .

fe:Transit_Static a skos:Concept, fe:TransitType ;
    skos:prefLabel "Statique"@fr ;
    skos:definition "Zone destinée à l'attente ou l'occupation (ex: salle de spectacle, bureau)."@fr ;
    skos:broader fe:TransitType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Transit_Flow a skos:Concept, fe:TransitType ;
    skos:prefLabel "Passage"@fr ;
    skos:definition "Zone de circulation pure (ex: couloir, escalier, tunnel)."@fr ;
    skos:broader fe:TransitType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Transit_Hybrid a skos:Concept, fe:TransitType ;
    skos:prefLabel "Hybride"@fr ;
    skos:definition "Zone mixte permettant l'attente et le passage (ex: hall de gare, place publique)."@fr ;
    skos:broader fe:TransitType ;
    skos:inScheme fe:ZoneTaxonomy .

# =================================================================
# 3. USAGE DE LA ZONE (ZoneUsageType)
# =================================================================

fe:ZoneUsageType a skos:Concept ;
    skos:prefLabel "Type d'Usage de Zone"@fr ;
    skos:inScheme fe:ZoneTaxonomy ;
    skos:topConceptOf fe:ZoneTaxonomy ;
    skos:narrower fe:Usage_Touristic, fe:Usage_Residential, fe:Usage_Mixed .

fe:Usage_Touristic a skos:Concept, fe:ZoneUsageType ;
    skos:prefLabel "Touristique"@fr ;
    skos:definition "Zone principalement fréquentée par des visiteurs ou touristes (ex: musée, site historique)."@fr ;
    skos:broader fe:ZoneUsageType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Usage_Residential a skos:Concept, fe:ZoneUsageType ;
    skos:prefLabel "Résidentielle"@fr ;
    skos:definition "Zone principalement fréquentée par des habitants ou résidents (ex: quartier d'habitation, immeuble)."@fr ;
    skos:broader fe:ZoneUsageType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Usage_Mixed a skos:Concept, fe:ZoneUsageType ;
    skos:prefLabel "Mixte"@fr ;
    skos:definition "Zone à usage mixte, fréquentée à la fois par des résidents et des visiteurs (ex: centre-ville, zone commerciale)."@fr ;
    skos:broader fe:ZoneUsageType ;
    skos:inScheme fe:ZoneTaxonomy .

# =================================================================
# 4. MOYENS DE COMMUNICATION (CommunicationType)
# =================================================================

fe:CommunicationType a skos:Concept ;
    skos:prefLabel "Type de Communication"@fr ;
    skos:inScheme fe:ZoneTaxonomy ;
    skos:topConceptOf fe:ZoneTaxonomy ;
    skos:narrower fe:Comm_Radio, fe:Comm_WiFi, fe:Comm_5G, fe:Comm_Signage .

fe:Comm_Radio a skos:Concept, fe:CommunicationType ;
    skos:prefLabel "Radio"@fr ;
    skos:definition "Communication par radio (ex: talkie-walkie, radio de secours)."@fr ;
    skos:broader fe:CommunicationType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Comm_WiFi a skos:Concept, fe:CommunicationType ;
    skos:prefLabel "Wi-Fi"@fr ;
    skos:definition "Communication par réseau Wi-Fi disponible dans la zone."@fr ;
    skos:broader fe:CommunicationType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Comm_5G a skos:Concept, fe:CommunicationType ;
    skos:prefLabel "5G"@fr ;
    skos:definition "Communication par réseau mobile 5G disponible dans la zone."@fr ;
    skos:broader fe:CommunicationType ;
    skos:inScheme fe:ZoneTaxonomy .

fe:Comm_Signage a skos:Concept, fe:CommunicationType ;
    skos:prefLabel "Signalétique"@fr ;
    skos:definition "Communication par signalétique visuelle ou sonore (ex: panneaux, annonces)."@fr ;
    skos:broader fe:CommunicationType ;
    skos:inScheme fe:ZoneTaxonomy .