@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# =================================================================
# 1. DÉFINITION DU SCHÉMA (LE RÉFÉRENTIEL)
# =================================================================

fe:ArchitectureThesaurus a skos:ConceptScheme ;
    rdfs:label "Thésaurus des Styles Architecturaux et Risques Incendie"@fr ;
    skos:hasTopConcept fe:StyleAntique, fe:StyleMedieval, fe:StyleRenaissance, 
                       fe:StyleClassique, fe:StyleIndustriel, fe:StyleVernaculaire, 
                       fe:StyleModerne .

# =================================================================
# 2. FAMILLE ANTIQUE
# =================================================================

fe:StyleAntique a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Antique"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus ;
    skos:narrower fe:StyleGalloRomain ;
    crm:P3_has_note "Risque transversal : Instabilité des maçonneries sèches."@fr .

    fe:StyleGalloRomain a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Gallo-Romain"@fr ;
        skos:broader fe:StyleAntique ;
        skos:inScheme fe:ArchitectureThesaurus ;
        owl:sameAs <http://dbpedia.org/resource/Gallo-Roman_culture> ;
        crm:P3_has_note "Structure : Opus caementicium. Risque : Chutes de pierres."@fr .

# =================================================================
# 3. FAMILLE MÉDIÉVALE
# =================================================================

fe:StyleMedieval a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Médiévale"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus ;
    skos:narrower fe:StyleRoman, fe:StyleGothique ;
    crm:P3_has_note "Risque transversal : Charpentes bois monumentales non compartimentées."@fr .

    fe:StyleRoman a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Roman"@fr ;
        skos:broader fe:StyleMedieval ;
        skos:inScheme fe:ArchitectureThesaurus ;
        owl:sameAs <http://dbpedia.org/resource/Romanesque_architecture> ;
        crm:P3_has_note "Risque : Désenfumage naturel très lent."@fr .

    fe:StyleGothique a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Gothique"@fr ;
        skos:broader fe:StyleMedieval ;
        skos:inScheme fe:ArchitectureThesaurus ;
        skos:narrower fe:GothiqueRayonnant, fe:GothiqueFlamboyant ;
        owl:sameAs <http://dbpedia.org/resource/Gothic_architecture> .

        fe:GothiqueRayonnant a skos:Concept, fe:ArchitectureStyle ;
            skos:prefLabel "Gothique Rayonnant"@fr ;
            skos:broader fe:StyleGothique ;
            skos:inScheme fe:ArchitectureThesaurus ;
            crm:P3_has_note "Risque : Rupture de l'équilibre des pressions (vitraux)."@fr .

        fe:GothiqueFlamboyant a skos:Concept, fe:ArchitectureStyle ;
            skos:prefLabel "Gothique Flamboyant"@fr ;
            skos:broader fe:StyleGothique ;
            skos:inScheme fe:ArchitectureThesaurus ;
            crm:P3_has_note "Risque : Éclatement des ornementations fines."@fr .

# =================================================================
# 4. RENAISSANCE, CLASSIQUE & VERNACULAIRE (Roots)
# =================================================================

fe:StyleRenaissance a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Renaissance"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus .

fe:StyleClassique a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Classique"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus .

fe:StyleVernaculaire a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Vernaculaire"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus ;
    crm:P3_has_note "Risque : Matériaux locaux (paille, pisé) à forte combustibilité."@fr .

# =================================================================
# 5. FAMILLE INDUSTRIELLE & XIXe
# =================================================================

fe:StyleIndustriel a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Industrielle & XIXe"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus ;
    skos:narrower fe:Haussmannien, fe:ArchitectureMetallique ;
    crm:P3_has_note "Risque transversal : Fer et fonte sans protection thermique."@fr .

    fe:Haussmannien a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Haussmannien"@fr ;
        skos:broader fe:StyleIndustriel ;
        skos:inScheme fe:ArchitectureThesaurus ;
        crm:P3_has_note "Risque : Propagation par combles filants et conduits de cheminées."@fr .

    fe:ArchitectureMetallique a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Métallique XIXe (Eiffel)"@fr ;
        skos:broader fe:StyleIndustriel ;
        skos:inScheme fe:ArchitectureThesaurus ;
        crm:P3_has_note "Risque : Ruine structurelle brutale à 450°C."@fr .

# =================================================================
# 6. FAMILLE XXe & MODERNE
# =================================================================

fe:StyleModerne a skos:Concept, fe:ArchitectureStyle ;
    skos:prefLabel "Architecture Moderne & XXe"@fr ;
    skos:inScheme fe:ArchitectureThesaurus ;
    skos:topConceptOf fe:ArchitectureThesaurus ;
    skos:narrower fe:ArtNouveau, fe:Brutalisme ;
    crm:P3_has_note "Risque transversal : Matériaux créant des fumées toxiques."@fr .

    fe:ArtNouveau a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Art Nouveau"@fr ;
        skos:broader fe:StyleModerne ;
        skos:inScheme fe:ArchitectureThesaurus .

    fe:Brutalisme a skos:Concept, fe:ArchitectureStyle ;
        skos:prefLabel "Brutalisme"@fr ;
        skos:broader fe:StyleModerne ;
        skos:inScheme fe:ArchitectureThesaurus ;
        crm:P3_has_note "Risque : Confinement des fumées et labyrinthe spatial."@fr .