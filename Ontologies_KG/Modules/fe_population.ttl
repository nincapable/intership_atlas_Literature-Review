@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =================================================================
# 1. STRUCTURE GLOBALE DE LA POPULATION
# =================================================================

fe:Population a owl:Class ; 
    rdfs:subClassOf crm:E74_Group ;
    rdfs:label "Population"@fr .

# --- Système de Partitions (Les tiroirs de données) ---

fe:PopulationPartition a owl:Class ; 
    rdfs:label "Partition de Population"@fr .

fe:MobilityPart rdfs:subClassOf fe:PopulationPartition ; rdfs:label "Partition Mobilité"@fr .
fe:GroupPart    rdfs:subClassOf fe:PopulationPartition ; rdfs:label "Partition Groupe"@fr .
fe:TypePart     rdfs:subClassOf fe:PopulationPartition ; rdfs:label "Partition Statutaire"@fr .

fe:hasMobilityPart a owl:ObjectProperty ; rdfs:domain fe:Population ; rdfs:range fe:MobilityPart .
fe:hasGroupPart    a owl:ObjectProperty ; rdfs:domain fe:Population ; rdfs:range fe:GroupPart .
fe:hasTypePart     a owl:ObjectProperty ; rdfs:domain fe:Population ; rdfs:range fe:TypePart .

fe:proportionValue a owl:DatatypeProperty ;
    rdfs:label "valeur de proportion"@fr ;
    rdfs:comment "Valeur entre 0 et 1 ou pourcentage."@fr ;
    rdfs:domain fe:PopulationPartition ;
    rdfs:range xsd:float .

# =================================================================
# 2. CLASSES DE RÉFÉRENTIELS (Points d'ancrage SKOS)
# =================================================================

fe:MobilityClass a owl:Class ; rdfs:subClassOf crm:E55_Type .
fe:VictimGroup a owl:Class ; rdfs:subClassOf crm:E55_Type .
fe:PopType a owl:Class ; rdfs:subClassOf crm:E55_Type .
fe:RiskPerceptionLevel a owl:Class ; rdfs:subClassOf crm:E55_Type .
fe:AwarenessLevel a owl:Class ; rdfs:subClassOf crm:E55_Type .
fe:TrainingLevel a owl:Class ; rdfs:subClassOf crm:E55_Type .
fe:EducationLevel a owl:Class ; rdfs:subClassOf crm:E55_Type .

# =================================================================
# 3. PROPRIÉTÉS DE LIAISON
# =================================================================

# Liaisons au sein des partitions
fe:hasPartitionMobilityType a owl:ObjectProperty ;
    rdfs:domain fe:MobilityPart ;
    rdfs:range fe:MobilityClass .

fe:hasPartitionGroup a owl:ObjectProperty ;
    rdfs:domain fe:GroupPart ;
    rdfs:range fe:VictimGroup .

fe:hasPartitionType a owl:ObjectProperty ;
    rdfs:domain fe:TypePart ;
    rdfs:range fe:PopType .

fe:hasVelocity a owl:ObjectProperty ;
    rdfs:label "vélocité moyenne"@fr ;
    rdfs:domain fe:MobilityPart ;
    rdfs:range crm:E54_Dimension .

# Facteurs Humains (Qualitatifs)
fe:hasRiskPerception a owl:ObjectProperty ;
    rdfs:domain fe:Population ;
    rdfs:range fe:RiskPerceptionLevel .

fe:hasAwareness a owl:ObjectProperty ;
    rdfs:domain fe:Population ;
    rdfs:range fe:AwarenessLevel .

fe:hasTraining a owl:ObjectProperty ;
    rdfs:domain fe:Population ;
    rdfs:range fe:TrainingLevel .

fe:hasEducationLevel a owl:ObjectProperty ;
    rdfs:domain fe:Population ;
    rdfs:range fe:EducationLevel .