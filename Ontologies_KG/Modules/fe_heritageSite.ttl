@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/site> a owl:Ontology .

# =================================================================
# 1. CLASSE PRINCIPALE ET RELATIONS STRUCTURELLES
# =================================================================

fe:HeritageSite a owl:Class ;
    rdfs:subClassOf crm:E27_Site ;
    rdfs:label "Site Patrimonial"@fr ;
    rdfs:comment "Entité globale regroupant les aspects spatiaux, humains et de sécurité."@fr .

fe:hasZone a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:Zone .

fe:hasPopulation a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:Population .

# =================================================================
# 2. ENVIRONNEMENT (Météo et Topographie)
# =================================================================

fe:hasWeatherCondition a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:WeatherCondition .

fe:hasClimate a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:Climate .

# =================================================================
# 3. SÉCURITÉ ET PROTECTION (Liaisons SKOS)
# =================================================================

fe:ProtectionLevel a owl:Class ;
    rdfs:subClassOf fe:OperationnalType ;
    rdfs:label "Niveau de Protection du Site"@fr .

fe:hasProtectionStatus a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:ProtectionLevel .

fe:hasHazard a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:HazardType .

# Documentation de sécurité
fe:hasEvacuationPlan a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range crm:E29_Design_or_Procedure .

fe:hasCulturalAssetPlan a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range crm:E29_Design_or_Procedure .

# Fréquentation
fe:hasAttendancePeak a owl:ObjectProperty ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range crm:E54_Dimension .