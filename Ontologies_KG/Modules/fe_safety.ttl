@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/safety> a owl:Ontology .

# =================================================================
# 1. RÉACTION AU FEU (Matériaux)
# =================================================================

fe:ReactionToFire a owl:Class ;
    rdfs:subClassOf fe:TechnicalDimension ;
    rdfs:label "Propriétés de Réaction au Feu"@fr .

fe:fireSafetyType a owl:Class ; rdfs:subClassOf crm:E55_Type .

fe:RiskExposureType a owl:Class ; rdfs:subClassOf crm:E55_Type .

# Classes de référentiels (Peuplées par SKOS)
fe:ReactionToFireClass a owl:Class ; rdfs:subClassOf fe:fireSafetyType .
fe:SmokeProductionClass a owl:Class ; rdfs:subClassOf fe:fireSafetyType .
fe:FlamingDropletsClass a owl:Class ; rdfs:subClassOf fe:fireSafetyType .

fe:hasReactionClass a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:ReactionToFire ;
    rdfs:range fe:ReactionToFireClass .

fe:hasSmokeClass a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:ReactionToFire ;
    rdfs:range fe:SmokeProductionClass .

fe:hasDropletClass a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:ReactionToFire ;
    rdfs:range fe:FlamingDropletsClass .

# Liaison à l'objet
fe:hasReaction a owl:ObjectProperty ;
    rdfs:domain fe:MaterialInstance ;
    rdfs:range fe:ReactionToFire .

# =================================================================
# 2. RÉSISTANCE AU FEU (Éléments de Structure)
# =================================================================

fe:FireResistanceRating a owl:Class ;
    rdfs:label "Degré de Résistance au Feu"@fr .

fe:FireResistanceComponent a owl:Class ; rdfs:subClassOf fe:fireSafetyType .

fe:resistanceComponents a owl:ObjectProperty ;
    rdfs:domain fe:FireResistanceRating ;
    rdfs:range fe:FireResistanceComponent .

fe:resistanceDuration a owl:DatatypeProperty ;
    rdfs:label "durée de résistance (min)"@fr ;
    rdfs:domain fe:FireResistanceRating ;
    rdfs:range xsd:integer .

# Liaison aux éléments (Bâtiment ou Axe/Voie)
fe:hasResistance a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (fe:Building fe:Axis) ] ;
    rdfs:range fe:FireResistanceRating .

# =================================================================
# 3. EXPOSITION ET PROPAGATION (Analyse de Risque)
# =================================================================

fe:FireExposureBuildingClassification a owl:Class ;
    rdfs:subClassOf fe:RiskExposureType ;
    rdfs:label "Exposition aux Risques Incendie (Bâti)"@fr .

fe:FireExposureNaturalClassification a owl:Class ;
    rdfs:subClassOf fe:RiskExposureType ;
    rdfs:label "Exposition au Risque Incendie (Espaces Naturels)"@fr .

fe:CombustibilityType a owl:Class ; rdfs:subClassOf fe:fireSafetyType .
fe:PropagationType a owl:Class ; rdfs:subClassOf fe:fireSafetyType .

fe:hasCombustibilityType a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (fe:FireExposureBuildingClassification fe:FireExposureNaturalClassification) ] ;
    rdfs:range fe:CombustibilityType .

fe:hasPropagationType a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (fe:FireExposureBuildingClassification fe:FireExposureNaturalClassification) ] ;
    rdfs:range fe:PropagationType .

fe:hasFireExposure a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P44_has_condition ;
    rdfs:range [ owl:unionOf (fe:FireExposureBuildingClassification fe:FireExposureNaturalClassification) ] .