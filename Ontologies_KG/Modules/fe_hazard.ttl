@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# --- La Classe Aléa ---
fe:HazardEvent a owl:Class ;
    rdfs:label "Aléa / Événement de Risque"@fr ;
    rdfs:subClassOf crm:E5_Event .

# --- Propriétés Spécifiques ---

# Date de Début / Fin / Durée (Natif CIDOC CRM : P4 has time-span)
####### Nativement accessible, sans perte d'information ########
# fe:hasDuration a owl:DatatypeProperty ;
#     rdfs:label "durée de l'aléa"@fr ;
#     rdfs:domain fe:HazardEvent ;
#     rdfs:range xsd:duration .

fe:hasHazardType a owl:ObjectProperty ;
    rdfs:label "type d'aléa"@fr ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:HazardType . # (Incendie, Inondation, Mouvement de foule, etc.)

fe:HazardType a owl:Class ;
    owl:oneOf ( fe:Fire_Hazard fe:Flood_Hazard fe:Seismic_Hazard fe:Geological_Hazard fe:Meteorological_Hazard ) ;
    rdfs:label "Type de risque"@fr .

# 1. La Classification Statique (Le "Quick Look")
# On réutilise E55_Type pour que ce soit une liste fermée (ex: Faible, Forte, Hors-Norme)
fe:hasIntensityLevel a owl:ObjectProperty ;
    rdfs:label "niveau d'intensité"@fr ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:IntensityLevel . # Ton énumération d'instances

fe:hasIntensityDocumentation a owl:ObjectProperty ;
    rdfs:label "est documenté par"@fr ;
    rdfs:subPropertyOf crm:P70_documents ;
    owl:inverseOf crm:P70_documents ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range crm:E31_Document .
#------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------

fe:hasMeteorologicalObservation a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:WeatherMeasurement .

fe:hasImpact a owl:ObjectProperty ;
    rdfs:label "a pour impact"@fr ;
    rdfs:subPropertyOf crm:P9_consists_of ;
    rdfs:domain fe:HazardEvent ;
    rdfs:range fe:ImpactAssessment .