@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/behavior_and_cognition> a owl:Ontology ;
    owl:imports <http://example.org/fire_and_evacuation/population> .

# =================================================================
# 1. PHÉNOMÈNES COGNITIFS ET COMPORTEMENTAUX
# =================================================================

fe:CognitiveBias a owl:Class ;
    rdfs:subClassOf fe:HumanFactorType ;
    rdfs:label "Biais Cognitif"@fr ;
    rdfs:comment "Filtre psychologique altérant la perception de la réalité ou l'évaluation du risque."@fr .

fe:HumanBehavior a owl:Class ;
    rdfs:subClassOf fe:HumanFactorType ;
    rdfs:label "Comportement Humain"@fr ;
    rdfs:comment "Action observable ou état opérationnel adopté par la population (ex: Fuite, Sidération, Recherche)."@fr .

fe:SocialInteractionType a owl:Class ;
    rdfs:subClassOf fe:HumanFactorType ;
    rdfs:label "Type d'Interaction Sociale"@fr ;
    rdfs:comment "Nature de la dynamique inter-archétypes (ex: Contagion de panique, Guidage directif, Assistance)."@fr .

# =================================================================
# 2. ARCHÉTYPES HUMAINS (Profils Comportementaux Typés)
# =================================================================

fe:HumanArchetype a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:label "Archétype Humain"@fr ;
    rdfs:comment "Profil psychologique et opérationnel type dictant les règles de comportement en cas d'urgence."@fr .

# Lien entre tes statistiques de population et les archétypes réels
fe:representsArchetype a owl:ObjectProperty ;
    rdfs:label "représente l'archétype"@fr ;
    rdfs:domain fe:TypePart ; # Lie une partition statistique à un comportement
    rdfs:range fe:HumanArchetype .

fe:ArchetypeBiasSensitivity a owl:Class ;
    rdfs:label "Sensibilité aux Biais de l'Archétype"@fr ;
    rdfs:comment "Définit la probabilité qu'un archétype soit sujet à un biais cognitif spécifique."@fr .

fe:hasBiasSensitivity a owl:ObjectProperty ;
    rdfs:domain fe:HumanArchetype ;
    rdfs:range fe:ArchetypeBiasSensitivity .

fe:targetBias a owl:ObjectProperty ;
    rdfs:domain fe:ArchetypeBiasSensitivity ;
    rdfs:range fe:CognitiveBias .

fe:biasProbability a owl:DatatypeProperty ;
    rdfs:domain fe:ArchetypeBiasSensitivity ;
    rdfs:range xsd:float .

# --- Capacité d'activation des Comportements par l'Archétype ---

fe:BehaviorActivationRule a owl:Class ;
    rdfs:label "Règle d'Activation Comportementale"@fr ;
    rdfs:comment "Définit le seuil de stress nécessaire pour qu'un archétype bascule dans un comportement."@fr .

fe:hasActivationRule a owl:ObjectProperty ;
    rdfs:domain fe:HumanArchetype ;
    rdfs:range fe:BehaviorActivationRule .

fe:targetBehavior a owl:ObjectProperty ;
    rdfs:domain fe:BehaviorActivationRule ;
    rdfs:range fe:HumanBehavior .

fe:stressThreshold a owl:DatatypeProperty ;
    rdfs:label "seuil d'activation"@fr ;
    rdfs:comment "Niveau de stress cumulé (0.0 à 1.0) déclenchant le comportement pour cet archétype."@fr ;
    rdfs:domain fe:BehaviorActivationRule ;
    rdfs:range xsd:float .

# =================================================================
# 3. SYSTÈME D'INTERFÉRENCE RELATIONNEL UNIQUE (CORRIGÉ)
# =================================================================

fe:InterferenceRelation a owl:Class ;
    rdfs:label "Relation d'Interférence"@fr ;
    rdfs:comment "La boîte unique qui contient le fait que l'Acteur modifie la probabilité d'un Comportement chez la Cible."@fr .

# --- Propriétés de base de la boîte d'association ---

fe:hasAsActeur a owl:ObjectProperty ;
    rdfs:label "a pour acteur (émetteur)"@fr ;
    rdfs:domain fe:InterferenceRelation ;
    rdfs:range fe:HumanArchetype .

fe:hasAsCible a owl:ObjectProperty ;
    rdfs:label "a pour cible (récepteur)"@fr ;
    rdfs:domain fe:InterferenceRelation ;
    rdfs:range fe:HumanArchetype .

fe:targetBehavior a owl:ObjectProperty ;
    rdfs:label "comportement concerné"@fr ;
    rdfs:domain fe:InterferenceRelation ;
    rdfs:range fe:HumanBehavior .

fe:probabilityModifier a owl:DatatypeProperty ;
    rdfs:label "modificateur de probabilité"@fr ;
    rdfs:domain fe:InterferenceRelation ;
    rdfs:range xsd:float .

# --- Propriétés d'accès direct depuis les Archétypes (Inverses structurels) ---

fe:subitInterference a owl:ObjectProperty ;
    rdfs:label "subit l'interférence"@fr ;
    rdfs:domain fe:HumanArchetype ;
    rdfs:range fe:InterferenceRelation .

# Ici, on crée une propriété inverse propre pour l'acteur sans conflit de Domaine/Range
fe:estActeurDelInterférence a owl:ObjectProperty ;
    rdfs:label "est acteur de l'interférence"@fr ;
    rdfs:domain fe:HumanArchetype ;
    rdfs:range fe:InterferenceRelation .