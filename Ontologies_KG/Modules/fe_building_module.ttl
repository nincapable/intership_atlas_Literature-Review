@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/building> a owl:Ontology .
# =================================================================
# 1. CLASSES GÉNÉRIQUES (Structure)
# =================================================================

fe:Building a owl:Class ; 
    rdfs:label "Bâtiment"@fr ;
    rdfs:subClassOf crm:E25_Man_Made_Feature .

fe:MaterialInstance a owl:Class ; 
    rdfs:label "Classe des Matériaux"@fr ;
    rdfs:subClassOf crm:E57_Material .

fe:ArchitectureStyle a owl:Class ; 
    rdfs:label "Classe des Styles Architecturaux"@fr ;
    rdfs:subClassOf fe:OperationnalType .

fe:TechnicalDimension a owl:Class ;
    rdfs:label "Dimension Technique"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

# =================================================================
# 2. COMPOSITION ET STYLE (Liaisons vers Thésaurus)
# =================================================================

fe:MaterialComposition a owl:Class ;
    rdfs:subClassOf fe:TechnicalDimension .

fe:hasMaterialComposition a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:Building ;
    rdfs:range fe:MaterialComposition .

fe:refersToMaterial a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P45_consists_of ;
    rdfs:domain fe:MaterialComposition ;
    rdfs:range fe:MaterialInstance . # Liaison vers SKOS Matériaux

fe:materialPercentage a owl:DatatypeProperty ;
    rdfs:domain fe:MaterialComposition ;
    rdfs:range xsd:decimal .

fe:hasArchitectureStyle a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Building ; 
    rdfs:range fe:ArchitectureStyle . # Liaison vers SKOS Styles
    
fe:structuralFragilityCoefficient a owl:DatatypeProperty ; rdfs:domain fe:ArchitectureStyle ; rdfs:range xsd:decimal .

# =================================================================
# 3. EXPOSITION AU RISQUE (Liaisons vers la classe d'exposition)
# =================================================================
# Sous-classe de fiche dédiée au Bâti + Incendie
fe:BuildingFireExposure a owl:Class ;
    rdfs:subClassOf fe:hazardExposure ;
    rdfs:label "Fiche d'Exposition Incendie pour Bâtiment"@fr .

# Les propriétés spécifiques au bâti ont pour domaine UNIQUEMENT cette fiche
fe:buildingCombustibility a owl:DatatypeProperty ; rdfs:domain fe:BuildingFireExposure ; rdfs:range xsd:decimal .
fe:buildingInflammability a owl:DatatypeProperty ; rdfs:domain fe:BuildingFireExposure ; rdfs:range xsd:decimal .
fe:thermalInertiaScore a owl:DatatypeProperty ; rdfs:domain fe:BuildingFireExposure ; rdfs:range xsd:decimal .
fe:structuralFragility a owl:DatatypeProperty ; rdfs:domain fe:BuildingFireExposure ; rdfs:range xsd:decimal .
fe:smokePropensity a owl:DatatypeProperty ; rdfs:domain fe:BuildingFireExposure ; rdfs:range xsd:decimal .
fe:fireExpansionFactor a owl:DatatypeProperty ; rdfs:domain fe:BuildingFireExposure ; rdfs:range xsd:decimal .

# Sous-classe de fiche dédiée au Bâti + Inondation
fe:BuildingFloodExposure a owl:Class ;
    rdfs:subClassOf fe:hazardExposure ;
    rdfs:label "Fiche d'Exposition Inondation pour Bâtiment"@fr .

# --- Propriétés spécifiques de Données (Datatypes pour le Simulateur) ---

fe:waterSubmersionResistance a owl:DatatypeProperty ;
    rdfs:label "Résistance à la submersion (m)"@fr ;
    rdfs:comment "Hauteur d'eau maximale tolérée par la structure avant dégâts majeurs."@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:decimal .

fe:hydrostaticPressureLoad a owl:DatatypeProperty ;
    rdfs:label "Charge de pression hydrostatique maximale"@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:decimal .

fe:criticalEquipmentFloor a owl:DatatypeProperty ;
    rdfs:label "Étage des équipements critiques"@fr ;
    rdfs:comment "Niveau où se trouvent les serveurs ou tableaux électriques (ex: 0 pour RDC, -1 pour sous-sol)."@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:integer .

fe:dryingTimeHours a owl:DatatypeProperty ;
    rdfs:label "Temps de séchage structurel (heures)"@fr ;
    rdfs:domain fe:BuildingFloodExposure ;
    rdfs:range xsd:integer .

# =================================================================
# 4. DOCUMENTATION ET SERVICES
# =================================================================

fe:hasEmergencyEvacuationDocument a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:domain fe:Building ; rdfs:range crm:E31_Document .

fe:hasEmergencyInterventionDocument a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:domain fe:Building ; rdfs:range crm:E31_Document .