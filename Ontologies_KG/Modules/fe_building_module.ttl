@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# =================================================================
# 1. CLASSES PRINCIPALES
# =================================================================

fe:Building a owl:Class ; 
    rdfs:label "Bâtiment"@fr ;
    rdfs:subClassOf crm:E25_Man_Made_Feature ;
    rdfs:comment "Structure architecturale fixe (monument, dépendance, abri)."@fr .

fe:MaterialInstance a owl:Class ; 
    rdfs:label "Instance de Matériau"@fr ;
    rdfs:subClassOf crm:E57_Material ;
    rdfs:comment "Type de matière physique composant le bâti (Pierre, Bois, Béton, Verre)."@fr .

fe:ArchitectureStyle a owl:Class ; 
    rdfs:label "Style Architectural"@fr ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:comment "Définit la morphologie et les méthodes constructives (Gothique, Classique, Moderne)."@fr .

