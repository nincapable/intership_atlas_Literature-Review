@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/fire_and_evacuation/artos> a owl:Ontology .

# =================================================================
# 1. CLASSE PRINCIPALE
# =================================================================

fe:Artefact a owl:Class ; 
    rdfs:label "Artefact Patrimonial"@fr ;
    rdfs:subClassOf crm:E22_Man_Made_Object ;
    rdfs:comment "Objet physique d'intérêt patrimonial nécessitant une protection ou une évacuation."@fr .

fe:ArtefectType a owl:Class ;
    rdfs:label "Type d'Artefact"@fr ;
    rdfs:subClassOf crm:E55_Type .

# =================================================================
# 2. PROPRIÉTÉS DE CLASSIFICATION (LIAISON THÉSAURUS)
# =================================================================

# Utilisation du formalisme uniforme : Propriété -> Range vers une Classe ouverte

# Classification par Type (ex: Poterie, Peinture)
fe:hasArtefactType a owl:ObjectProperty ;
    rdfs:label "a pour type d'objet"@fr ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Artefact ;
    rdfs:range fe:Artos_Type .

# Classification par Sous-Type (ex: Vaisselle, Icône)
fe:hasArtefactSubType a owl:ObjectProperty ;
    rdfs:label "a pour sous-type d'objet"@fr ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Artefact ;
    rdfs:range fe:Artos_SubType .

# Mobilité (ex: Fixe, Mobile, Semi-mobile)
fe:hasMobilityType a owl:ObjectProperty ;
    rdfs:label "mobilité"@fr ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Artefact ;
    rdfs:range fe:MobilityType .

# Fragilité (ex: Thermosensible, Sensible humidité)
fe:hasFragilityType a owl:ObjectProperty ;
    rdfs:label "fragilité"@fr ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Artefact ;
    rdfs:range fe:FragilityType .

# =================================================================
# 3. DÉFINITION DES CLASSES DE RÉFÉRENTIEL (SANS ENUMÉRATION)
# =================================================================

fe:Artos_Type a owl:Class ;
    rdfs:label "Type d'Artefact"@fr ;
    rdfs:subClassOf fe:ArtefectType .

fe:Artos_SubType a owl:Class ;
    rdfs:label "Sous-Type d'Artefact"@fr ;
    rdfs:subClassOf fe:ArtefectType .

fe:MobilityType a owl:Class ;
    rdfs:label "Type de Mobilité"@fr ;
    rdfs:subClassOf fe:ArtefectType .

fe:FragilityType a owl:Class ;
    rdfs:label "Type de Fragilité"@fr ;
    rdfs:subClassOf fe:ArtefectType .

# =================================================================
# 4. DOCUMENTATION ET PROCÉDURES
# =================================================================

fe:hasEmergencyProcedureDocument a owl:ObjectProperty ;
    rdfs:label "a une procédure d'urgence"@fr ;
    rdfs:comment "Lien vers le document (E31) de sauvegarde (PSBC) spécifique à l'objet."@fr ;
    rdfs:domain fe:Artefact ; 
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in .

# =================================================================
# 5. ALIGNEMENTS CRM (RAPPEL DES CHEMINS)
# =================================================================

# Date de Création : fe:Artefact -> P108i_was_produced_by -> E12_Production -> P4_has_time-span -> E52_Time-Span
# Dimensions (Poids/Taille) : fe:Artefact -> P43_has_dimension -> E54_Dimension 
# Localisation actuelle : fe:Artefact -> P55_has_current_location -> E53_Place