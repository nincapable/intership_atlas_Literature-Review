#    L'activité (crm:E7_Activity) pointe vers l'espace naturel (E27).
#    Cela permet de dater l'activité (P4) et d'en définir le type (P2).

# =================================================================
# 2. LES ESPÈCES PROTÉGÉES (Biodiversité)
# =================================================================

fe:Taxon a owl:Class ;
    rdfs:label "Taxon"@fr ;
    rdfs:comment "Classification taxonomique des espèces vivantes."@fr ;
    rdfs:subClassOf fe:E55_Type .

fe:hostsTaxon a owl:ObjectProperty ;
    rdfs:label "héberge le taxon"@fr ;
    rdfs:comment "Lien entre un espace naturel et une espèce présente."@fr ;
    rdfs:subPropertyOf crm:P2_has_type ; 
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:Taxon .

# La classe des statuts UICN
fe:IUCNCategory a owl:Class ;
    rdfs:label "Catégorie de la Liste Rouge UICN"@fr ;
    rdfs:subClassOf crm:E55_Type .

# La propriété de liaison
fe:hasConservationStatus a owl:ObjectProperty ;
    rdfs:label "a un statut de conservation"@fr ;
    rdfs:domain fe:Taxon ;
    rdfs:range fe:IUCNCategory ;
    rdfs:subPropertyOf crm:P2_has_type .

fe:hasConservationMeasures a owl:objectProperty;
    rdfs:label "a des mesures de conservation (document)"@fr ;
    rdfs:domain fe:taxon ; 
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:comment "Lien vers la documentation de sensibilité aux contre-mesures feu"@fr .

# =================================================================
# 3. EXPOSITION AU RISQUE (Analyse Incendie/Naturel)
# =================================================================
fe:hasNaturalExposure rdfs:subPropertyOf fe:hasFireExposure ;
    rdfs:domain fe:NaturalSpace .

