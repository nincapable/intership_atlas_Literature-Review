@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/natural_space> a owl:Ontology .

# =================================================================
# 1. STRUCTURE DE L'ESPACE NATUREL ET LE PIVOT DU VIVANT (BIOTYPES)
# =================================================================

fe:NaturalSpace a owl:Class ;
    rdfs:subClassOf crm:E27_Site ;
    rdfs:label "Espace Naturel"@fr .

# --- L'Ancêtre Sémantique Racine du Vivant ---
fe:Biotype a owl:Class ;
    rdfs:label "Biotype / Concept Racine du Vivant"@fr ;
    rdfs:comment "Ancêtre sémantique de toutes les classifications et caractéristiques qualitatives du vivant, sous-classe de crm:E55_Type."@fr ;
    rdfs:subClassOf crm:E55_Type .
fe:BioTaxonomyType a owl:Class ; rdfs:subClassOf fe:Biotype ; rdfs:label "Type de Taxonomie Biologique"@fr .

fe:BioFireType a owl:Class ;
    rdfs:label "Type de Biotype à Risque Incendie"@fr ;
    rdfs:subClassOf fe:Biotype .

fe:EnvironmentalType a owl:Class ;
    rdfs:label "Type Environnemental"@fr ;
    rdfs:subClassOf crm:E55_Type .

fe:EnvironmentalDimension a owl:Class ;
    rdfs:label "Dimension Environnementale"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

fe:NaturalType a owl:Class ; rdfs:subClassOf fe:EnvironmentalType .
fe:RepartitionType a owl:Class ; rdfs:subClassOf fe:EnvironmentalType .
fe:IUCNCategory a owl:Class ; rdfs:subClassOf fe:Biotype . # Devient un sous-type du vivant

# --- LA TAXONOMIE ASSAINIE (Chaque niveau hérite directement de fe:Biotype) ---
fe:Taxon a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType ; rdfs:label "Taxon (Espèce)"@fr .
fe:BioGenre a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType ; rdfs:label "Genre Biologique"@fr .
fe:BioFamily a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType ; rdfs:label "Famille Biologique"@fr .
fe:BioOrder a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType .
fe:BioClass a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType .
fe:BioSubDivision a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType .
fe:BioDivision a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType .
fe:BioReign a owl:Class ; rdfs:subClassOf fe:BioTaxonomyType .

# --- Liens d'Emboîtement de la Chaîne Taxonomique (Propriétés d'Objet) ---
fe:belongsToGenre a owl:ObjectProperty ; rdfs:domain fe:Taxon ; rdfs:range fe:BioGenre .
fe:belongsToFamily a owl:ObjectProperty ; rdfs:domain fe:BioGenre ; rdfs:range fe:BioFamily .
fe:belongsToOrder a owl:ObjectProperty ; rdfs:domain fe:BioFamily ; rdfs:range fe:BioOrder .
fe:belongsToClass a owl:ObjectProperty ; rdfs:domain fe:BioOrder ; rdfs:range fe:BioClass .
fe:belongsToSubDivision a owl:ObjectProperty ; rdfs:domain fe:BioClass ; rdfs:range fe:BioSubDivision .
fe:belongsToDivision a owl:ObjectProperty ; rdfs:domain fe:BioSubDivision ; rdfs:range fe:BioDivision .
fe:belongsToReign a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:BioReign .

# --- Propriétés de l'Espace ---
fe:hasNaturalType a owl:ObjectProperty ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:NaturalType .

# =================================================================
# 2. BIOMASSE ET TAXONS (Liaisons dynamiques pour la scène)
# =================================================================

fe:BiomassMeasurement a owl:Class ; rdfs:subClassOf crm:E16_Measurement .
fe:BiomassComponent a owl:Class ; rdfs:subClassOf fe:EnvironmentalDimension .

fe:hasBiomassState a owl:ObjectProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range fe:BiomassMeasurement .
fe:hasComponent a owl:ObjectProperty ; rdfs:domain fe:BiomassMeasurement ; rdfs:range fe:BiomassComponent .
fe:refersToTaxon a owl:ObjectProperty ; rdfs:domain fe:BiomassComponent ; rdfs:range fe:Taxon .
fe:hasRepartitionType a owl:ObjectProperty ; rdfs:domain fe:BiomassComponent ; rdfs:range fe:RepartitionType .

fe:totalValue a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .
fe:percentageShare a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .

# =================================================================
# 3. MAINTENANCE ET PRATIQUES DE GESTION
# =================================================================

fe:MaintenanceProtocol a owl:Class ; rdfs:subClassOf fe:EnvironmentalType .
fe:MaintenanceStyle a owl:Class ; rdfs:subClassOf fe:EnvironmentalType . 
fe:MaintenanceAction a owl:Class ; rdfs:subClassOf crm:E29_DesignOrProcedure .

# 1. La propriété racine : elle n'est plus bloquée sur fe:Taxon
fe:hasDefaultProtocol a owl:ObjectProperty ;
    rdfs:range fe:MaintenanceProtocol ;
    rdfs:label "a pour protocole par défaut"@fr .

# 2. La règle d'héritage du Genre vers le Taxon
fe:hasInheritedProtocolFromGenre a owl:ObjectProperty ;
    rdfs:subPropertyOf fe:hasDefaultProtocol ;
    rdfs:label "Protocole hérité du genre"@fr ;
    owl:propertyChainAxiom ( 
        fe:belongsToGenre 
        fe:hasDefaultProtocol 
    ) .

# 3. La règle d'héritage de la Famille vers le Taxon
fe:hasInheritedProtocolFromFamily a owl:ObjectProperty ;
    rdfs:subPropertyOf fe:hasDefaultProtocol ;
    rdfs:label "Protocole hérité de la famille"@fr ;
    owl:propertyChainAxiom ( 
        fe:belongsToGenre 
        fe:belongsToFamily 
        fe:hasDefaultProtocol 
    ) .

fe:hasMaintenanceAction a owl:ObjectProperty ; rdfs:domain fe:MaintenanceProtocol ; rdfs:range fe:MaintenanceAction .
fe:hasMaintenanceStyle a owl:ObjectProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range fe:MaintenanceStyle .
fe:definesProtocol a owl:ObjectProperty ; rdfs:domain fe:MaintenanceStyle ; rdfs:range fe:MaintenanceProtocol .

fe:isAdaptedToTrait a owl:ObjectProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range fe:BioTrait .
fe:isEffectiveForHazard a owl:ObjectProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range crm:E55_Type .

fe:styleIsMaintained a owl:DatatypeProperty ; rdfs:domain fe:MaintenanceStyle ; rdfs:range xsd:boolean .
fe:protocoleIsMaintained a owl:DatatypeProperty ; rdfs:domain fe:MaintenanceProtocol ; rdfs:range xsd:boolean .
fe:actionIsScheduled a owl:DatatypeProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range xsd:boolean .
fe:maintenanceEfficiencyOnTrait a owl:DatatypeProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range xsd:decimal .

fe:activeProtocolInSpace owl:propertyChainAxiom ( fe:hasMaintenanceStyle fe:definesProtocol ) .

# --- Protection ---
fe:SpeciesProtectionStatus a owl:Class ;
    rdfs:subClassOf crm:E54_Dimension ;
    rdfs:label "Statut de Protection de l'Espèce"@fr .

fe:hasProtectionStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:Taxon ; 
    rdfs:range fe:SpeciesProtectionStatus .

fe:protectionPriorityWeight a owl:DatatypeProperty ;
    rdfs:domain fe:SpeciesProtectionStatus ;
    rdfs:range xsd:decimal .

# =================================================================
# 4. BIOTRAITS ET GESTION DE L'HÉRITAGE (Intégrés sous fe:Biotype)
# =================================================================

# Le trait biologique est un type qualitatif du vivant, donc sous-classe de fe:Biotype
fe:BioTrait a owl:Class ; 
    rdfs:subClassOf fe:Biotype ;
    rdfs:label "Trait Biologique (Feature)"@fr .

# Propriété pour lier un trait à n'importe quel échelon taxonomique
fe:hasBioTrait a owl:ObjectProperty ; 
    rdfs:range fe:BioTrait .

fe:isExceptionTo a owl:ObjectProperty ; rdfs:domain fe:Taxon ; rdfs:range fe:BioTrait .

# --- Mécanique sémantique de l'héritage ---
fe:hasInheritedTraitFromGenre a owl:ObjectProperty ;
    rdfs:subPropertyOf fe:hasBioTrait ;
    owl:propertyChainAxiom ( fe:belongsToGenre fe:hasBioTrait ) .

fe:hasInheritedTraitFromFamily a owl:ObjectProperty ;
    rdfs:subPropertyOf fe:hasBioTrait ;
    owl:propertyChainAxiom ( fe:belongsToGenre fe:belongsToFamily fe:hasBioTrait ) .

# --- Profils de Vulnérabilité (Catégories qualitatives sous fe:Biotype) ---
fe:hazardSensitivity a owl:Class ; 
    rdfs:subClassOf crm:E54_Dimension ; 
    rdfs:label "Fiche de Sensibilité face au Risque"@fr .

fe:hazardFunctionalRole a owl:Class ; rdfs:subClassOf fe:Biotype .
fe:hazardResponseStrategy a owl:Class ; rdfs:subClassOf fe:Biotype .
fe:hazardReaction a owl:Class ; rdfs:subClassOf fe:Biotype .

fe:hasHazardSensitivity a owl:ObjectProperty ; rdfs:domain fe:Taxon ; rdfs:range fe:hazardSensitivity .
fe:hasHazardFunctionalRole a owl:ObjectProperty ; rdfs:domain fe:hazardSensitivity ; rdfs:range fe:hazardFunctionalRole .
fe:hasHazardResponseStrategy a owl:ObjectProperty ; rdfs:domain fe:hazardSensitivity ; rdfs:range fe:hazardResponseStrategy .
fe:hasHazardReaction a owl:ObjectProperty ; rdfs:domain fe:hazardSensitivity ; rdfs:range fe:hazardReaction .

# =================================================================
# 5. CONFIGURATION PHYSIQUE DES AGENTS (Métriques Incendie)
# =================================================================

fe:bioFireSensitivity a owl:Class ; 
    rdfs:subClassOf fe:hazardSensitivity ; 
    rdfs:label "Sensibilité Spécifique au Feu"@fr .

fe:FireResponseStrategy a owl:Class ; rdfs:subClassOf fe:hazardResponseStrategy .
fe:EmberType a owl:Class ; rdfs:subClassOf fe:hazardReaction .
fe:FireFunctionalRole a owl:Class ; rdfs:subClassOf fe:hazardFunctionalRole .

# --- Datatypes numériques pour la simulation ---
fe:organicHRPBasis a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .

fe:FlammabilityLevel a owl:Class ; rdfs:subClassOf fe:Biotype ; rdfs:label "Niveau d'Inflammabilité"@fr .
fe:ValetteScore a owl:DatatypeProperty ; rdfs:domain fe:FlammabilityLevel ; rdfs:range xsd:integer .
fe:hasFlammabilityLevel a owl:ObjectProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range fe:FlammabilityLevel .

fe:verticalTransferPotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:horizontalTransferPotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:fireResistanceDuration a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:heatReleasePotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:spontaneousIgnitionThreshold a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:ignitionDelay a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:fireReactivityFactor a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .

fe:mobilityScore a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:panicThreshold a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:evacuationPriority a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:isPotentialFireVector a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:calculatedGeneralFireRisk a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .

# =================================================================
# 6. FACETTE D'EXPOSITION DU HUB
# =================================================================

fe:NaturalSpaceFireExposure a owl:Class ; 
    rdfs:subClassOf fe:hazardExposure ; 
    rdfs:label "Fiche d'Exposition Incendie de l'Espace Naturel"@fr .

fe:globalIgnitionProbability a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpaceFireExposure ; rdfs:range xsd:decimal .
fe:firePropagationVelocity a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpaceFireExposure ; rdfs:range xsd:decimal .
fe:structuralFireBarrierEffect a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpaceFireExposure ; rdfs:range xsd:decimal .
fe:globalEvacuationUrgency a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpaceFireExposure ; rdfs:range xsd:decimal .