@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://example.org/fire_and_evacuation/natural_space> a owl:Ontology .

# =================================================================
# 1. STRUCTURE DE L'ESPACE NATUREL
# =================================================================

fe:NaturalSpace a owl:Class ;
    rdfs:subClassOf crm:E27_Site ;
    rdfs:label "Espace Naturel"@fr.

fe:Biotype a owl:Class;
    rdfs:label "Biotype"@fr ;
    rdfs:subClassOf crm:E55_Type .

fe:BioFireType a owl:Class ;
    rdfs:label "Type de Biotype à Risque Incendie"@fr ;
    rdfs:subClassOf fe:Biotype .

fe:EnvironmentalType a owl:Class;
    rdfs:label "Type Environnemental"@fr ;
    rdfs:subClassOf crm:E55_Type .

fe:EnvironmentalDimension a owl:Class ;
    rdfs:label "Dimension Environnementale"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

# --- Classes de Référentiel ---
fe:NaturalType a owl:Class ; rdfs:subClassOf fe:EnvironmentalType .

#Vive la Taxonomie
fe:Taxon a owl:Class ; rdfs:subClassOf fe:BioGenre .
fe:BioGenre a owl:Class ; rdfs:subClassOf fe:BioFamily .
fe:BioFamily a owl:Class ; rdfs:subClassOf fe:BioOrder .
fe:BioOrder a owl:Class ; rdfs:subClassOf fe:BioClass .
fe:BioClass a owl:Class ; rdfs:subClassOf fe:BioSubDivision .
fe:BioSubDivision a owl:Class ; rdfs:subClassOf fe:BioDivision .
fe:BioDivision a owl:Class ; rdfs:subClassOf fe:BioReign .
fe:BioReign a owl:Class ; rdfs:subClassOf fe:Biotype .

fe:IUCNCategory a owl:Class ; rdfs:subClassOf fe:Biotype .
fe:RepartitionType a owl:Class ; rdfs:subClassOf fe:EnvironmentalType .

# --- Propriétés ---
fe:hasNaturalType a owl:ObjectProperty ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:NaturalType .

fe:hasMaintenanceStyle a owl:ObjectProperty ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:MaintenanceStyle .

# =================================================================
# 2. BIOMASSE ET TAXONS
# =================================================================

fe:BiomassMeasurement a owl:Class ; rdfs:subClassOf crm:E16_Measurement .
fe:BiomassComponent a owl:Class ; rdfs:subClassOf fe:EnvironmentalDimension .

fe:hasBiomassState a owl:ObjectProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range fe:BiomassMeasurement .
fe:hasComponent a owl:ObjectProperty ; rdfs:domain fe:BiomassMeasurement ; rdfs:range fe:BiomassComponent .
fe:refersToTaxon a owl:ObjectProperty ; rdfs:domain fe:BiomassComponent ; rdfs:range fe:Taxon .
fe:hasRepartitionType a owl:ObjectProperty ; rdfs:domain fe:BiomassComponent ; rdfs:range fe:RepartitionType .

fe:totalValue a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .
fe:percentageShare a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .

# =================================================================
# 3. MAINTENANCE ET PRATIQUES DE GESTION
# =================================================================
fe:MaintenanceProtocol a owl:Class ; rdfs:subClassOf fe:EnvironmentalType .
fe:MaintenanceStyle a owl:Class ; rdfs:subClassOf fe:EnvironmentalType . # Exemple : Jardin Français, Jardin à l'Anglaise, etc. (est un protocol bien défini, avec des actions précises)
fe:MaintenanceAction a owl:Class ; rdfs:subClassOf crm:E7_Activity .

fe:recommendsMaintenanceForTaxon a owl:ObjectProperty ; rdfs:domain fe:Taxon ; rdfs:range fe:MaintenanceProtocol .

fe:hasMaintenanceAction a owl:ObjectProperty ; rdfs:domain fe:MaintenanceProtocol ; rdfs:range fe:MaintenanceAction .
fe:isAdaptedToTrait a owl:ObjectProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range fe:BioTrait .
fe:isEffectiveForCategory a owl:ObjectProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range fe:BiotraitCategory .

fe:protocoleIsMaintained a owl:ObjectProperty ; rdfs:domain fe:MaintenanceProtocol ; rdfs:range xsd:boolean . #If true, then actionIsScheduled should be true for all actions in the protocol.
fe:actionIsScheduled a owl:ObjectProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range xsd:boolean .
fe:maintenanceEfficiencyOnTrait a owl:DatatypeProperty ; rdfs:domain fe:MaintenanceAction ; rdfs:range xsd:decimal . # Valeur de 0.0 (aucune) à 1.0 (totale), pour le pouvoir de neutralisation du trait maintenu.

# =================================================================
# 3. BIOTRAITS GÉNÉRAUX
# =================================================================
fe:BioTrait a owl:Class ; rdfs:subClassOf fe:BioClass .
fe:BiotraitCategory a owl:Class ; rdfs:subClassOf fe:BioType .

fe:hasBioTrait a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:BioTrait .
fe:hasBiotraitCategory a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:BiotraitCategory .
fe:hasRecommendedMaintenance a owl:ObjectProperty ; rdfs:domain fe:BioTrait ; rdfs:range fe:MaintenanceProtocol .


# =================================================================
# 3. BASE VIVANT FACE AUX ALÉAS
# =================================================================

fe:organicHRPBasis a owl:DatatypeProperty; rdfs:domain fe:BioClass; rdfs:range xsd:decimal.

fe:BioTrait a owl:Class ; rdfs:subClassOf fe:BioClass .

fe:FireAiding a owl:Class ; rdfs:subClassOf fe:BioTrait .
fe:FireResisting a owl:Class ; rdfs:subClassOf fe:BioTrait .
fe:FireResponseStrategy a owl:Class ; rdfs:subClassOf fe:BioTrait .
fe:EmberType a owl:Class ; rdfs:subClassOf fe:BioTrait .
fe:FireFunctionalRole a owl:Class ; rdfs:subClassOf fe:BioTrait .

# --- Définition de la Dimension de Protection ---
fe:SpeciesProtectionStatus a owl:Class ;
    rdfs:subClassOf fe:TechnicalDimension ;
    rdfs:label "Statut de Protection de l'Espèce"@fr .

# --- Liaison entre la Sensibilité et son Statut ---
fe:hasProtectionStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain fe:bioFireSensitivity ;
    rdfs:range fe:SpeciesProtectionStatus .

# --- Valeur numérique mappée (Calculée) ---
fe:protectionPriorityWeight a owl:DatatypeProperty ;
    rdfs:domain fe:SpeciesProtectionStatus ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Valeur numérique dérivée du statut UICN pour le calcul du risque."@fr .

fe:bioFireSensitivity a owl:Class ; rdfs:subClassOf fe:EnvironmentalDimension .
fe:hasbioFireSensitivity a owl:ObjectProperty ; rdfs:domain fe:Taxon ; rdfs:range fe:bioFireSensitivity .

fe:hasFireAidingTrait a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:FireAidingTrait .
fe:hasFireResistingTrait a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:FireResistingTrait .
fe:hasFireResponseStrategy a owl:ObjectProperty ; rdfs:domain fe:BioDivision  ; rdfs:range fe:FireResponseStrategy .
fe:hasEmberType a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:EmberType .
fe:hasFireFunctionalRole a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:FireFunctionalRole .

fe:isExceptionTo a owl:ObjectProperty ; rdfs:domain fe:BioDivision ; rdfs:range fe:BioTrait ; rdfs:label "Exception à un trait hérité"@fr .

fe:ReactivityFactor a owl:DatatypeProperty ; rdfs:domain fe:BioDivision ; rdfs:range xsd:decimal . # Valeur de 0.0 (non réactif) à 1.0 (très réactif), pour le potentiel de contribution au feu.

# =================================================================
# 3. SENSIBILITÉ AU FEU (Traits Végétaux)
# =================================================================

fe:FlammabilityLevel a owl:Class ; rdfs:subClassOf fe:fireSafetyType ; rdfs:label "Niveau d'Inflammabilité"@fr ; rdfs:comment "Représente les différents paliers de l'échelle de Valette (de 0 à 5)."@fr .

fe:ValetteScore a owl:DatatypeProperty ; rdfs:domain fe:FlammabilityLevel ; rdfs:range xsd:integer ; rdfs:label "Score de Valette"@fr .

fe:hasFlammabilityLevel a owl:ObjectProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range fe:FlammabilityLevel ; rdfs:label "a pour niveau d'inflammabilité"@fr .

fe:verticalTransferPotential a owl:DatatypeProperty ;rdfs:domain [ owl:unionOf (fe:FireAidingTrait fe:FireResistingTrait ) ]; rdfs:range xsd:decimal .
fe:horizontalTransferPotential a owl:DatatypeProperty ;rdfs:domain [ owl:unionOf (fe:FireAidingTrait fe:FireResistingTrait) ]; rdfs:range xsd:decimal .
fe:fireResistanceDuration a owl:DatatypeProperty ; rdfs:domain [ owl:unionOf (fe:FireAidingTrait fe:FireResistingTrait) ]; rdfs:range xsd:decimal .
fe:heatReleasePotential a owl:DatatypeProperty ; rdfs:domain [ owl:unionOf (fe:FireAidingTrait fe:FireResistingTrait) ]; rdfs:range xsd:decimal .
# Non encore exploitées mais à garder en réserve pour des calculs plus fins :
fe:spontaneousIgnitionThreshold a owl:DatatypeProperty ; rdfs:domain [ owl:unionOf (fe:FireAidingTrait fe:FireResistingTrait) ]; rdfs:range xsd:decimal .
fe:ignitionDelay a owl:DatatypeProperty ; rdfs:domain [ owl:unionOf (fe:FireAidingTrait fe:FireResistingTrait) ]; rdfs:range xsd:decimal .

fe:calculatedHeatReleasePotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:calculatedHorizontalTransferPotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:calculatedVerticalTransferPotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:calculatedHorizontalBarrierPotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .
fe:calculatedVerticalBarrierPotential a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .

fe:calculatedGeneralFireRisk a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .

# =================================================================
# 4. SENSIBILITÉ AU FEU (Traits Animaux)
# =================================================================

# --- Propriétés Spécifiques aux Animaux ---
fe:mobilityScore a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal . # 0 (lent) à 1 (rapide)
fe:panicThreshold a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal . # Seuil de stress
fe:evacuationPriority a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:integer .

# Propriétés de transfert (Vecteur de feu)
fe:isPotentialFireVector a owl:DatatypeProperty ; rdfs:domain fe:BioDivision ; rdfs:range xsd:decimal .

fe:calculatedGeneralFireRisk a owl:DatatypeProperty ; rdfs:domain fe:bioFireSensitivity ; rdfs:range xsd:decimal .

# =================================================================
# 4. EXPOSITION GLOBALE
# =================================================================

fe:globalIgnitionProbability a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal . #Moyenne Pondéréé score de Valette
fe:firePropagationVelocity a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .
fe:structuralFireBarrierEffect a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .
fe:globalEvacuationUrgency a owl:DatatypeProperty ; rdfs:domain fe:NaturalSpace ; rdfs:range xsd:decimal .