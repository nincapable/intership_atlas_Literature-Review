@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# =================================================================
# 1. LA CLASSE ESPACE NATUREL
# =================================================================

fe:NaturalSpace a owl:Class ;
    rdfs:label "Espace Naturel"@fr ;
    rdfs:comment "Zone non bâtie entourant ou jouxtant un monument (Parc, Forêt, Réserve)."@fr ;
    rdfs:subClassOf crm:E27_Site .

# --- Propriétés de base ---

fe:NaturalType a owl:Class ; rdfs:subClassOf crm:E55_Type .

fe:Crop a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Forest a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Wetland a owl:Class ; rdfs:subClassOf fe:NaturalType.
fe:Parc a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Grassland a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Shrubland a owl:Class ; rdfs:subClassOf fe:NaturalType .

fe:hasNaturalType a owl:DatatypeProperty ;
    rdfs:label "Type d'espace"@fr ;
    rdfs:comment "Ex: Forêt domaniale, Jardin classé, Zone humide."@fr ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:NaturalType .

# Nativement accessible, sans perte d'information
