@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# =================================================================
# 1. LA CLASSE ESPACE NATUREL
# =================================================================

fe:NaturalSpace a owl:Class ;
    rdfs:label "Espace Naturel"@fr ;
    rdfs:comment "Zone non bâtie entourant ou jouxtant un monument (Parc, Forêt, Réserve)."@fr ;
    rdfs:subClassOf crm:E27_Site .

# --- Propriétés de base ---

fe:NaturalType a owl:Class ; rdfs:subClassOf crm:E55_Type .

fe:Crop a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Forest a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Wetland a owl:Class ; rdfs:subClassOf fe:NaturalType.
fe:Parc a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Grassland a owl:Class ; rdfs:subClassOf fe:NaturalType .
fe:Shrubland a owl:Class ; rdfs:subClassOf fe:NaturalType .

fe:hasNaturalType a owl:DatatypeProperty ;
    rdfs:label "Type d'espace"@fr ;
    rdfs:comment "Ex: Forêt domaniale, Jardin classé, Zone humide."@fr ;
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:NaturalType .

# Nativement accessible, sans perte d'information
#fe:hasSurface a owl:ObjectProperty ;
#    rdfs:label "a pour surface"@fr ;
#    rdfs:subPropertyOf crm:P43_has_dimension ;
#    rdfs:domain fe:NaturalSpace ;
#    rdfs:range crm:E54_Dimension .
# crm:P90_has_value (La valeur numérique)
# crm:P91_has_unit (L'unité : m2, ha, etc.)

# fe:hasActivity a owl:DatatypeProperty ;
#     rdfs:label "Activité humaine"@fr ;
#     rdfs:comment "Ex: Randonnée, Chasse, Exploitation forestière."@fr ;
#     rdfs:domain fe:NaturalSpace ;
#     rdfs:range xsd:string .
# Utiliser la propriété native crm:P7_took_place_at (inverse).
#    L'activité (crm:E7_Activity) pointe vers l'espace naturel (E27).
#    Cela permet de dater l'activité (P4) et d'en définir le type (P2).

# =================================================================
# 2. LES ESPÈCES PROTÉGÉES (Biodiversité)
# =================================================================

fe:Taxon a owl:Class ;
    rdfs:label "Taxon"@fr ;
    rdfs:comment "Classification taxonomique des espèces vivantes."@fr ;
    rdfs:subClassOf fe:E55_Type .

fe:hostsTaxon a owl:ObjectProperty ;
    rdfs:label "héberge le taxon"@fr ;
    rdfs:comment "Lien entre un espace naturel et une espèce présente."@fr ;
    rdfs:subPropertyOf crm:P2_has_type ; 
    rdfs:domain fe:NaturalSpace ;
    rdfs:range fe:Taxon .

fe:isTaxonHostedBy owl:inverseOf fe:hostsTaxon ;
    rdfs:domain fe:Taxon ;
    rdfs:range fe:NaturalSpace .

# La classe des statuts UICN
fe:IUCNCategory a owl:Class ;
    rdfs:label "Catégorie de la Liste Rouge UICN"@fr ;
    rdfs:subClassOf crm:E55_Type .

# La propriété de liaison
fe:hasConservationStatus a owl:ObjectProperty ;
    rdfs:label "a un statut de conservation"@fr ;
    rdfs:domain fe:Taxon ;
    rdfs:range fe:IUCNCategory ;
    rdfs:subPropertyOf crm:P2_has_type .

fe:hasConservationMeasures a owl:objectProperty;
    rdfs:label "a des mesures de conservation (document)"@fr ;
    rdfs:domain fe:taxon ; 
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in ;
    rdfs:comment "Lien vers la documentation de sensibilité aux contre-mesures feu"@fr .

# Sensibilité Végétale au feu

fe:VegetationFireSensitivity a owl:Class ; rdfs:label "Sensibilité Végétale au Feu"@fr .

fe:hasFireSensitivity a owl:ObjectProperty ;
    rdfs:domain fe:Taxon ;
    rdfs:range fe:VegetationFireSensitivity .

# Inflammabilité générale de l'espèce

fe:hasFlammabilityClass a owl:ObjectProperty ;
    rdfs:label "classe d'inflammabilité"@fr ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range fe:FlammabilityLevel .

fe:hasValetteScore a owl:DatatypeProperty ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range xsd:integer ;    
    rdfs:comment "Valeur numérique (0-5) pour permettre des calculs de seuils dans les règles d'inférence."@fr .

# Traits bio-physiques (Accélérateurs et Freins)
fe:hasFireAidingTrait a owl:ObjectProperty ;
    rdfs:label "présence d'accélérateur"@fr ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range fe:FireAidingTrait .

fe:hasFireResistingTrait a owl:ObjectProperty ;
    rdfs:label "présence de frein"@fr ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range fe:FireResistingTrait .

# Stratégie de survie
fe:hasRegenerationStrategy a owl:ObjectProperty ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range fe:FireResponseStrategy .

# --- Rôle Fonctionnel de la Plante ---
fe:hasFireFunctionalRole a owl:ObjectProperty ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range fe:FireFunctionalRole .

# --- Indice de Diffusion (Capacité de propagation lointaine) ---
fe:hasDiffusionIndex a owl:DatatypeProperty ;
    rdfs:label "indice de diffusion"@fr ;
    rdfs:comment "Capacité d'une espèce à propager le feu par projection de particules incandescentes (0.0 à 1.0)."@fr ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range xsd:decimal .

# --- Propriété de liaison vers le type de débris ---
fe:producesEmbers a owl:ObjectProperty ;
    rdfs:label "produit des escarbilles"@fr ;
    rdfs:domain fe:VegetationFireSensitivity ;
    rdfs:range fe:EmberType .

#Entretien recommendé pour minimiser les risques
# --- Documentation de Gestion ---
fe:hasMaintenanceGuideline a owl:ObjectProperty ;
    rdfs:label "recommandation d'entretien"@fr ;
    rdfs:comment "Lien vers un protocole technique de taille ou de débroussaillement spécifique à l'espèce."@fr ;
    rdfs:domain fe:Taxon ; 
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in .

# =================================================================
# 3. EXPOSITION AU RISQUE (Analyse Incendie/Naturel)
# =================================================================
fe:hasNaturalExposure rdfs:subPropertyOf fe:hasFireExposure ;
    rdfs:domain fe:NaturalSpace .

