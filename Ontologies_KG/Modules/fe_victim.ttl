@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/victim> a owl:Ontology .

# =================================================================
# 1. LA CLASSE VICTIME
# =================================================================

fe:Victim a owl:Class ;
    rdfs:subClassOf crm:E21_Person ;
    rdfs:label "Victime / Personne Impliquée"@fr .

fe:VictimType a owl:Class ;
    rdfs:subClassOf fe:HumanFactorType ;
    rdfs:label "Type de Victime"@fr .

# =================================================================
# 2. PROPRIÉTÉS DE CLASSIFICATION (Vers SKOS)
# =================================================================

# --- Triage ---
fe:TriageCategory a owl:Class ; rdfs:subClassOf fe:VictimType .

fe:hasTriageCategory a owl:ObjectProperty ;
    rdfs:label "catégorie de triage"@fr ;
    rdfs:domain fe:Victim ;
    rdfs:range fe:TriageCategory .

# --- Genre ---
fe:GenderType a owl:Class ; rdfs:subClassOf fe:VictimType .

fe:hasGender a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P2_has_type ;
    rdfs:domain fe:Victim ;
    rdfs:range fe:GenderType .

# --- Groupe d'appartenance ---
fe:VictimGroup a owl:Class ; rdfs:subClassOf fe:VictimType .

fe:hasVictimGroup a owl:ObjectProperty ;
    rdfs:label "groupe d'appartenance"@fr ;
    rdfs:domain fe:Victim ;
    rdfs:range fe:VictimGroup .

# =================================================================
# 3. DIMENSIONS PHYSIQUES ET TEMPORELLES
# =================================================================

fe:AgeDimension a owl:Class ;
    rdfs:subClassOf crm:E54_Dimension ;
    rdfs:label "Dimension d'âge"@fr .

fe:hasAge a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:Victim ;
    rdfs:range fe:AgeDimension .

# =================================================================
# 4. LOCALISATION ET DOCUMENTATION
# =================================================================

fe:foundAtLocation a owl:ObjectProperty ;
    rdfs:label "lieu de découverte"@fr ;
    rdfs:domain fe:Victim ;
    rdfs:range crm:E53_Place ; 
    rdfs:subPropertyOf crm:P53_has_former_or_current_location .

fe:hasInterventionForm a owl:ObjectProperty ;
    rdfs:label "fiche d'intervention associée"@fr ;
    rdfs:domain fe:Victim ;
    rdfs:range crm:E31_Document ;
    rdfs:subPropertyOf crm:P70i_is_documented_in .