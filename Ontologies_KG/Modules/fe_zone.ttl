@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/zone> a owl:Ontology .

# =================================================================
# 1. LA CLASSE ZONE
# =================================================================

fe:Zone a owl:Class ;
    rdfs:subClassOf crm:E53_Place ;
    rdfs:label "Zone d'intérêt"@fr ;
    rdfs:comment "Espace délimité caractérisé par son usage, sa capacité et son exposition aux risques."@fr .

fe:TechnicalType a owl:Class ; rdfs:subClassOf crm:E55_Type .

fe:RiskDimension a owl:Class ;
    rdfs:label "Dimension de Risque"@fr ;
    rdfs:subClassOf fe:RiskDimension .

# =================================================================
# 2. CAPACITÉ ET FLUX (TRANSIT)
# =================================================================

fe:TransitType a owl:Class ; rdfs:subClassOf fe:OperationnalType .

fe:hasCapacity a owl:ObjectProperty ;
    rdfs:label "capacité nominale"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range crm:E54_Dimension . # Connecté à crm:P90_has_value pour le nombre de personnes

fe:hasTransitType a owl:ObjectProperty ;
    rdfs:label "type de transit"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:TransitType .

# =================================================================
# 3. USAGE ET MORPHOLOGIE
# =================================================================

fe:ZoneUsageType a owl:Class ; rdfs:subClassOf fe:OperationnalType .

fe:hasZoneUsage a owl:ObjectProperty ;
    rdfs:label "usage de la zone"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:ZoneUsageType .

fe:hasBuilding a owl:ObjectProperty ;
    rdfs:label "contient le bâtiment"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:Building .

fe:hasNaturalSpace a owl:ObjectProperty ;
    rdfs:label "comprend l'espace naturel"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:NaturalSpace .

fe:containsArtefact a owl:ObjectProperty ;
    rdfs:label "contient un artéfact"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:Artefact .

# =================================================================
# 4. RÉSEAUX ET COMMUNICATIONS
# =================================================================

fe:CommunicationType a owl:Class ; rdfs:subClassOf fe:OperationnalType .

fe:hasCommunicationNode a owl:ObjectProperty ;
    rdfs:label "nœud de communication"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:CommunicationType .

# =================================================================
# 5. ÉVALUATION DES RISQUES
# =================================================================

fe:FireRiskScore a owl:Class ;
    rdfs:subClassOf fe:RiskDimension ;
    rdfs:label "Score de Risque Incendie"@fr .

fe:isExposedTo a owl:ObjectProperty ;
    rdfs:label "exposition au risque"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:HazardType .

fe:hasFireRiskEvaluation a owl:ObjectProperty ;
    rdfs:label "évaluation du risque incendie"@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range fe:FireRiskScore .

fe:hasFireRiskBuildingFactors a owl:ObjectProperty ;
    rdfs:label "facteurs de risque liés au bâti"@fr ;
    rdfs:domain fe:FireRiskScore ;
    rdfs:range fe:Building . 

fe:hasFireRiskNaturalFactors a owl:ObjectProperty ;
    rdfs:label "facteurs de risque liés à l'environnement naturel"@fr ;
    rdfs:domain fe:FireRiskScore ;
    rdfs:range fe:NaturalSpace .

# =================================================================
# 6.STRUCTURE TOPOGRAPHIQUE (LIDAR TILES)
# =================================================================

fe:hasTopographyMeasurement a owl:ObjectProperty ;
    rdfs:label "relevé topographique"@fr ;
    rdfs:domain fe:HeritageSite ;
    rdfs:range fe:TopographicDataset .

fe:TopographicDataset a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object ;
    rdfs:label "Jeu de données topographiques"@fr .

# --- Décomposition en Tuiles ---

fe:LidarTile a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object ;
    rdfs:label "Tuile LiDAR"@fr .

fe:hasTile a owl:ObjectProperty ;
    rdfs:label "comprend la tuile"@fr ;
    rdfs:domain fe:TopographicDataset ;
    rdfs:range fe:LidarTile .

fe:isAdjacentTo a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:label "est adjacent à"@fr ;
    rdfs:comment "Indique que deux tuiles partagent une bordure commune."@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

fe:isAbove a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "est au-dessus de"@fr ;
    rdfs:comment "Pour la superposition (ex: LiDAR aérien au-dessus d'un scan terrestre)."@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

fe:overlapsWith a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:label "chevauche"@fr ;
    rdfs:comment "Indique une zone de recouvrement partiel entre deux tuiles."@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range fe:LidarTile .

fe:hasAverageSlope a owl:DatatypeProperty ;
    rdfs:label "pente moyenne"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range xsd:decimal .

fe:hasMaxElevation a owl:DatatypeProperty ;
    rdfs:label "altitude maximale"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range xsd:decimal .

fe:hasMinElevation a owl:DatatypeProperty ;
    rdfs:label "altitude minimale"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range xsd:decimal .

# --- Propriétés du Dataset (Global) ---

fe:hasAcquisitionDate a owl:DatatypeProperty ;
    rdfs:label "date d'acquisition"@fr ;
    rdfs:domain fe:TopographicDataset ;
    rdfs:range xsd:dateTime .

fe:hasResolution a owl:DatatypeProperty ;
    rdfs:label "résolution nominale"@fr ;
    rdfs:domain fe:TopographicDataset ;
    rdfs:range xsd:string .

fe:hasAcquisitionMethod a owl:ObjectProperty ;
    rdfs:label "méthode d'acquisition"@fr ;
    rdfs:domain fe:TopographicDataset ;
    rdfs:range fe:AcquisitionMethod . # Vers SKOS

# --- Propriétés de la Tuile (Local) ---

fe:hasTileIndex a owl:DatatypeProperty ;
    rdfs:label "index de la tuile"@fr ;
    rdfs:comment "ex: Tile_A1"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range xsd:string .

fe:hasSourceFile a owl:DatatypeProperty ;
    rdfs:label "fichier source"@fr ;
    rdfs:comment "Lien vers le fichier .las ou .laz spécifique à cette tuile"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range xsd:anyURI .

fe:hasBoundingBox a owl:DatatypeProperty ;
    rdfs:label "emprise spatiale (BBOX)"@fr ;
    rdfs:comment "Format WKT: POLYGON((...))"@fr ;
    rdfs:domain fe:LidarTile ;
    rdfs:range xsd:string .

# Classe de référentiel pour SKOS
fe:AcquisitionMethod a owl:Class ; rdfs:subClassOf fe:TechnicalType .

# =================================================================
# 5. ÉVALUATION DES RISQUES ET INDICES DE PRIORITÉ
# =================================================================

# --- Indices de Priorité Séparés (Calculés) ---

fe:patrimonialUrgencyIndex a owl:DatatypeProperty ;
    rdfs:label "Indice d'urgence patrimoniale"@fr ;
    rdfs:comment "Somme pondérée des scores de priorité des artefacts présents dans la zone."@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range xsd:decimal .

fe:ecologicalUrgencyIndex a owl:DatatypeProperty ;
    rdfs:label "Indice d'urgence écologique"@fr ;
    rdfs:comment "Score basé sur la rareté et la protection des espèces vivantes (Flore/Faune) de la zone."@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range xsd:decimal .

fe:structuralDangerIndex a owl:DatatypeProperty ;
    rdfs:label "Indice de péril structurel"@fr ;
    rdfs:comment "Indice de danger lié à la fragilité des bâtiments et au risque d'effondrement dans la zone."@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range xsd:decimal .

# --- Métrique Globale (Optionnelle pour le tri rapide) ---

fe:globalEvacuationUrgency a owl:DatatypeProperty ;
    rdfs:label "Urgence globale d'évacuation"@fr ;
    rdfs:comment "Valeur agrégée pour le tri général des zones d'intervention."@fr ;
    rdfs:domain fe:Zone ;
    rdfs:range xsd:decimal .