@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# =================================================================
# 1. LE CLIMAT (STATISTIQUES / NORMALES)
# =================================================================

fe:Climate a owl:Class ;
    rdfs:label "Climat Statistique"@fr ;
    rdfs:comment "Représente les moyennes climatiques d'une zone sur une longue période (Normales)."@fr ;
    rdfs:subClassOf crm:E55_Type .

# Propriété pour classifier le type de climat (Liaison SKOS)
fe:hasClimateType a owl:ObjectProperty ;
    rdfs:label "a pour type de climat"@fr ;
    rdfs:domain fe:Climate ;
    rdfs:range fe:ClimateClassification .

fe:ClimateClassification a owl:Class ; rdfs:subClassOf crm:E55_Type .

# --- Données Statistiques (Moyennes) ---
fe:hasAvgTemp a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasMinAvgTemp a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasMaxAvgTemp a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgWindSpeed a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgWindDirection a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgPrecipitation a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgHumidity a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .
fe:hasAvgSunshineDuration a owl:DatatypeProperty ; rdfs:domain fe:Climate ; rdfs:range xsd:decimal .

# =================================================================
# 2. LE RELEVÉ MÉTÉO (ÉVÉNEMENT PONCTUEL)
# =================================================================

fe:WeatherMeasurement a owl:Class ;
    rdfs:label "Relevé Météorologique"@fr ;
    rdfs:subClassOf crm:E16_Measurement .

# --- Classes de Dimensions ---
fe:WindSpeed a owl:Class ; rdfs:subClassOf crm:E54_Dimension .
fe:WindDirection a owl:Class ; rdfs:subClassOf crm:E54_Dimension .
fe:Precipitation a owl:Class ; rdfs:subClassOf crm:E54_Dimension .
fe:Humidity a owl:Class ; rdfs:subClassOf crm:E54_Dimension .
fe:SunshineDuration a owl:Class ; rdfs:subClassOf crm:E54_Dimension .
fe:Temperature a owl:Class ; rdfs:subClassOf crm:E54_Dimension .

# --- Propriétés d'Objet : Connexion Pivot ---
fe:hasWeatherDimension a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:WeatherMeasurement ;
    rdfs:range crm:E54_Dimension .

# Propriété pour qualifier la dimension (ex: Beaufort pour le vent - Liaison SKOS)
fe:hasWeatherQualifier a owl:ObjectProperty ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range crm:E55_Type .

# Sous-propriétés spécifiques
fe:hasWindSpeed a owl:ObjectProperty ; rdfs:subPropertyOf fe:hasWeatherDimension ; rdfs:range fe:WindSpeed .
fe:hasWindDirection a owl:ObjectProperty ; rdfs:subPropertyOf fe:hasWeatherDimension ; rdfs:range fe:WindDirection .
fe:hasPrecipitation a owl:ObjectProperty ; rdfs:subPropertyOf fe:hasWeatherDimension ; rdfs:range fe:Precipitation .
fe:hasHumidity a owl:ObjectProperty ; rdfs:subPropertyOf fe:hasWeatherDimension ; rdfs:range fe:Humidity .
fe:hasSunshine a owl:ObjectProperty ; rdfs:subPropertyOf fe:hasWeatherDimension ; rdfs:range fe:SunshineDuration .
fe:hasTemperature a owl:ObjectProperty ; rdfs:subPropertyOf fe:hasWeatherDimension ; rdfs:range fe:Temperature .

# =================================================================
# 3. VALEURS NUMÉRIQUES DES RELEVÉS (INSTANT T)
# =================================================================

fe:hasValue a owl:DatatypeProperty ;
    rdfs:label "valeur numérique brute"@fr ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal .