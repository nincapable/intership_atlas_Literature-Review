@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# =================================================================
# 1. LE CLIMAT (STATISTIQUES / NORMALES)
# =================================================================

fe:Climate a owl:Class ;
    rdfs:label "Climat Statistique"@fr ;
    rdfs:comment "Représente les moyennes climatiques d'une zone sur une longue période (Normales)."@fr ;
    rdfs:subClassOf crm:E55_Type .

# --- Propriétés de données pour le Climat (Moyennes) ---

fe:hasAvgTemp a owl:DatatypeProperty ;
    rdfs:label "Température Moyenne annuelle"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasMinAvgTemp a owl:DatatypeProperty ;
    rdfs:label "Température Moyenne la plus basse"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasMaxAvgTemp a owl:DatatypeProperty ;
    rdfs:label "Température Moyenne la plus haute"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasAvgWindSpeed a owl:DatatypeProperty ;
    rdfs:label "Vitesse du Vent Moyenne"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasAvgWindDirection a owl:DatatypeProperty ;
    rdfs:label "Direction du Vent Moyenne (degrés)"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasAvgPrecipitation a owl:DatatypeProperty ;
    rdfs:label "Précipitations Moyennes"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasAvgHumidity a owl:DatatypeProperty ;
    rdfs:label "Humidité Moyenne"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

fe:hasAvgSunshineDuration a owl:DatatypeProperty ;
    rdfs:label "Durée d'Ensoleillement Moyenne"@fr ;
    rdfs:domain fe:Climate ; 
    rdfs:range xsd:decimal .

# =================================================================
# 2. LE RELEVÉ MÉTÉO (ÉVÉNEMENT PONCTUEL)
# =================================================================

fe:WeatherMeasurement a owl:Class ;
    rdfs:label "Relevé Météorologique"@fr ;
    rdfs:comment "Mesure physique à un instant T (lié à crm:P4_has_time-span)."@fr ;
    rdfs:subClassOf crm:E16_Measurement .

# --- Classes de Dimensions (Les nœuds connectés) ---

fe:WindSpeed a owl:Class ; 
    rdfs:label "Vitesse du Vent"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

fe:WindDirection a owl:Class ; 
    rdfs:label "Direction du Vent"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

fe:Precipitation a owl:Class ; 
    rdfs:label "Précipitations"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

fe:Humidity a owl:Class ; 
    rdfs:label "Humidité"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

fe:SunshineDuration a owl:Class ; 
    rdfs:label "Durée d'Ensoleillement"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

fe:Temperature a owl:Class ; 
    rdfs:label "Température"@fr ;
    rdfs:subClassOf crm:E54_Dimension .

# --- Propriétés d'Objet : Connexion Pivot ---

fe:hasWeatherDimension a owl:ObjectProperty ;
    rdfs:label "a pour dimension météo"@fr ;
    rdfs:subPropertyOf crm:P43_has_dimension ;
    rdfs:domain fe:WeatherMeasurement ;
    rdfs:range crm:E54_Dimension .

# --- Sous-propriétés spécifiques pour faciliter les requêtes ---

fe:hasWindSpeed a owl:ObjectProperty ; 
    rdfs:label "a pour vitesse de vent"@fr ;
    rdfs:subPropertyOf fe:hasWeatherDimension ; 
    rdfs:range fe:WindSpeed .

fe:hasWindDirection a owl:ObjectProperty ; 
    rdfs:label "a pour direction de vent"@fr ;
    rdfs:subPropertyOf fe:hasWeatherDimension ; 
    rdfs:range fe:WindDirection .

fe:hasPrecipitation a owl:ObjectProperty ; 
    rdfs:label "a pour relevé de précipitations"@fr ;
    rdfs:subPropertyOf fe:hasWeatherDimension ; 
    rdfs:range fe:Precipitation .

fe:hasHumidity a owl:ObjectProperty ; 
    rdfs:label "a pour relevé d'humidité"@fr ;
    rdfs:subPropertyOf fe:hasWeatherDimension ; 
    rdfs:range fe:Humidity .

fe:hasSunshine a owl:ObjectProperty ; 
    rdfs:label "a pour relevé d'ensoleillement"@fr ;
    rdfs:subPropertyOf fe:hasWeatherDimension ; 
    rdfs:range fe:SunshineDuration .

fe:hasTemperature a owl:ObjectProperty ; 
    rdfs:label "a pour relevé de température"@fr ;
    rdfs:subPropertyOf fe:hasWeatherDimension ; 
    rdfs:range fe:Temperature .

# =================================================================
# 3. VALEURS NUMÉRIQUES DES RELEVÉS (INSTANT T)
# =================================================================

fe:hasValue a owl:DatatypeProperty ;
    rdfs:label "valeur numérique brute"@fr ;
    rdfs:comment "Valeur enregistrée lors du relevé à l'instant T (pas une moyenne)."@fr ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal .