@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

fe:core a owl:Ontology ;
    rdfs:label "Fire and Evacuation Ontology - Core Entry Point"@fr ;
    rdfs:comment "Point d'entrée unique important les modules thématiques."@fr ;
    # Importation des fichiers locaux du dossier Modules
    owl:imports <fe_building_module.ttl> ,
                <fe_axis_module.ttl> ,
                <fe_artefact_module.ttl> ,
                <fe_hazard.ttl> ,
                <fe_heritageSite.ttl> ,
                <fe_Impact.ttl> ,
                <fe_natural_space.ttl> ,
                <fe_population.ttl> ,
                <fe_safety.ttl> ,
                <fe_victim.ttl> ,
                <fe_weather.ttl> ,
                <fe_zone.ttl> .

fe:hasRiskExposure a owl:ObjectProperty ;
    rdfs:label "exposition au risque"@fr ;
    rdfs:comment "Relie une entité physique (bâtiment, parc, forêt) à un état de risque constaté."@fr ;
    # Le domaine englobe désormais Bâtiments ET Espaces Naturels
    rdfs:domain crm:E18_Physical_Thing ; 
    rdfs:range crm:E3_Condition_State ;
    rdfs:subPropertyOf crm:P44_has_condition .