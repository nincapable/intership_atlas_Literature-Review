@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/core> a owl:Ontology ;
    rdfs:label "Fire and Evacuation Ontology - Core Entry Point"@fr ;
    rdfs:comment "Point d'entrée unique important les modules thématiques et les thésaurus associés."@fr ;
    
    # --- Importation des Modules Logiques (OWL) ---
    owl:imports <fe_building_module.ttl> ,
                <fe_axis_module.ttl> ,
                <fe_artefact_module.ttl> ,
                <fe_hazard.ttl> ,
                <fe_heritageSite.ttl> ,
                <fe_Impact.ttl> ,
                <fe_natural_space.ttl> ,
                <fe_population.ttl> ,
                <fe_safety.ttl> ,
                <fe_victim.ttl> ,
                <fe_weather.ttl> ,
                <fe_zone.ttl> ,

    # --- Importation des Thésaurus (Vocabulaires Contrôlés SKOS) ---
                <fe_thesaurus_alea.ttl> ,
                <fe_thesaurus_building.ttl> ,
                <fe_thesaurus_heritageSite.ttl> ,
                <fe_thesaurus_safety.ttl> ,
                <fe_thesaurus_zone.ttl> ,
                <fe_thesaurus_artefacts.ttl> ,
                <fe_thesaurus_espaces_nat.ttl> ,
                <fe_thesaurus_impact.ttl> ,
                <fe_thesaurus_victim.ttl> ,
                <fe_thesaurus_axis.ttl> ,
                <fe_thesaurus_especes.ttl> ,
                <fe_thesaurus_population.ttl> ,
                <fe_thesaurus_weather.ttl> .