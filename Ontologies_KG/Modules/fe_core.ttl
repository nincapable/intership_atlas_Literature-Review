@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/core> a owl:Ontology ;
    rdfs:label "Fire and Evacuation Ontology - Core Entry Point"@fr ;
    rdfs:comment "Point d'entrée unique important les modules thématiques."@fr ;
    # Importation des fichiers locaux du dossier Modules
    owl:imports <fe_building_module.ttl> ,
                <fe_axis_module.ttl> ,
                <fe_artefact_module.ttl> ,
                <fe_hazard.ttl> ,
                <fe_heritageSite.ttl> ,
                <fe_Impact.ttl> ,
                <fe_natural_space.ttl> ,
                <fe_population.ttl> ,
                <fe_safety.ttl> ,
                <fe_victim.ttl> ,
                <fe_weather.ttl> ,
                <fe_zone.ttl> .