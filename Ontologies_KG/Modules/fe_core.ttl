@prefix fe:   <http://example.org/fire_and_evacuation#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/fire_and_evacuation/core> a owl:Ontology ;
    rdfs:label "Fire and Evacuation Ontology - Core Entry Point"@fr ;
    rdfs:comment "Point d'entrée unique important les modules thématiques et les thésaurus."@fr ;
    
    # --- IMPORT DES MODULES LOGIQUES (Même dossier) ---
    owl:imports <fe_axis_module.ttl> ,
                <fe_artefact_module.ttl> ,
                <fe_building_module.ttl> ,
                <fe_cognitiveFactor.ttl>,
                <fe_hazard.ttl> ,
                <fe_heritageSite.ttl> ,
                <fe_Impact.ttl> ,
                <fe_natural_space.ttl> ,
                <fe_population.ttl> ,
                <fe_safety.ttl> ,
                <fe_victim.ttl> ,
                <fe_weather.ttl> ,
                <fe_zone.ttl> ,

    # --- IMPORT DES THÉSAURUS (Dossier parent puis /Thesaurus/) ---
    # Note : Protégé utilisera ces chemins pour localiser les fichiers physiquement.
                <../Thesaurus/fe_thesaurus_alea.ttl> ,
                <../Thesaurus/fe_thesaurus_building.ttl> ,
                <../Thesaurus/fe_thesaurus_cognitive.ttl>,
                <../Thesaurus/fe_thesaurus_heritageSite.ttl> ,
                <../Thesaurus/fe_thesaurus_safety.ttl> ,
                <../Thesaurus/fe_thesaurus_zone.ttl> ,
                <../Thesaurus/fe_thesaurus_artefacts.ttl> ,
                <../Thesaurus/fe_thesaurus_espaces_nat.ttl> ,
                <../Thesaurus/fe_thesaurus_impact.ttl> ,
                <../Thesaurus/fe_thesaurus_victim.ttl> ,
                <../Thesaurus/fe_thesaurus_axis.ttl> ,
                <../Thesaurus/fe_thesaurus_especes.ttl> ,
                <../Thesaurus/fe_thesaurus_population.ttl> ,
                <../Thesaurus/fe_thesaurus_weather.ttl> .

fe:riskWeight a owl:DatatypeProperty ;
    rdfs:label "Poids de risque de base"@fr ;
    rdfs:range xsd:decimal .

fe:hazardMultiplier a owl:DatatypeProperty ;
    rdfs:label "Multiplicateur de dangerosité"@fr ;
    rdfs:range xsd:decimal .

fe:vulnerabilityIndex a owl:DatatypeProperty ;
    rdfs:label "Index de vulnérabilité calculé"@fr ;
    rdfs:range xsd:decimal .